package ui

import (
	"fmt"
	"math"
	"sort"
	"strings"
	"time"
)

// The campaign views read a chain of stages as one run. Everything they show is
// carried in by the caller: this package computes layout, never metrics, so a
// column that the server could not populate stays visibly blank instead of
// being invented here.

// CampaignSource says where a campaign view was reconstructed from, because the
// two sources answer different questions about what is trustworthy. A schedule
// was planned up front and records its own stage table; an imported chain was
// walked backwards from a job's checkpoint lineage and therefore knows only
// what a checkpoint happens to carry.
type CampaignSource string

const (
	CampaignFromSchedule CampaignSource = "schedule"
	CampaignFromChain    CampaignSource = "chain"
)

// CampaignStage is one row of the stage table.
//
// The optional metrics use explicit presence flags rather than sentinel values.
// A cost of zero and an unmeasured cost are different facts, and a campaign
// view whose whole purpose is comparing runs must not blur them.
type CampaignStage struct {
	Index int    `json:"index"`
	Kind  string `json:"kind"`
	State string `json:"state"`

	Circles int `json:"circles"`

	BestCost    float64 `json:"bestCost"`
	HasBestCost bool    `json:"hasBestCost"`

	// PSNR is derived from the cost by the caller. It is shown because a cost is
	// hard to compare across reference images and a PSNR is not.
	PSNR         float64 `json:"psnr"`
	PSNRInfinite bool    `json:"psnrInfinite"`
	HasPSNR      bool    `json:"hasPsnr"`

	Iterations  int   `json:"iterations"`
	Evaluations int64 `json:"evaluations"`

	ElapsedSec    float64 `json:"elapsedSec"`
	HasElapsed    bool    `json:"hasElapsed"`
	ElapsedAbsent string  `json:"elapsedAbsent"`

	// AcceptedSweeps is the accepted-sweep count for a polish stage. It is a
	// pointer because the count is not persisted anywhere today, so every
	// polish row leaves it nil and the column says so rather than showing a
	// zero that would read as "no sweep helped".
	AcceptedSweeps *int `json:"acceptedSweeps,omitempty"`

	JobID       string `json:"jobId"`
	ParentJobID string `json:"parentJobId"`

	// Note carries the stage's own explanation — a policy reason for a skipped
	// stage, or the error for a failed one.
	Note string `json:"note"`
}

// Campaign is a whole chain presented as one run.
type Campaign struct {
	ID     string         `json:"id"`
	Name   string         `json:"name"`
	State  string         `json:"state"`
	Source CampaignSource `json:"source"`

	CampaignSeed int64 `json:"campaignSeed"`
	HasSeed      bool  `json:"hasSeed"`

	// PlannedStages is the stage count the plan calls for, which exceeds the
	// recorded stages while a campaign is still running. An imported chain has
	// no plan and leaves it zero.
	PlannedStages int `json:"plannedStages"`

	Stages []CampaignStage `json:"stages"`
	Error  string          `json:"error"`

	// Warnings are the document's advisories: settings the campaign runs
	// exactly as authored and a measurement says are wasted. They sit apart
	// from Error because nothing went wrong — the campaign is running, and the
	// note is about how it is spending its budget.
	Warnings []string `json:"warnings"`

	// Projection is what the measured stages say is still to come, and it is
	// nil whenever there is nothing to say: a campaign that will not advance
	// again, or a plan with no stage left.
	Projection *CampaignProjection `json:"projection,omitempty"`
}

// CampaignProjection is the estimate card, in the two rates a campaign can be
// short of: cost removed per circle added, and cost removed per hour spent.
//
// It carries both because the objective flips with whichever resource is
// scarce, and the same settings win one while losing the other. A page showing
// only one of them would answer a question the reader did not ask.
//
// Every optional figure carries its own presence flag, for the reason
// CampaignStage does: a projected cost of zero is a perfect fit and an
// unprojected one is silence, and a card whose whole purpose is comparing two
// estimates must not blur them. As with the stage rows, this package computes
// no metrics — the rates, the projected costs and their PSNR all arrive
// derived, and a field the server could not fill stays visibly blank.
type CampaignProjection struct {
	// Projected says the estimate rests on enough completed, cost-measured
	// stages to carry rates at all. When it is false every rate below is zero
	// and Note says what is missing.
	Projected bool `json:"projected"`

	// Samples is the completed, cost-measured stages read, and RecentLegs how
	// many of the gains between them the trailing rates cover. RecentCircles
	// and RecentElapsedSec are the two denominators those rates were divided
	// by, so the card can say what a rate was measured over in the units the
	// campaign was spending rather than in legs, which are this projection's
	// own internal unit and mean nothing to a reader.
	Samples          int     `json:"samples"`
	RecentLegs       int     `json:"recentLegs"`
	RecentCircles    int     `json:"recentCircles"`
	RecentElapsedSec float64 `json:"recentElapsedSec"`

	// GainPerCircle and GainPerHour describe the whole measured campaign.
	// RecentGainPerCircle and RecentGainPerHour cover the trailing window
	// alone, and are the rates the two projected costs were extrapolated with:
	// per-circle return decays, so the campaign average over-predicts.
	GainPerCircle       float64 `json:"gainPerCircle"`
	GainPerHour         float64 `json:"gainPerHour"`
	RecentGainPerCircle float64 `json:"recentGainPerCircle"`
	RecentGainPerHour   float64 `json:"recentGainPerHour"`

	// LatestCircles and LatestCost are where the campaign measurably stands,
	// which is where both projections start from.
	LatestCircles int     `json:"latestCircles"`
	LatestCost    float64 `json:"latestCost"`

	// The circle-ceiling column: the circles the plan still calls for, and the
	// cost the trailing per-circle rate puts the campaign at once they are
	// spent.
	RemainingCircles    int     `json:"remainingCircles"`
	CostAtPlanEnd       float64 `json:"costAtPlanEnd"`
	PlanEndPSNR         float64 `json:"planEndPsnr"`
	PlanEndPSNRInfinite bool    `json:"planEndPsnrInfinite"`
	HasPlanEndPSNR      bool    `json:"hasPlanEndPsnr"`
	HasCircleCeiling    bool    `json:"hasCircleCeiling"`

	// The time-budget column: the wall clock the finish projection still
	// expects, and the cost the trailing per-hour rate puts the campaign at
	// once it is spent. Seconds rather than a duration, because that is what
	// CampaignStage.ElapsedSec already uses and both are formatted the same way.
	RemainingElapsedSec float64 `json:"remainingElapsedSec"`
	CostAtFinish        float64 `json:"costAtFinish"`
	FinishPSNR          float64 `json:"finishPsnr"`
	FinishPSNRInfinite  bool    `json:"finishPsnrInfinite"`
	HasFinishPSNR       bool    `json:"hasFinishPsnr"`
	HasTimeBudget       bool    `json:"hasTimeBudget"`

	// Note is the projection's own qualification: why it has no rates yet, or
	// that the per-circle return is decaying fast enough that even the trailing
	// estimate reads optimistic.
	Note string `json:"note"`
}

// CampaignSummary is a campaign in a listing. It is also the JSON the dashboard
// endpoint serves, so its tags carry the same camelCase the rest of the API
// uses; the island and the server-rendered card read the identical shape.
type CampaignSummary struct {
	ID     string         `json:"id"`
	Name   string         `json:"name"`
	State  string         `json:"state"`
	Source CampaignSource `json:"source"`

	RecordedStages int `json:"recordedStages"`
	PlannedStages  int `json:"plannedStages"`

	CampaignSeries []CampaignSeriesPoint `json:"campaignSeries"`
	LeafJobID      string                `json:"leafJobId,omitempty"`

	Circles     int     `json:"circles"`
	BestCost    float64 `json:"bestCost"`
	HasBestCost bool    `json:"hasBestCost"`

	UpdatedAt time.Time `json:"updatedAt"`
}

// CampaignSeriesPoint is one stage in the compact campaign line preview used by
// dashboard summaries and mini charts.
type CampaignSeriesPoint struct {
	Index   int    `json:"index"`
	Kind    string `json:"kind"`
	Circles int    `json:"circles"`

	BestCost    float64 `json:"bestCost"`
	HasBestCost bool    `json:"hasBestCost"`
}

// CampaignListPage lists every campaign the server can reconstruct: the
// schedules it planned, and the ad-hoc extend/polish chains it can still read
// back out of checkpoint lineage.
templ CampaignListPage(schedules []CampaignSummary, chains []CampaignSummary, unavailable string) {
	@Layout("Campaigns") {
		<div data-island="campaign-list" data-island-label="campaign list">
		@templ.JSONScript("campaign-list-page", struct {
			Schedules []CampaignSummary `json:"schedules"`
			Chains []CampaignSummary `json:"chains"`
		}{schedules, chains})
		<div style="margin-bottom: 2rem;">
			<h1 style="font-size: 2rem; font-weight: 700;">Campaigns</h1>
			<p style="color: var(--text-muted);">
				A campaign is a chain of stages read as one run rather than as unrelated jobs.
			</p>
		</div>
		if unavailable != "" {
			<div class="card" style="border-left: 4px solid var(--warning-color);">
				<strong>Campaigns are unavailable:</strong> { unavailable }
			</div>
		} else {
			<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem;">Schedules</h2>
			if len(schedules) == 0 {
				<div class="card" style="color: var(--text-muted);">
					No schedules yet. Create one with <code>POST /api/v1/schedules</code> or <code>mayflycirclefit schedule create</code>.
				</div>
			} else {
				<div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
					for _, summary := range schedules {
						@campaignCard(summary, fmt.Sprintf("/schedules/%s", summary.ID))
					}
				</div>
			}
			<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem;">Imported chains</h2>
			<p style="color: var(--text-muted); margin-bottom: 0.75rem; font-size: 0.875rem;">
				Reconstructed from the <code>extendedFrom</code> and <code>polishedFrom</code> lineage on
				each checkpoint, so a chain driven by hand before schedules existed still reads as one run.
			</p>
			if len(chains) == 0 {
				<div class="card" style="color: var(--text-muted);">
					No multi-stage chains outside a schedule.
				</div>
			} else {
				<div style="display: grid; gap: 1rem;">
					for _, summary := range chains {
						@campaignCard(summary, fmt.Sprintf("/chains/%s", summary.ID))
					}
				</div>
			}
		}
		</div>
		@IslandBundle()
	}
}

templ campaignCard(summary CampaignSummary, href string) {
	// card-link rather than a bare wrapping anchor: the hover lift used to be
	// the card's own inline style, which a keyboard reaching the link never
	// triggered. The shared class drives both hover and focus-visible.
	<a class="card-link" href={ templ.URL(href) }>
		<div class="card" style="margin-bottom: 0;">
			<div class="row-between row-between-top">
				<div>
					<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
						<h3 style="font-size: 1.125rem; font-weight: 600; font-family: monospace;">
							{ shortID(summary.ID) }
						</h3>
						@StateBadge(summary.State)
						if summary.Name != "" {
							<span style="color: var(--text-muted);">{ summary.Name }</span>
						}
					</div>
					<div class="meta-row" style="color: var(--text-muted); font-size: 0.875rem;">
						<span><strong>Stages:</strong> { campaignStageCount(summary) }</span>
						<span><strong>Circles:</strong> { fmt.Sprintf("%d", summary.Circles) }</span>
					</div>
				</div>
				<div class="row-end">
					if summary.HasBestCost {
						<div style="font-size: 0.875rem; color: var(--text-muted);">Best cost</div>
						<div style="font-size: 1.25rem; font-weight: 600;">{ fmt.Sprintf("%.2f", summary.BestCost) }</div>
					}
					if !summary.UpdatedAt.IsZero() {
						<div style="font-size: 0.75rem; color: var(--text-muted);">{ formatTime(summary.UpdatedAt) }</div>
					}
				</div>
			</div>
		</div>
	</a>
}

// CampaignPage renders one campaign: the stage table and the cost-against-
// circles plot that answers whether this schedule beat the last one.
templ CampaignPage(campaign Campaign) {
	@Layout(campaignTitle(campaign)) {
		<div data-island="campaign-detail" data-island-label="campaign detail">
		@templ.JSONScript("campaign-detail-page", campaign)
		<div style="margin-bottom: 1.5rem;">
			<div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
				<h1 style="font-size: 1.75rem; font-weight: 700;">{ campaignTitle(campaign) }</h1>
				@StateBadge(campaign.State)
			</div>
			<div style="color: var(--text-muted); font-family: monospace; font-size: 0.875rem;">{ campaign.ID }</div>
			<div style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem;">
				{ campaignProvenance(campaign) }
			</div>
		</div>
		if campaign.Error != "" {
			<div class="card" style="background-color: var(--error-bg); color: var(--error-text);">
				<strong>Error:</strong> { campaign.Error }
			</div>
		}
		if len(campaign.Warnings) > 0 {
			<div class="card" style="background-color: var(--warning-bg); color: var(--warning-text);">
				<strong>{ campaignWarningHeading(campaign.Warnings) }</strong>
				<ul style="margin: 0.5rem 0 0 1.25rem;">
					for _, warning := range campaign.Warnings {
						<li style="margin-bottom: 0.25rem;">{ warning }</li>
					}
				</ul>
			</div>
		}
		<div class="card">
			<h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;">Cost against circle count</h2>
			@CampaignCostPlot(campaign.Stages)
		</div>
		if campaign.Projection != nil {
			@CampaignProjectionCard(*campaign.Projection)
		}
		if stage, ok := latestCompletedCampaignStage(campaign.Stages); ok {
			@ImageViewer(ImageViewerData{
				JobID:             stage.JobID,
				DefaultMode:       "side-by-side",
				BestRevision:      0,
				ReferenceImageURL: fmt.Sprintf("/api/v1/jobs/%s/ref.png", stage.JobID),
				BestImageURL:      fmt.Sprintf("/api/v1/jobs/%s/best.png", stage.JobID),
				DiffImageURL:      fmt.Sprintf("/api/v1/jobs/%s/diff.png", stage.JobID),
				JobState:          stage.State,
				MaxIterations:     stage.Iterations,
				ShowMetadata:      false,
				ExtraClass:        "campaign-images",
			})
		} else {
			<div class="card" style="color: var(--text-muted);">
				No completed stage has produced image artifacts yet.
			</div>
		}
		<div class="card">
			<h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;">Stages</h2>
			if len(campaign.Stages) == 0 {
				<p style="color: var(--text-muted);">No stage has been recorded yet.</p>
			} else {
				// Nine dense numeric columns stay a table and stay scrollable,
				// but a bare scrolling div is unreachable by keyboard: the
				// columns past the viewport can only be brought into view with
				// a pointer. tabindex makes the region focusable and therefore
				// arrow-scrollable, and the label keeps that focus stop from
				// being an unnamed one.
				<div class="table-scroll" role="region" aria-label="Campaign stages" tabindex="0">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
						<thead>
							<tr style="text-align: left; border-bottom: 1px solid var(--border-color);">
								<th scope="col" style="padding: 0.5rem 0.75rem;">#</th>
								<th scope="col" style="padding: 0.5rem 0.75rem;">Stage</th>
								<th scope="col" style="padding: 0.5rem 0.75rem;">State</th>
								<th scope="col" style="padding: 0.5rem 0.75rem; text-align: right;">Circles</th>
								<th scope="col" style="padding: 0.5rem 0.75rem; text-align: right;">Cost</th>
								<th scope="col" style="padding: 0.5rem 0.75rem; text-align: right;">PSNR</th>
								<th scope="col" style="padding: 0.5rem 0.75rem; text-align: right;">Elapsed</th>
								// The column head carried its meaning in a title
								// attribute alone, which neither a keyboard nor a
								// screen reader surfaces reliably.
								<th scope="col" style="padding: 0.5rem 0.75rem; text-align: right;">Accepted<span class="sr-only"> polishing sweeps</span></th>
								<th scope="col" style="padding: 0.5rem 0.75rem;">Job</th>
							</tr>
						</thead>
						<tbody>
							for _, stage := range campaign.Stages {
								<tr style="border-bottom: 1px solid var(--border-color);">
									<td style="padding: 0.5rem 0.75rem; color: var(--text-muted);">{ fmt.Sprintf("%d", stage.Index) }</td>
									<td style="padding: 0.5rem 0.75rem;">{ stage.Kind }</td>
									<td style="padding: 0.5rem 0.75rem;">@StateBadge(stage.State)</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;">{ fmt.Sprintf("%d", stage.Circles) }</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;">{ formatCampaignCost(stage) }</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;">{ formatCampaignPSNR(stage) }</td>
									// Both cells explain an em dash through a title
									// attribute. The title stays for the mouse,
									// but the explanation is also written into
									// the cell so a reader who never hovers still
									// learns why the figure is missing.
									<td style="padding: 0.5rem 0.75rem; text-align: right;" title={ stage.ElapsedAbsent }>
										{ formatCampaignElapsed(stage) }
										if stage.ElapsedAbsent != "" {
											<span class="sr-only">{ stage.ElapsedAbsent }</span>
										}
									</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;" title={ acceptedSweepsTitle(stage) }>
										{ formatAcceptedSweeps(stage) }
										if acceptedSweepsTitle(stage) != "" {
											<span class="sr-only">{ acceptedSweepsTitle(stage) }</span>
										}
									</td>
									<td style="padding: 0.5rem 0.75rem; font-family: monospace;">
										if stage.JobID != "" {
											<a href={ templ.URL(fmt.Sprintf("/jobs/%s", stage.JobID)) }>{ shortID(stage.JobID) }</a>
										} else {
											<span style="color: var(--text-muted);">—</span>
										}
									</td>
								</tr>
								if stage.Note != "" {
									<tr>
										<td colspan="9" style="padding: 0 0.75rem 0.5rem; color: var(--text-muted); font-size: 0.8125rem;">
											{ stage.Note }
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
				<p style="color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.75rem;">
					PSNR is derived from the stage cost. Accepted sweeps are not persisted by the
					polisher, so the column reports them as unrecorded rather than as zero.
				</p>
			}
		</div>
		</div>
		@IslandBundle()
		}
}

// CampaignProjectionCard reports where the fit lands, once against the plan's
// circle ceiling and once against the finish projection's clock.
//
// The two columns sit side by side rather than one under the other because
// they are alternatives, not steps: a reader is short of circles or short of
// time, and the card's job is to make the disagreement between the two answers
// visible when the rates diverge.
templ CampaignProjectionCard(projection CampaignProjection) {
	<div class="card">
		<h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.25rem;">Where the fit lands</h2>
		<p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
			{ campaignProjectionBasis(projection) }
		</p>
		// min(18rem, 100%) rather than a bare 18rem: an auto-fit track keeps its
		// minimum even when the container is narrower than it, so on a 320px
		// viewport the 288px track overflowed a ~240px card interior and scrolled
		// the whole page sideways.
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: 1.5rem;">
			<div>
				<h3 style="font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.5rem;">Against a circle ceiling</h3>
				@campaignProjectionRow("Measured", campaignPerCircleRate(projection))
				@campaignProjectionRow("Remaining", campaignRemainingCircles(projection))
				@campaignProjectionRow("Projected", campaignProjectedPlanEnd(projection))
			</div>
			<div>
				<h3 style="font-size: 0.9375rem; font-weight: 600; margin-bottom: 0.5rem;">Against a time budget</h3>
				@campaignProjectionRow("Measured", campaignPerHourRate(projection))
				@campaignProjectionRow("Remaining", campaignRemainingElapsed(projection))
				@campaignProjectionRow("Projected", campaignProjectedFinish(projection))
			</div>
		</div>
		if projection.Note != "" {
			<p style="color: var(--text-muted); font-size: 0.8125rem; margin-top: 1rem;">{ projection.Note }</p>
		}
		<p style="color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.5rem;">
			The two answers differ because the objective does: while the circle budget is open, gain per
			hour decides; against a fixed ceiling, gain per circle does. See <code>docs/schedule-format.md</code>.
		</p>
	</div>
}

// campaignProjectionRow is one labelled figure. The label column is fixed so
// the two projections line up with each other, which is the comparison the
// card exists for.
templ campaignProjectionRow(label string, value string) {
	<div style="display: flex; gap: 0.75rem; font-size: 0.875rem; margin-bottom: 0.25rem;">
		<span style="color: var(--text-muted); min-width: 5.5rem;">{ label }</span>
		<span>{ value }</span>
	</div>
}

// CampaignNotFound is the campaign counterpart of JobNotFound.
templ CampaignNotFound(id string, detail string) {
	@Layout("Campaign not found") {
		<div class="card" style="text-align: center; padding: 3rem;">
			<h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">Campaign not found</h1>
			<p style="color: var(--text-muted); font-family: monospace;">{ id }</p>
			if detail != "" {
				<p style="color: var(--text-muted); margin-top: 0.5rem;">{ detail }</p>
			}
			<p style="margin-top: 1.5rem;"><a class="btn btn-primary" href="/schedules">Back to campaigns</a></p>
		</div>
	}
}

// CampaignCostPlot draws cost against circle count as inline SVG. It is
// deliberately generated here rather than by a charting library: the UI is
// served locally with no external assets, and a plot that needs a CDN is a plot
// that does not render.
templ CampaignCostPlot(stages []CampaignStage) {
	{{ plot := buildCampaignPlot(stages) }}
	if plot.Empty {
		<p style="color: var(--text-muted);">No stage has recorded a cost yet.</p>
	} else {
		<svg
			role="img"
			aria-label="Best cost against circle count across the campaign"
			viewBox={ plot.ViewBox }
			width="100%"
			height={ fmt.Sprintf("%d", plot.Height) }
			style="display: block; max-width: 100%; background-color: var(--control-bg); border: 1px solid var(--border-color); border-radius: 0.25rem; font-family: inherit;"
		>
			for _, line := range plot.GridLines {
				<line x1={ line.X1 } y1={ line.Y1 } x2={ line.X2 } y2={ line.Y2 } stroke="var(--grid-color)" stroke-width="1"></line>
			}
			<line x1={ plot.AxisX1 } y1={ plot.AxisY } x2={ plot.AxisX2 } y2={ plot.AxisY } stroke="var(--border-color)" stroke-width="1"></line>
			<line x1={ plot.AxisX1 } y1={ plot.AxisTop } x2={ plot.AxisX1 } y2={ plot.AxisY } stroke="var(--border-color)" stroke-width="1"></line>
			<polyline fill="none" stroke="var(--primary-color)" stroke-width="2" points={ plot.Polyline }></polyline>
			for _, point := range plot.Points {
				if point.Polish {
					<rect x={ point.RectX } y={ point.RectY } width="8" height="8" fill={ point.Fill }>
						<title>{ point.Title }</title>
					</rect>
				} else {
					<circle cx={ point.CX } cy={ point.CY } r="4" fill={ point.Fill }>
						<title>{ point.Title }</title>
					</circle>
				}
			}
			for _, tick := range plot.XTicks {
				<text x={ tick.X } y={ tick.Y } text-anchor="middle" font-size="11" fill="var(--text-muted)">{ tick.Label }</text>
			}
			for _, tick := range plot.YTicks {
				<text x={ tick.X } y={ tick.Y } text-anchor="end" font-size="11" fill="var(--text-muted)">{ tick.Label }</text>
			}
			<text x={ plot.XLabelX } y={ plot.XLabelY } text-anchor="middle" font-size="12" fill="var(--text-muted)">Circles</text>
			<text x={ plot.YLabelX } y={ plot.YLabelY } text-anchor="middle" font-size="12" fill="var(--text-muted)" transform={ plot.YLabelTransform }>Best cost</text>
		</svg>
		// The swatches are decorative: each one's meaning is the word beside it,
		// so an unnamed graphic in the accessibility tree would only repeat the
		// label as noise.
		<div class="meta-row" style="margin-top: 0.5rem; font-size: 0.8125rem; color: var(--text-muted);">
			<span><svg aria-hidden="true" width="10" height="10" style="vertical-align: middle;"><circle cx="5" cy="5" r="4" fill="var(--success-color)"></circle></svg> base</span>
			<span><svg aria-hidden="true" width="10" height="10" style="vertical-align: middle;"><circle cx="5" cy="5" r="4" fill="var(--primary-color)"></circle></svg> extend</span>
			<span><svg aria-hidden="true" width="10" height="10" style="vertical-align: middle;"><rect x="1" y="1" width="8" height="8" fill="var(--warning-color)"></rect></svg> polish</span>
		</div>
	}
}

// campaignPlot is the resolved geometry of the cost-against-circles plot. All
// coordinates are strings because they are written straight into SVG
// attributes, and rounding once here keeps the markup stable between renders.
type campaignPlot struct {
	Empty  bool
	Height int

	ViewBox  string
	AxisX1   string
	AxisX2   string
	AxisY    string
	AxisTop  string
	Polyline string

	GridLines []campaignPlotLine
	Points    []campaignPlotPoint
	XTicks    []campaignPlotTick
	YTicks    []campaignPlotTick

	XLabelX         string
	XLabelY         string
	YLabelX         string
	YLabelY         string
	YLabelTransform string
}

type campaignPlotLine struct {
	X1, Y1, X2, Y2 string
}

type campaignPlotPoint struct {
	CX, CY       string
	RectX, RectY string
	Polish       bool
	Fill         string
	Title        string
}

type campaignPlotTick struct {
	X, Y  string
	Label string
}

const (
	campaignPlotWidth   = 960
	campaignPlotHeight  = 340
	campaignPlotLeft    = 76
	campaignPlotRight   = 24
	campaignPlotTop     = 20
	campaignPlotBottom  = 56
	campaignPlotTickNum = 5
)

// buildCampaignPlot resolves the plot geometry from the stages that recorded a
// cost. Stages without one are skipped rather than plotted at zero: a running
// stage has no result yet, and drawing it as a perfect fit would invert the
// meaning of the chart.
func buildCampaignPlot(stages []CampaignStage) campaignPlot {
	type sample struct {
		circles int
		cost    float64
		kind    string
		index   int
	}
	samples := make([]sample, 0, len(stages))
	for _, stage := range stages {
		if !stage.HasBestCost || math.IsNaN(stage.BestCost) || math.IsInf(stage.BestCost, 0) {
			continue
		}
		samples = append(samples, sample{circles: stage.Circles, cost: stage.BestCost, kind: stage.Kind, index: stage.Index})
	}
	if len(samples) == 0 {
		return campaignPlot{Empty: true}
	}
	sort.SliceStable(samples, func(i, j int) bool { return samples[i].index < samples[j].index })

	minCircles, maxCircles := samples[0].circles, samples[0].circles
	minCost, maxCost := samples[0].cost, samples[0].cost
	for _, item := range samples {
		minCircles = min(minCircles, item.circles)
		maxCircles = max(maxCircles, item.circles)
		minCost = math.Min(minCost, item.cost)
		maxCost = math.Max(maxCost, item.cost)
	}
	// A single point, or a campaign whose cost never moved, still deserves a
	// readable chart rather than a division by zero.
	if maxCircles == minCircles {
		maxCircles = minCircles + 1
	}
	if maxCost == minCost {
		span := math.Abs(minCost) * 0.05
		if span == 0 {
			span = 1
		}
		minCost -= span
		maxCost += span
	}

	left, right := float64(campaignPlotLeft), float64(campaignPlotWidth-campaignPlotRight)
	top, bottom := float64(campaignPlotTop), float64(campaignPlotHeight-campaignPlotBottom)
	scaleX := func(circles int) float64 {
		ratio := float64(circles-minCircles) / float64(maxCircles-minCircles)
		return left + ratio*(right-left)
	}
	scaleY := func(cost float64) float64 {
		ratio := (cost - minCost) / (maxCost - minCost)
		return bottom - ratio*(bottom-top)
	}

	plot := campaignPlot{
		Height:          campaignPlotHeight,
		ViewBox:         fmt.Sprintf("0 0 %d %d", campaignPlotWidth, campaignPlotHeight),
		AxisX1:          coord(left),
		AxisX2:          coord(right),
		AxisY:           coord(bottom),
		AxisTop:         coord(top),
		XLabelX:         coord((left + right) / 2),
		XLabelY:         coord(float64(campaignPlotHeight) - 12),
		YLabelX:         coord(18),
		YLabelY:         coord((top + bottom) / 2),
		YLabelTransform: fmt.Sprintf("rotate(-90 %s %s)", coord(18), coord((top+bottom)/2)),
	}

	var polyline strings.Builder
	for i, item := range samples {
		x, y := scaleX(item.circles), scaleY(item.cost)
		if i > 0 {
			polyline.WriteByte(' ')
		}
		polyline.WriteString(coord(x) + "," + coord(y))
		plot.Points = append(plot.Points, campaignPlotPoint{
			CX:     coord(x),
			CY:     coord(y),
			RectX:  coord(x - 4),
			RectY:  coord(y - 4),
			Polish: item.kind == "polish",
			Fill:   campaignPointFill(item.kind),
			Title:  fmt.Sprintf("stage %d (%s): %d circles, cost %.3f", item.index, item.kind, item.circles, item.cost),
		})
	}
	plot.Polyline = polyline.String()

	for i := 0; i <= campaignPlotTickNum; i++ {
		ratio := float64(i) / campaignPlotTickNum
		circles := float64(minCircles) + ratio*float64(maxCircles-minCircles)
		x := left + ratio*(right-left)
		plot.XTicks = append(plot.XTicks, campaignPlotTick{
			X: coord(x), Y: coord(bottom + 18), Label: fmt.Sprintf("%.0f", circles),
		})
		cost := minCost + ratio*(maxCost-minCost)
		y := bottom - ratio*(bottom-top)
		plot.YTicks = append(plot.YTicks, campaignPlotTick{
			X: coord(left - 8), Y: coord(y + 4), Label: formatPlotCost(cost),
		})
		plot.GridLines = append(plot.GridLines, campaignPlotLine{
			X1: coord(left), Y1: coord(y), X2: coord(right), Y2: coord(y),
		})
	}
	return plot
}

func campaignPointFill(kind string) string {
	switch kind {
	case "base":
		return "var(--success-color)"
	case "polish":
		return "var(--warning-color)"
	default:
		return "var(--primary-color)"
	}
}

func coord(value float64) string {
	return fmt.Sprintf("%.2f", value)
}

func formatPlotCost(cost float64) string {
	if math.Abs(cost) >= 1000 {
		return fmt.Sprintf("%.0f", cost)
	}
	return fmt.Sprintf("%.2f", cost)
}

func campaignTitle(campaign Campaign) string {
	if campaign.Name != "" {
		return campaign.Name
	}
	if campaign.Source == CampaignFromChain {
		return "Imported chain " + shortID(campaign.ID)
	}
	return "Campaign " + shortID(campaign.ID)
}

func campaignProvenance(campaign Campaign) string {
	recorded := len(campaign.Stages)
	switch campaign.Source {
	case CampaignFromChain:
		return fmt.Sprintf("Reconstructed from checkpoint lineage · %d stages", recorded)
	default:
		text := fmt.Sprintf("Schedule · %d of %d stages recorded", recorded, campaign.PlannedStages)
		if campaign.HasSeed {
			text += fmt.Sprintf(" · seed %d", campaign.CampaignSeed)
		}
		return text
	}
}

func campaignStageCount(summary CampaignSummary) string {
	if summary.PlannedStages > 0 {
		return fmt.Sprintf("%d / %d", summary.RecordedStages, summary.PlannedStages)
	}
	return fmt.Sprintf("%d", summary.RecordedStages)
}

func latestCompletedCampaignStage(stages []CampaignStage) (CampaignStage, bool) {
	for index := len(stages) - 1; index >= 0; index-- {
		stage := stages[index]
		if !stage.HasBestCost || stage.JobID == "" {
			continue
		}
		return stage, true
	}
	return CampaignStage{}, false
}

func shortID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

func formatCampaignCost(stage CampaignStage) string {
	if !stage.HasBestCost {
		return "—"
	}
	return fmt.Sprintf("%.3f", stage.BestCost)
}

func formatCampaignPSNR(stage CampaignStage) string {
	switch {
	case stage.PSNRInfinite:
		return "∞ dB"
	case !stage.HasPSNR:
		return "—"
	default:
		return fmt.Sprintf("%.2f dB", stage.PSNR)
	}
}

func formatCampaignElapsed(stage CampaignStage) string {
	if !stage.HasElapsed {
		return "—"
	}
	return time.Duration(stage.ElapsedSec * float64(time.Second)).Round(time.Second).String()
}

// campaignWarningHeading labels the advisory card. A card that said
// "Advisories: 1 stage…" would read as a count of nothing in particular, so the
// heading agrees with the list under it instead.
func campaignWarningHeading(warnings []string) string {
	if len(warnings) == 1 {
		return "Advisory:"
	}
	return "Advisories:"
}

// campaignProjectionBasis says what the estimate was built from, so a reader
// can weigh it before reading it.
func campaignProjectionBasis(projection CampaignProjection) string {
	if !projection.Projected {
		return "Not enough completed stages to project a cost yet."
	}
	return fmt.Sprintf(
		"From %s alone, at %d circles and cost %.3f. The projections below extrapolate the trailing %s, not the whole campaign.",
		countedCampaignStages(projection.Samples), projection.LatestCircles, projection.LatestCost,
		countedCampaignLegs(projection.RecentLegs))
}

// campaignPerCircleRate and campaignPerHourRate print the trailing rate each
// projection was extrapolated with, rather than the whole-campaign one. The
// campaign average is shown nowhere on this card for the reason it is not
// extrapolated: per-circle return decays, so quoting it beside a projection
// built from a different number would invite the reader to check one against
// the other.
func campaignPerCircleRate(projection CampaignProjection) string {
	// Gated on the denominator, never on the rate: a trailing window that added
	// circles and removed no cost measured a rate of zero, which is a finding
	// about the campaign rather than a missing number. The CLI's own block
	// gates on HasCircleCeiling for the same reason and prints 0.000000, and a
	// dash here would make the two surfaces disagree about a measurement they
	// both hold.
	if !projection.Projected || projection.RecentCircles <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.6f cost/circle over the last %d circles",
		projection.RecentGainPerCircle, projection.RecentCircles)
}

func campaignPerHourRate(projection CampaignProjection) string {
	if !projection.Projected || projection.RecentElapsedSec <= 0 {
		return "—"
	}
	return fmt.Sprintf("%.2f cost/hour over the last %s", projection.RecentGainPerHour,
		time.Duration(projection.RecentElapsedSec*float64(time.Second)).Round(time.Second))
}

// campaignRemainingCircles names the ceiling as well as the shortfall, because
// "1000 circles" alone does not say what the plan is aiming at.
func campaignRemainingCircles(projection CampaignProjection) string {
	if projection.RemainingCircles <= 0 {
		return "—"
	}
	return fmt.Sprintf("%d circles to %d", projection.RemainingCircles,
		projection.LatestCircles+projection.RemainingCircles)
}

func campaignRemainingElapsed(projection CampaignProjection) string {
	if projection.RemainingElapsedSec <= 0 {
		return "—"
	}
	return time.Duration(projection.RemainingElapsedSec * float64(time.Second)).Round(time.Second).String()
}

func campaignProjectedPlanEnd(projection CampaignProjection) string {
	return formatProjectedCost(projection.HasCircleCeiling, projection.CostAtPlanEnd,
		projection.HasPlanEndPSNR, projection.PlanEndPSNRInfinite, projection.PlanEndPSNR)
}

func campaignProjectedFinish(projection CampaignProjection) string {
	return formatProjectedCost(projection.HasTimeBudget, projection.CostAtFinish,
		projection.HasFinishPSNR, projection.FinishPSNRInfinite, projection.FinishPSNR)
}

// formatProjectedCost prints a projected cost with the PSNR the caller derived
// for it. The PSNR is parenthesised rather than given a column of its own,
// because it restates the cost beside it instead of adding a second figure.
func formatProjectedCost(present bool, cost float64, hasPSNR, infinite bool, psnr float64) string {
	if !present {
		return "—"
	}
	switch {
	case infinite:
		return fmt.Sprintf("%.3f (PSNR ∞ dB)", cost)
	case hasPSNR:
		return fmt.Sprintf("%.3f (PSNR %.2f dB)", cost, psnr)
	default:
		return fmt.Sprintf("%.3f", cost)
	}
}

// countedCampaignStages and countedCampaignLegs count in words a sentence can
// contain, so a card never reads "1 stages" or "1 legs".
func countedCampaignStages(stages int) string {
	if stages == 1 {
		return "1 measured stage"
	}
	return fmt.Sprintf("%d measured stages", stages)
}

func countedCampaignLegs(legs int) string {
	if legs == 1 {
		return "leg"
	}
	return fmt.Sprintf("%d legs", legs)
}

func formatAcceptedSweeps(stage CampaignStage) string {
	if stage.AcceptedSweeps == nil {
		return "—"
	}
	return fmt.Sprintf("%d", *stage.AcceptedSweeps)
}

func acceptedSweepsTitle(stage CampaignStage) string {
	if stage.AcceptedSweeps != nil {
		return ""
	}
	if stage.Kind != "polish" {
		return "Only a polish stage runs sweeps"
	}
	return "The polisher does not persist its accepted-sweep count"
}
