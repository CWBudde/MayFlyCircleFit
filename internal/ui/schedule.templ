package ui

import (
	"fmt"
	"math"
	"sort"
	"strings"
	"time"
)

// The campaign views read a chain of stages as one run. Everything they show is
// carried in by the caller: this package computes layout, never metrics, so a
// column that the server could not populate stays visibly blank instead of
// being invented here.

// CampaignSource says where a campaign view was reconstructed from, because the
// two sources answer different questions about what is trustworthy. A schedule
// was planned up front and records its own stage table; an imported chain was
// walked backwards from a job's checkpoint lineage and therefore knows only
// what a checkpoint happens to carry.
type CampaignSource string

const (
	CampaignFromSchedule CampaignSource = "schedule"
	CampaignFromChain    CampaignSource = "chain"
)

// CampaignStage is one row of the stage table.
//
// The optional metrics use explicit presence flags rather than sentinel values.
// A cost of zero and an unmeasured cost are different facts, and a campaign
// view whose whole purpose is comparing runs must not blur them.
type CampaignStage struct {
	Index int    `json:"index"`
	Kind  string `json:"kind"`
	State string `json:"state"`

	Circles int `json:"circles"`

	BestCost    float64 `json:"bestCost"`
	HasBestCost bool    `json:"hasBestCost"`

	// PSNR is derived from the cost by the caller. It is shown because a cost is
	// hard to compare across reference images and a PSNR is not.
	PSNR         float64 `json:"psnr"`
	PSNRInfinite bool    `json:"psnrInfinite"`
	HasPSNR      bool    `json:"hasPsnr"`

	Iterations  int   `json:"iterations"`
	Evaluations int64 `json:"evaluations"`

	ElapsedSec    float64 `json:"elapsedSec"`
	HasElapsed    bool    `json:"hasElapsed"`
	ElapsedAbsent string  `json:"elapsedAbsent"`

	// AcceptedSweeps is the accepted-sweep count for a polish stage. It is a
	// pointer because the count is not persisted anywhere today, so every
	// polish row leaves it nil and the column says so rather than showing a
	// zero that would read as "no sweep helped".
	AcceptedSweeps *int `json:"acceptedSweeps,omitempty"`

	JobID       string `json:"jobId"`
	ParentJobID string `json:"parentJobId"`

	// Note carries the stage's own explanation — a policy reason for a skipped
	// stage, or the error for a failed one.
	Note string `json:"note"`
}

// Campaign is a whole chain presented as one run.
type Campaign struct {
	ID     string         `json:"id"`
	Name   string         `json:"name"`
	State  string         `json:"state"`
	Source CampaignSource `json:"source"`

	CampaignSeed int64 `json:"campaignSeed"`
	HasSeed      bool  `json:"hasSeed"`

	// PlannedStages is the stage count the plan calls for, which exceeds the
	// recorded stages while a campaign is still running. An imported chain has
	// no plan and leaves it zero.
	PlannedStages int `json:"plannedStages"`

	Stages []CampaignStage `json:"stages"`
	Error  string          `json:"error"`
}

// CampaignSummary is a campaign in a listing. It is also the JSON the dashboard
// endpoint serves, so its tags carry the same camelCase the rest of the API
// uses; the island and the server-rendered card read the identical shape.
type CampaignSummary struct {
	ID     string         `json:"id"`
	Name   string         `json:"name"`
	State  string         `json:"state"`
	Source CampaignSource `json:"source"`

	RecordedStages int `json:"recordedStages"`
	PlannedStages  int `json:"plannedStages"`

	CampaignSeries []CampaignSeriesPoint `json:"campaignSeries"`
	LeafJobID      string                `json:"leafJobId,omitempty"`

	Circles     int     `json:"circles"`
	BestCost    float64 `json:"bestCost"`
	HasBestCost bool    `json:"hasBestCost"`

	UpdatedAt time.Time `json:"updatedAt"`
}

// CampaignSeriesPoint is one stage in the compact campaign line preview used by
// dashboard summaries and mini charts.
type CampaignSeriesPoint struct {
	Index   int    `json:"index"`
	Kind    string `json:"kind"`
	Circles int    `json:"circles"`

	BestCost    float64 `json:"bestCost"`
	HasBestCost bool    `json:"hasBestCost"`
}

// CampaignListPage lists every campaign the server can reconstruct: the
// schedules it planned, and the ad-hoc extend/polish chains it can still read
// back out of checkpoint lineage.
templ CampaignListPage(schedules []CampaignSummary, chains []CampaignSummary, unavailable string) {
	@Layout("Campaigns") {
		<div data-island="campaign-list" data-island-label="campaign list">
		@templ.JSONScript("campaign-list-page", struct {
			Schedules []CampaignSummary `json:"schedules"`
			Chains []CampaignSummary `json:"chains"`
		}{schedules, chains})
		<div style="margin-bottom: 2rem;">
			<h1 style="font-size: 2rem; font-weight: 700;">Campaigns</h1>
			<p style="color: var(--text-muted);">
				A campaign is a chain of stages read as one run rather than as unrelated jobs.
			</p>
		</div>
		if unavailable != "" {
			<div class="card" style="border-left: 4px solid var(--warning-color);">
				<strong>Campaigns are unavailable:</strong> { unavailable }
			</div>
		} else {
			<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem;">Schedules</h2>
			if len(schedules) == 0 {
				<div class="card" style="color: var(--text-muted);">
					No schedules yet. Create one with <code>POST /api/v1/schedules</code> or <code>mayflycirclefit schedule create</code>.
				</div>
			} else {
				<div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
					for _, summary := range schedules {
						@campaignCard(summary, fmt.Sprintf("/schedules/%s", summary.ID))
					}
				</div>
			}
			<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem;">Imported chains</h2>
			<p style="color: var(--text-muted); margin-bottom: 0.75rem; font-size: 0.875rem;">
				Reconstructed from the <code>extendedFrom</code> and <code>polishedFrom</code> lineage on
				each checkpoint, so a chain driven by hand before schedules existed still reads as one run.
			</p>
			if len(chains) == 0 {
				<div class="card" style="color: var(--text-muted);">
					No multi-stage chains outside a schedule.
				</div>
			} else {
				<div style="display: grid; gap: 1rem;">
					for _, summary := range chains {
						@campaignCard(summary, fmt.Sprintf("/chains/%s", summary.ID))
					}
				</div>
			}
		}
		</div>
		@IslandBundle()
	}
}

templ campaignCard(summary CampaignSummary, href string) {
	<a href={ templ.URL(href) } style="text-decoration: none; color: inherit;">
		<div class="card" style="cursor: pointer; margin-bottom: 0;">
			<div style="display: flex; justify-content: space-between; align-items: start; gap: 1rem;">
				<div>
					<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
						<h3 style="font-size: 1.125rem; font-weight: 600; font-family: monospace;">
							{ shortID(summary.ID) }
						</h3>
						@ScheduleStateBadge(summary.State)
						if summary.Name != "" {
							<span style="color: var(--text-muted);">{ summary.Name }</span>
						}
					</div>
					<div style="display: flex; gap: 1.5rem; color: var(--text-muted); font-size: 0.875rem;">
						<span><strong>Stages:</strong> { campaignStageCount(summary) }</span>
						<span><strong>Circles:</strong> { fmt.Sprintf("%d", summary.Circles) }</span>
					</div>
				</div>
				<div style="text-align: right;">
					if summary.HasBestCost {
						<div style="font-size: 0.875rem; color: var(--text-muted);">Best cost</div>
						<div style="font-size: 1.25rem; font-weight: 600;">{ fmt.Sprintf("%.2f", summary.BestCost) }</div>
					}
					if !summary.UpdatedAt.IsZero() {
						<div style="font-size: 0.75rem; color: var(--text-muted);">{ formatTime(summary.UpdatedAt) }</div>
					}
				</div>
			</div>
		</div>
	</a>
}

// CampaignPage renders one campaign: the stage table and the cost-against-
// circles plot that answers whether this schedule beat the last one.
templ CampaignPage(campaign Campaign) {
	@Layout(campaignTitle(campaign)) {
		<div data-island="campaign-detail" data-island-label="campaign detail">
		@templ.JSONScript("campaign-detail-page", campaign)
		<div style="margin-bottom: 1.5rem;">
			<div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
				<h1 style="font-size: 1.75rem; font-weight: 700;">{ campaignTitle(campaign) }</h1>
				@ScheduleStateBadge(campaign.State)
			</div>
			<div style="color: var(--text-muted); font-family: monospace; font-size: 0.875rem;">{ campaign.ID }</div>
			<div style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem;">
				{ campaignProvenance(campaign) }
			</div>
		</div>
		if campaign.Error != "" {
			<div class="card" style="background-color: var(--error-bg); color: var(--error-text);">
				<strong>Error:</strong> { campaign.Error }
			</div>
		}
		<div class="card">
			<h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;">Cost against circle count</h2>
			@CampaignCostPlot(campaign.Stages)
		</div>
		if stage, ok := latestCompletedCampaignStage(campaign.Stages); ok {
			@ImageViewer(ImageViewerData{
				JobID:             stage.JobID,
				DefaultMode:       "side-by-side",
				BestRevision:      0,
				ReferenceImageURL: fmt.Sprintf("/api/v1/jobs/%s/ref.png", stage.JobID),
				BestImageURL:      fmt.Sprintf("/api/v1/jobs/%s/best.png", stage.JobID),
				DiffImageURL:      fmt.Sprintf("/api/v1/jobs/%s/diff.png", stage.JobID),
				JobState:          stage.State,
				MaxIterations:     stage.Iterations,
				ShowMetadata:      false,
				ExtraClass:        "campaign-images",
			})
		} else {
			<div class="card" style="color: var(--text-muted);">
				No completed stage has produced image artifacts yet.
			</div>
		}
		<div class="card">
			<h2 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem;">Stages</h2>
			if len(campaign.Stages) == 0 {
				<p style="color: var(--text-muted);">No stage has been recorded yet.</p>
			} else {
				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
						<thead>
							<tr style="text-align: left; border-bottom: 1px solid var(--border-color);">
								<th style="padding: 0.5rem 0.75rem;">#</th>
								<th style="padding: 0.5rem 0.75rem;">Stage</th>
								<th style="padding: 0.5rem 0.75rem;">State</th>
								<th style="padding: 0.5rem 0.75rem; text-align: right;">Circles</th>
								<th style="padding: 0.5rem 0.75rem; text-align: right;">Cost</th>
								<th style="padding: 0.5rem 0.75rem; text-align: right;">PSNR</th>
								<th style="padding: 0.5rem 0.75rem; text-align: right;">Elapsed</th>
								<th style="padding: 0.5rem 0.75rem; text-align: right;" title="Accepted polishing sweeps">Accepted</th>
								<th style="padding: 0.5rem 0.75rem;">Job</th>
							</tr>
						</thead>
						<tbody>
							for _, stage := range campaign.Stages {
								<tr style="border-bottom: 1px solid var(--border-color);">
									<td style="padding: 0.5rem 0.75rem; color: var(--text-muted);">{ fmt.Sprintf("%d", stage.Index) }</td>
									<td style="padding: 0.5rem 0.75rem;">{ stage.Kind }</td>
									<td style="padding: 0.5rem 0.75rem;">@ScheduleStateBadge(stage.State)</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;">{ fmt.Sprintf("%d", stage.Circles) }</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;">{ formatCampaignCost(stage) }</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;">{ formatCampaignPSNR(stage) }</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;" title={ stage.ElapsedAbsent }>{ formatCampaignElapsed(stage) }</td>
									<td style="padding: 0.5rem 0.75rem; text-align: right;" title={ acceptedSweepsTitle(stage) }>{ formatAcceptedSweeps(stage) }</td>
									<td style="padding: 0.5rem 0.75rem; font-family: monospace;">
										if stage.JobID != "" {
											<a href={ templ.URL(fmt.Sprintf("/jobs/%s", stage.JobID)) }>{ shortID(stage.JobID) }</a>
										} else {
											<span style="color: var(--text-muted);">—</span>
										}
									</td>
								</tr>
								if stage.Note != "" {
									<tr>
										<td colspan="9" style="padding: 0 0.75rem 0.5rem; color: var(--text-muted); font-size: 0.8125rem;">
											{ stage.Note }
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
				<p style="color: var(--text-muted); font-size: 0.8125rem; margin-top: 0.75rem;">
					PSNR is derived from the stage cost. Accepted sweeps are not persisted by the
					polisher, so the column reports them as unrecorded rather than as zero.
				</p>
			}
		</div>
		</div>
		@IslandBundle()
		}
}

// CampaignNotFound is the campaign counterpart of JobNotFound.
templ CampaignNotFound(id string, detail string) {
	@Layout("Campaign not found") {
		<div class="card" style="text-align: center; padding: 3rem;">
			<h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">Campaign not found</h1>
			<p style="color: var(--text-muted); font-family: monospace;">{ id }</p>
			if detail != "" {
				<p style="color: var(--text-muted); margin-top: 0.5rem;">{ detail }</p>
			}
			<p style="margin-top: 1.5rem;"><a class="btn btn-primary" href="/schedules">Back to campaigns</a></p>
		</div>
	}
}

// ScheduleStateBadge covers the schedule and stage states, which share a
// vocabulary with job states but add paused and skipped.
templ ScheduleStateBadge(state string) {
	switch state {
		case "paused":
			<span class="badge badge-warning">Paused</span>
		case "skipped":
			<span class="badge" style="background-color: var(--border-color); color: var(--text-color);">Skipped</span>
		default:
			@StateBadge(state)
	}
}

// CampaignCostPlot draws cost against circle count as inline SVG. It is
// deliberately generated here rather than by a charting library: the UI is
// served locally with no external assets, and a plot that needs a CDN is a plot
// that does not render.
templ CampaignCostPlot(stages []CampaignStage) {
	{{ plot := buildCampaignPlot(stages) }}
	if plot.Empty {
		<p style="color: var(--text-muted);">No stage has recorded a cost yet.</p>
	} else {
		<svg
			role="img"
			aria-label="Best cost against circle count across the campaign"
			viewBox={ plot.ViewBox }
			width="100%"
			height={ fmt.Sprintf("%d", plot.Height) }
			style="display: block; max-width: 100%; background-color: var(--control-bg); border: 1px solid var(--border-color); border-radius: 0.25rem; font-family: inherit;"
		>
			for _, line := range plot.GridLines {
				<line x1={ line.X1 } y1={ line.Y1 } x2={ line.X2 } y2={ line.Y2 } stroke="var(--grid-color)" stroke-width="1"></line>
			}
			<line x1={ plot.AxisX1 } y1={ plot.AxisY } x2={ plot.AxisX2 } y2={ plot.AxisY } stroke="var(--border-color)" stroke-width="1"></line>
			<line x1={ plot.AxisX1 } y1={ plot.AxisTop } x2={ plot.AxisX1 } y2={ plot.AxisY } stroke="var(--border-color)" stroke-width="1"></line>
			<polyline fill="none" stroke="var(--primary-color)" stroke-width="2" points={ plot.Polyline }></polyline>
			for _, point := range plot.Points {
				if point.Polish {
					<rect x={ point.RectX } y={ point.RectY } width="8" height="8" fill={ point.Fill }>
						<title>{ point.Title }</title>
					</rect>
				} else {
					<circle cx={ point.CX } cy={ point.CY } r="4" fill={ point.Fill }>
						<title>{ point.Title }</title>
					</circle>
				}
			}
			for _, tick := range plot.XTicks {
				<text x={ tick.X } y={ tick.Y } text-anchor="middle" font-size="11" fill="var(--text-muted)">{ tick.Label }</text>
			}
			for _, tick := range plot.YTicks {
				<text x={ tick.X } y={ tick.Y } text-anchor="end" font-size="11" fill="var(--text-muted)">{ tick.Label }</text>
			}
			<text x={ plot.XLabelX } y={ plot.XLabelY } text-anchor="middle" font-size="12" fill="var(--text-muted)">Circles</text>
			<text x={ plot.YLabelX } y={ plot.YLabelY } text-anchor="middle" font-size="12" fill="var(--text-muted)" transform={ plot.YLabelTransform }>Best cost</text>
		</svg>
		<div style="display: flex; gap: 1.5rem; margin-top: 0.5rem; font-size: 0.8125rem; color: var(--text-muted);">
			<span><svg width="10" height="10" style="vertical-align: middle;"><circle cx="5" cy="5" r="4" fill="var(--success-color)"></circle></svg> base</span>
			<span><svg width="10" height="10" style="vertical-align: middle;"><circle cx="5" cy="5" r="4" fill="var(--primary-color)"></circle></svg> extend</span>
			<span><svg width="10" height="10" style="vertical-align: middle;"><rect x="1" y="1" width="8" height="8" fill="var(--warning-color)"></rect></svg> polish</span>
		</div>
	}
}

// campaignPlot is the resolved geometry of the cost-against-circles plot. All
// coordinates are strings because they are written straight into SVG
// attributes, and rounding once here keeps the markup stable between renders.
type campaignPlot struct {
	Empty  bool
	Height int

	ViewBox  string
	AxisX1   string
	AxisX2   string
	AxisY    string
	AxisTop  string
	Polyline string

	GridLines []campaignPlotLine
	Points    []campaignPlotPoint
	XTicks    []campaignPlotTick
	YTicks    []campaignPlotTick

	XLabelX         string
	XLabelY         string
	YLabelX         string
	YLabelY         string
	YLabelTransform string
}

type campaignPlotLine struct {
	X1, Y1, X2, Y2 string
}

type campaignPlotPoint struct {
	CX, CY       string
	RectX, RectY string
	Polish       bool
	Fill         string
	Title        string
}

type campaignPlotTick struct {
	X, Y  string
	Label string
}

const (
	campaignPlotWidth   = 960
	campaignPlotHeight  = 340
	campaignPlotLeft    = 76
	campaignPlotRight   = 24
	campaignPlotTop     = 20
	campaignPlotBottom  = 56
	campaignPlotTickNum = 5
)

// buildCampaignPlot resolves the plot geometry from the stages that recorded a
// cost. Stages without one are skipped rather than plotted at zero: a running
// stage has no result yet, and drawing it as a perfect fit would invert the
// meaning of the chart.
func buildCampaignPlot(stages []CampaignStage) campaignPlot {
	type sample struct {
		circles int
		cost    float64
		kind    string
		index   int
	}
	samples := make([]sample, 0, len(stages))
	for _, stage := range stages {
		if !stage.HasBestCost || math.IsNaN(stage.BestCost) || math.IsInf(stage.BestCost, 0) {
			continue
		}
		samples = append(samples, sample{circles: stage.Circles, cost: stage.BestCost, kind: stage.Kind, index: stage.Index})
	}
	if len(samples) == 0 {
		return campaignPlot{Empty: true}
	}
	sort.SliceStable(samples, func(i, j int) bool { return samples[i].index < samples[j].index })

	minCircles, maxCircles := samples[0].circles, samples[0].circles
	minCost, maxCost := samples[0].cost, samples[0].cost
	for _, item := range samples {
		minCircles = min(minCircles, item.circles)
		maxCircles = max(maxCircles, item.circles)
		minCost = math.Min(minCost, item.cost)
		maxCost = math.Max(maxCost, item.cost)
	}
	// A single point, or a campaign whose cost never moved, still deserves a
	// readable chart rather than a division by zero.
	if maxCircles == minCircles {
		maxCircles = minCircles + 1
	}
	if maxCost == minCost {
		span := math.Abs(minCost) * 0.05
		if span == 0 {
			span = 1
		}
		minCost -= span
		maxCost += span
	}

	left, right := float64(campaignPlotLeft), float64(campaignPlotWidth-campaignPlotRight)
	top, bottom := float64(campaignPlotTop), float64(campaignPlotHeight-campaignPlotBottom)
	scaleX := func(circles int) float64 {
		ratio := float64(circles-minCircles) / float64(maxCircles-minCircles)
		return left + ratio*(right-left)
	}
	scaleY := func(cost float64) float64 {
		ratio := (cost - minCost) / (maxCost - minCost)
		return bottom - ratio*(bottom-top)
	}

	plot := campaignPlot{
		Height:          campaignPlotHeight,
		ViewBox:         fmt.Sprintf("0 0 %d %d", campaignPlotWidth, campaignPlotHeight),
		AxisX1:          coord(left),
		AxisX2:          coord(right),
		AxisY:           coord(bottom),
		AxisTop:         coord(top),
		XLabelX:         coord((left + right) / 2),
		XLabelY:         coord(float64(campaignPlotHeight) - 12),
		YLabelX:         coord(18),
		YLabelY:         coord((top + bottom) / 2),
		YLabelTransform: fmt.Sprintf("rotate(-90 %s %s)", coord(18), coord((top+bottom)/2)),
	}

	var polyline strings.Builder
	for i, item := range samples {
		x, y := scaleX(item.circles), scaleY(item.cost)
		if i > 0 {
			polyline.WriteByte(' ')
		}
		polyline.WriteString(coord(x) + "," + coord(y))
		plot.Points = append(plot.Points, campaignPlotPoint{
			CX:     coord(x),
			CY:     coord(y),
			RectX:  coord(x - 4),
			RectY:  coord(y - 4),
			Polish: item.kind == "polish",
			Fill:   campaignPointFill(item.kind),
			Title:  fmt.Sprintf("stage %d (%s): %d circles, cost %.3f", item.index, item.kind, item.circles, item.cost),
		})
	}
	plot.Polyline = polyline.String()

	for i := 0; i <= campaignPlotTickNum; i++ {
		ratio := float64(i) / campaignPlotTickNum
		circles := float64(minCircles) + ratio*float64(maxCircles-minCircles)
		x := left + ratio*(right-left)
		plot.XTicks = append(plot.XTicks, campaignPlotTick{
			X: coord(x), Y: coord(bottom + 18), Label: fmt.Sprintf("%.0f", circles),
		})
		cost := minCost + ratio*(maxCost-minCost)
		y := bottom - ratio*(bottom-top)
		plot.YTicks = append(plot.YTicks, campaignPlotTick{
			X: coord(left - 8), Y: coord(y + 4), Label: formatPlotCost(cost),
		})
		plot.GridLines = append(plot.GridLines, campaignPlotLine{
			X1: coord(left), Y1: coord(y), X2: coord(right), Y2: coord(y),
		})
	}
	return plot
}

func campaignPointFill(kind string) string {
	switch kind {
	case "base":
		return "var(--success-color)"
	case "polish":
		return "var(--warning-color)"
	default:
		return "var(--primary-color)"
	}
}

func coord(value float64) string {
	return fmt.Sprintf("%.2f", value)
}

func formatPlotCost(cost float64) string {
	if math.Abs(cost) >= 1000 {
		return fmt.Sprintf("%.0f", cost)
	}
	return fmt.Sprintf("%.2f", cost)
}

func campaignTitle(campaign Campaign) string {
	if campaign.Name != "" {
		return campaign.Name
	}
	if campaign.Source == CampaignFromChain {
		return "Imported chain " + shortID(campaign.ID)
	}
	return "Campaign " + shortID(campaign.ID)
}

func campaignProvenance(campaign Campaign) string {
	recorded := len(campaign.Stages)
	switch campaign.Source {
	case CampaignFromChain:
		return fmt.Sprintf("Reconstructed from checkpoint lineage · %d stages", recorded)
	default:
		text := fmt.Sprintf("Schedule · %d of %d stages recorded", recorded, campaign.PlannedStages)
		if campaign.HasSeed {
			text += fmt.Sprintf(" · seed %d", campaign.CampaignSeed)
		}
		return text
	}
}

func campaignStageCount(summary CampaignSummary) string {
	if summary.PlannedStages > 0 {
		return fmt.Sprintf("%d / %d", summary.RecordedStages, summary.PlannedStages)
	}
	return fmt.Sprintf("%d", summary.RecordedStages)
}

func latestCompletedCampaignStage(stages []CampaignStage) (CampaignStage, bool) {
	for index := len(stages) - 1; index >= 0; index-- {
		stage := stages[index]
		if !stage.HasBestCost || stage.JobID == "" {
			continue
		}
		return stage, true
	}
	return CampaignStage{}, false
}

func shortID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

func formatCampaignCost(stage CampaignStage) string {
	if !stage.HasBestCost {
		return "—"
	}
	return fmt.Sprintf("%.3f", stage.BestCost)
}

func formatCampaignPSNR(stage CampaignStage) string {
	switch {
	case stage.PSNRInfinite:
		return "∞ dB"
	case !stage.HasPSNR:
		return "—"
	default:
		return fmt.Sprintf("%.2f dB", stage.PSNR)
	}
}

func formatCampaignElapsed(stage CampaignStage) string {
	if !stage.HasElapsed {
		return "—"
	}
	return time.Duration(stage.ElapsedSec * float64(time.Second)).Round(time.Second).String()
}

func formatAcceptedSweeps(stage CampaignStage) string {
	if stage.AcceptedSweeps == nil {
		return "—"
	}
	return fmt.Sprintf("%d", *stage.AcceptedSweeps)
}

func acceptedSweepsTitle(stage CampaignStage) string {
	if stage.AcceptedSweeps != nil {
		return ""
	}
	if stage.Kind != "polish" {
		return "Only a polish stage runs sweeps"
	}
	return "The polisher does not persist its accepted-sweep count"
}
