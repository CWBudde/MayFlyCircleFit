package ui

// SettingsPage renders the browser-local UI preference editor. Every value is
// stored in localStorage under the same keys the job detail and image viewer
// scripts read, so the page never round-trips to the server.
templ SettingsPage() {
	@Layout("Settings") {
		<div style="margin-bottom: 1.5rem;">
			<h1 style="font-size: 2rem; font-weight: 700;">Settings</h1>
			<p style="color: var(--text-muted);">Configure UI defaults for job pages and charts. Preferences are stored in this browser only and apply to every job.</p>
		</div>
		<style>
			.settings-card {
				display: grid;
				gap: 1.5rem;
			}
			.setting-group {
				display: grid;
				gap: 0.75rem;
				padding: 1rem;
				border: 1px solid var(--border-color);
				border-radius: 0.5rem;
			}
			.setting-control {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
			}
			.setting-control > label {
				min-width: min(14rem, 100%);
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			.setting-control select,
			.setting-control input {
				padding: 0.35rem 0.5rem;
				border: 1px solid var(--border-color);
				border-radius: 0.25rem;
				background: var(--control-bg);
				color: var(--text-color);
			}
			.settings-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: center;
			}
			.settings-note {
				font-size: 0.8125rem;
				color: var(--text-muted);
			}
			.settings-metric-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
				gap: 0.5rem;
			}
			.settings-metric-option {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.35rem 0.5rem;
				border: 1px solid var(--border-color);
				border-radius: 0.25rem;
			}
			.settings-metric-option label {
				font-size: 0.85rem;
				color: var(--text-color);
			}
		</style>
		<div class="card settings-card">
			<div class="setting-group">
				<h2 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Image refresh</h2>
				<div class="setting-control">
					<label for="settings-image-refresh">Auto image refresh</label>
					<select id="settings-image-refresh" aria-describedby="settings-image-refresh-note">
						<option value="0">SSE-driven (default)</option>
						<option value="1000">1 second</option>
						<option value="2000">2 seconds</option>
						<option value="5000">5 seconds</option>
						<option value="10000">10 seconds</option>
						<option value="30000">30 seconds</option>
					</select>
				</div>
				<p id="settings-image-refresh-note" class="settings-note">SSE-driven updates keep metrics and images responsive while a job runs. Pick an interval only if the event stream is blocked, for example behind a buffering proxy; active jobs then poll the status endpoint instead.</p>
			</div>
			<div class="setting-group">
				<h2 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Image defaults</h2>
				<div class="setting-control">
					<label for="settings-default-view-mode">Default image view mode</label>
					<select id="settings-default-view-mode" aria-describedby="settings-default-view-mode-note">
						<option value="reference">Reference</option>
						<option value="best">Best</option>
						<option value="side-by-side">Side-by-Side</option>
						<option value="difference">Difference</option>
						<option value="overlay">Overlay</option>
					</select>
				</div>
				<p id="settings-default-view-mode-note" class="settings-note">Applies to every job page. Switching modes on a job page updates this value too.</p>
				<div class="setting-control">
					<label for="settings-default-colormap">Default difference colormap</label>
					<select id="settings-default-colormap" aria-describedby="settings-default-colormap-note">
						<option value="turbo">Turbo</option>
						<option value="magma">Magma</option>
					</select>
				</div>
				<p id="settings-default-colormap-note" class="settings-note">Used for the difference heatmap and its artifact download link.</p>
			</div>
			<div class="setting-group">
				<h2 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Metric visibility</h2>
				<div class="settings-metric-list" id="settings-visible-metrics">
					<div class="settings-metric-option">
						<input id="settings-metric-cost" type="checkbox" value="cost"/>
						<label for="settings-metric-cost">Cost</label>
					</div>
					<div class="settings-metric-option">
						<input id="settings-metric-psnr" type="checkbox" value="psnr"/>
						<label for="settings-metric-psnr">PSNR</label>
					</div>
					<div class="settings-metric-option">
						<input id="settings-metric-ssim" type="checkbox" value="ssim"/>
						<label for="settings-metric-ssim">SSIM</label>
					</div>
					<div class="settings-metric-option">
						<input id="settings-metric-cps" type="checkbox" value="cps"/>
						<label for="settings-metric-cps">Throughput (cps)</label>
					</div>
				</div>
				<p id="settings-visible-metrics-note" class="settings-note">Controls which summary metric cards are visible on job detail pages. Clearing every box restores all of them.</p>
			</div>
			<div class="settings-actions">
				<button id="settings-reset" type="button" class="btn" style="background: var(--border-color);">Reset to Defaults</button>
				<span id="settings-feedback" aria-live="polite" class="settings-note" role="status"></span>
			</div>
		</div>
		<script>
			(function () {
				const preferenceKeys = {
					autoRefresh: "mayflycirclefit.imageRefreshInterval",
					viewMode: "mayflycirclefit.viewMode",
					colormap: "mayflycirclefit.diffColormap",
					visibleMetrics: "mayflycirclefit.visibleMetrics",
				};
				const defaults = {
					autoRefresh: 0,
					viewMode: "side-by-side",
					colormap: "turbo",
					visibleMetrics: ["cost", "psnr", "ssim", "cps"],
				};
				const metricIds = ["cost", "psnr", "ssim", "cps"];
				const validViewModes = new Set([
					"reference",
					"best",
					"side-by-side",
					"difference",
					"overlay",
				]);
				const validColormaps = new Set(["turbo", "magma"]);
				const feedback = document.getElementById("settings-feedback");
				const refreshSelect = document.getElementById("settings-image-refresh");
				const modeSelect = document.getElementById("settings-default-view-mode");
				const colormapSelect = document.getElementById("settings-default-colormap");
				const metricInputs = {
					cost: document.getElementById("settings-metric-cost"),
					psnr: document.getElementById("settings-metric-psnr"),
					ssim: document.getElementById("settings-metric-ssim"),
					cps: document.getElementById("settings-metric-cps"),
				};
				const resetButton = document.getElementById("settings-reset");

				function setStatus(message) {
					if (feedback) {
						feedback.textContent = message;
					}
				}

				function readStored(key) {
					try {
						return window.localStorage.getItem(key);
					} catch (_error) {
						return null;
					}
				}

				function readVisibleMetrics() {
					const raw = readStored(preferenceKeys.visibleMetrics);
					if (!raw) {
						return defaults.visibleMetrics.slice();
					}
					try {
						const parsed = JSON.parse(raw);
						const enabled = new Set();
						for (const metric of Array.isArray(parsed) ? parsed : []) {
							if (metricIds.includes(metric)) {
								enabled.add(metric);
							}
						}
						if (enabled.size === 0) {
							return defaults.visibleMetrics.slice();
						}
						return metricIds.filter(function (metric) {
							return enabled.has(metric);
						});
					} catch (_error) {
						return defaults.visibleMetrics.slice();
					}
				}

				function loadPreferences() {
					const storedRefresh = Number.parseInt(readStored(preferenceKeys.autoRefresh), 10);
					const refresh = Number.isFinite(storedRefresh) && storedRefresh >= 0
						? storedRefresh
						: defaults.autoRefresh;
					const storedMode = readStored(preferenceKeys.viewMode);
					const mode = validViewModes.has(storedMode) ? storedMode : defaults.viewMode;
					const storedColormap = readStored(preferenceKeys.colormap);
					const colormap = validColormaps.has(storedColormap)
						? storedColormap
						: defaults.colormap;

					if (refreshSelect) {
						refreshSelect.value = String(refresh);
						if (!refreshSelect.value) {
							refreshSelect.value = String(defaults.autoRefresh);
						}
					}
					if (modeSelect) modeSelect.value = mode;
					if (colormapSelect) colormapSelect.value = colormap;

					const metrics = readVisibleMetrics();
					metricIds.forEach(function (metric) {
						const control = metricInputs[metric];
						if (control) {
							control.checked = metrics.indexOf(metric) >= 0;
						}
					});
				}

				function selectedMetrics() {
					const selected = metricIds.filter(function (metric) {
						const control = metricInputs[metric];
						return control && control.checked;
					});
					if (selected.length === 0) {
						metricIds.forEach(function (metric) {
							const control = metricInputs[metric];
							if (control) {
								control.checked = true;
							}
						});
						return defaults.visibleMetrics.slice();
					}
					return selected;
				}

				function writePreferences() {
					const parsedRefresh = refreshSelect
						? Number.parseInt(refreshSelect.value, 10)
						: defaults.autoRefresh;
					const refresh = Number.isFinite(parsedRefresh) && parsedRefresh >= 0
						? parsedRefresh
						: defaults.autoRefresh;
					const mode = modeSelect && validViewModes.has(modeSelect.value)
						? modeSelect.value
						: defaults.viewMode;
					const colormap = colormapSelect && validColormaps.has(colormapSelect.value)
						? colormapSelect.value
						: defaults.colormap;
					const visibleMetrics = selectedMetrics();
					try {
						window.localStorage.setItem(preferenceKeys.autoRefresh, String(refresh));
						window.localStorage.setItem(preferenceKeys.viewMode, mode);
						window.localStorage.setItem(preferenceKeys.colormap, colormap);
						window.localStorage.setItem(
							preferenceKeys.visibleMetrics,
							JSON.stringify(visibleMetrics),
						);
						setStatus("Saved. Open a job to see your new defaults.");
					} catch (_error) {
						setStatus("Could not save preferences. Local storage is not available.");
					}
				}

				function resetDefaults() {
					try {
						Object.values(preferenceKeys).forEach(function (key) {
							window.localStorage.removeItem(key);
						});
						loadPreferences();
						setStatus("Reset to defaults.");
					} catch (_error) {
						setStatus("Could not reset preferences. Local storage is not available.");
					}
				}

				[refreshSelect, modeSelect, colormapSelect].forEach(function (control) {
					if (control) {
						control.addEventListener("change", writePreferences);
					}
				});
				Object.values(metricInputs).forEach(function (input) {
					if (input) {
						input.addEventListener("change", writePreferences);
					}
				});
				if (resetButton) {
					resetButton.addEventListener("click", resetDefaults);
				}

				loadPreferences();
			})();
		</script>
	}
}
