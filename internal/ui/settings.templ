package ui

// SettingsPage renders the browser-local UI preference editor. Every value is
// stored in localStorage under the same keys the job detail and image viewer
// scripts read, so the page never round-trips to the server.
//
// The reads and writes belong to SettingsIsland (web/src/Settings.tsx), which
// replaces everything inside the mount point once the bundle loads. What stays
// here is the fallback, and it states the defaults rather than the first option
// in each list: the controls are inert without JavaScript, so whatever they show
// is what a reader will believe a job page uses. The <noscript> says why they
// are inert -- there is nothing on the server to store a preference in.
templ SettingsPage() {
	@Layout("Settings") {
		<div style="margin-bottom: 1.5rem;">
			<h1 style="font-size: 2rem; font-weight: 700;">Settings</h1>
			<p style="color: var(--text-muted);">Configure UI defaults for job pages and charts. Preferences are stored in this browser only and apply to every job.</p>
		</div>
		<style>
			.settings-card {
				display: grid;
				gap: 1.5rem;
			}
			.setting-group {
				display: grid;
				gap: 0.75rem;
				padding: 1rem;
				border: 1px solid var(--border-color);
				border-radius: 0.5rem;
			}
			.setting-control {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
			}
			.setting-control > label {
				min-width: min(14rem, 100%);
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			.setting-control select,
			.setting-control input {
				padding: 0.35rem 0.5rem;
				border: 1px solid var(--border-color);
				border-radius: 0.25rem;
				background: var(--control-bg);
				color: var(--text-color);
			}
			.settings-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: center;
			}
			.settings-note {
				font-size: 0.8125rem;
				color: var(--text-muted);
			}
			.settings-metric-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
				gap: 0.5rem;
			}
			.settings-metric-option {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.35rem 0.5rem;
				border: 1px solid var(--border-color);
				border-radius: 0.25rem;
			}
			.settings-metric-option label {
				font-size: 0.85rem;
				color: var(--text-color);
			}
		</style>
		<!-- Everything inside the mount point is the fallback; mounting replaces it. -->
		<div class="card settings-card" data-island="settings" data-island-label="settings">
			<noscript>
				<p class="settings-note">These preferences live in this browser's local storage, and reading or writing them needs JavaScript. With JavaScript disabled the controls below show the built-in defaults and changing one has no effect; job pages use those same defaults.</p>
			</noscript>
			<div class="setting-group">
				<h2 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Image refresh</h2>
				<div class="setting-control">
					<label for="settings-image-refresh">Auto image refresh</label>
					<select id="settings-image-refresh" aria-describedby="settings-image-refresh-note">
						<option value="0">SSE-driven (default)</option>
						<option value="1000">1 second</option>
						<option value="2000">2 seconds</option>
						<option value="5000">5 seconds</option>
						<option value="10000">10 seconds</option>
						<option value="30000">30 seconds</option>
					</select>
				</div>
				<p id="settings-image-refresh-note" class="settings-note">SSE-driven updates keep metrics and images responsive while a job runs. Pick an interval only if the event stream is blocked, for example behind a buffering proxy; active jobs then poll the status endpoint instead.</p>
			</div>
			<div class="setting-group">
				<h2 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Image defaults</h2>
				<div class="setting-control">
					<label for="settings-default-view-mode">Default image view mode</label>
					<select id="settings-default-view-mode" aria-describedby="settings-default-view-mode-note">
						<option value="reference">Reference</option>
						<option value="best">Best</option>
						<option value="side-by-side" selected>Side-by-Side</option>
						<option value="difference">Difference</option>
						<option value="overlay">Overlay</option>
					</select>
				</div>
				<p id="settings-default-view-mode-note" class="settings-note">Applies to every job page. Switching modes on a job page updates this value too.</p>
				<div class="setting-control">
					<label for="settings-default-colormap">Default difference colormap</label>
					<select id="settings-default-colormap" aria-describedby="settings-default-colormap-note">
						<option value="turbo">Turbo</option>
						<option value="magma">Magma</option>
					</select>
				</div>
				<p id="settings-default-colormap-note" class="settings-note">Used for the difference heatmap and its artifact download link.</p>
			</div>
			<div class="setting-group">
				<h2 style="font-size: 1.125rem; font-weight: 600; margin: 0;">Metric visibility</h2>
				<div class="settings-metric-list" id="settings-visible-metrics">
					<div class="settings-metric-option">
						<input id="settings-metric-cost" type="checkbox" value="cost" checked/>
						<label for="settings-metric-cost">Cost</label>
					</div>
					<div class="settings-metric-option">
						<input id="settings-metric-psnr" type="checkbox" value="psnr" checked/>
						<label for="settings-metric-psnr">PSNR</label>
					</div>
					<div class="settings-metric-option">
						<input id="settings-metric-ssim" type="checkbox" value="ssim" checked/>
						<label for="settings-metric-ssim">SSIM</label>
					</div>
					<div class="settings-metric-option">
						<input id="settings-metric-cps" type="checkbox" value="cps" checked/>
						<label for="settings-metric-cps">Throughput (cps)</label>
					</div>
				</div>
				<p id="settings-visible-metrics-note" class="settings-note">Controls which summary metric cards are visible on job detail pages. Clearing every box restores all of them.</p>
			</div>
			<div class="settings-actions">
				<button id="settings-reset" type="button" class="btn" style="background: var(--border-color);">Reset to Defaults</button>
				<span id="settings-feedback" aria-live="polite" class="settings-note" role="status"></span>
			</div>
		</div>
	}
}
