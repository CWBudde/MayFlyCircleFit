package ui

import (
	"fmt"
	"time"
	"unicode"
	"unicode/utf8"
)

// JobListItem represents a job in the list view
type JobListItem struct {
	ID          string     `json:"id"`
	State       string     `json:"state"`
	RefPath     string     `json:"refPath"`
	Mode        string     `json:"mode"`
	Circles     int        `json:"circles"`
	Iterations  int        `json:"iterations"`
	BestCost    float64    `json:"bestCost"`
	InitialCost float64    `json:"initialCost"`
	StartTime   time.Time  `json:"startTime"`
	EndTime     *time.Time `json:"endTime,omitempty"`
	Error       string     `json:"error,omitempty"`
}

// JobListPage is the bounded hydration seed for the infinitely scrolling list.
type JobListPage struct {
	Jobs       []JobListItem `json:"jobs"`
	NextCursor string        `json:"nextCursor,omitempty"`
	Total      int           `json:"total"`
}

// JobList displays the first page of jobs; the island appends later pages.
templ JobList(page JobListPage) {
	@Layout("Jobs") {
		<div data-island="job-list" data-island-label="job list">
		@templ.JSONScript("job-list-page", page)
		<div class="row-between" style="margin-bottom: 2rem;">
			<h1 style="font-size: 2rem; font-weight: 700;">
				Optimization Jobs
			</h1>
			<a href="/create" class="btn btn-primary">
				+ Create New Job
			</a>
		</div>

		if len(page.Jobs) == 0 {
			<div class="card" style="text-align: center; padding: 3rem;">
				<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin: 0 auto 1rem; color: var(--text-muted);" aria-hidden="true">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="12" y1="8" x2="12" y2="12"></line>
					<line x1="12" y1="16" x2="12.01" y2="16"></line>
				</svg>
				<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">
					No jobs yet
				</h2>
				<p style="color: var(--text-muted); margin-bottom: 1.5rem;">
					Create your first optimization job to get started.
				</p>
				<a href="/create" class="btn btn-primary">
					Create Job
				</a>
			</div>
		} else {
			<div style="display: grid; gap: 1rem;">
				for _, job := range page.Jobs {
					@JobCard(job)
				}
			</div>
		}
		</div>
	}
}

// JobCard displays a single job card
templ JobCard(job JobListItem) {
	<a href={ templ.URL(fmt.Sprintf("/jobs/%s", job.ID)) } class="card-link">
		<div class="card" style="cursor: pointer;">
		<div class="row-between row-between-top" style="margin-bottom: 1rem;">
			<div style="flex: 1;">
				<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
					<h3 style="font-size: 1.125rem; font-weight: 600; font-family: monospace;">
						{ job.ID[:8] }...
					</h3>
					@StateBadge(job.State)
				</div>
				<!-- The abbreviated visible labels are hidden from assistive tech in favour of spelled-out ones. -->
				<div class="meta-row" style="color: var(--text-muted); font-size: 0.875rem;">
					<span>
						<span class="sr-only">Optimization mode</span>
						<strong aria-hidden="true">Mode:</strong> { job.Mode }
					</span>
					<span>
						<span class="sr-only">Circle count</span>
						<strong aria-hidden="true">Circles:</strong> { fmt.Sprintf("%d", job.Circles) }
					</span>
					<span>
						<span class="sr-only">Iteration count</span>
						<strong aria-hidden="true">Iterations:</strong> { fmt.Sprintf("%d", job.Iterations) }
					</span>
				</div>
			</div>
			<div class="row-end">
				if job.State == "completed" || job.State == "running" {
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Cost
					</div>
					<div style="font-size: 1.25rem; font-weight: 600;">
						{ fmt.Sprintf("%.2f", job.BestCost) }
					</div>
					if job.InitialCost > 0 {
						<div style="font-size: 0.75rem; color: var(--success-text-strong);">
							{ fmt.Sprintf("%.1f%% improvement", (1-job.BestCost/job.InitialCost)*100) }
						</div>
					}
				}
			</div>
		</div>

		<div class="row-between" style="padding-top: 1rem; border-top: 1px solid var(--border-color); font-size: 0.875rem; color: var(--text-muted);">
			<div style="overflow-wrap: anywhere;">
				<strong>Reference:</strong> { job.RefPath }
			</div>
			<div>
				{ formatTime(job.StartTime) }
			</div>
		</div>

		if job.Error != "" {
			<div style="margin-top: 0.75rem; padding: 0.75rem; background-color: var(--error-bg); border-radius: 0.375rem; color: var(--error-text); font-size: 0.875rem;">
				<strong>Error:</strong> { job.Error }
			</div>
		}
		</div>
	</a>
}

// StateBadge renders one state as a badge. It is the only state badge in the
// UI: job states, schedule states and stage states share a vocabulary (see
// store.ScheduleState), so they share a rendering, and the schedule-only
// ScheduleStateBadge it replaced is gone.
//
// stateClass, stateLabel and stateBadgeStyle in web/src/format.ts are the
// TypeScript mirror an island swaps in, and
// web/src/state-badge-parity.json is the contract both sides are tested
// against — changing a mapping here without changing it there fails on both
// sides at once.
//
// The three axes the five superseded implementations disagreed on, decided
// once:
//
//   - Fallthrough class. A state neither side enumerates gets no modifier —
//     `badge` alone, plus the neutral chip colors — never `badge-info`.
//     badge-info is the color of a job that is pending or running, and painting
//     an unrecognized value with it claims the UI understands a state it does
//     not.
//   - Label casing. The state with its first letter capitalized, so a badge
//     never prints a bare lowercase identifier beside capitalized ones. The
//     rule applies to unknown states too ("nonsense" reads "Nonsense"); only an
//     empty state has no word of its own, and it reads "Unknown" rather than
//     leaving an empty chip the way this badge used to.
//   - skipped. A first-class state, not a fallthrough: it is a planned stage
//     the campaign's policy declined to run, which is neither a failure nor a
//     run. It carries the neutral chip so it reads as an absence of a result,
//     and the label says which absence.
templ StateBadge(state string) {
	{{ style := stateBadgeStyle(state) }}
	if style == "" {
		<span class={ stateBadgeClass(state) }>{ stateBadgeLabel(state) }</span>
	} else {
		<span class={ stateBadgeClass(state) } style={ style }>{ stateBadgeLabel(state) }</span>
	}
}

// stateBadgeClass is the badge's complete class attribute, the neutral
// fallthrough included. It is the whole attribute rather than the modifier
// alone because that is the string the TypeScript stateClass returns, and a
// parity test that compares halves of an attribute proves less than one that
// compares the attribute.
func stateBadgeClass(state string) string {
	switch state {
	case "pending", "running":
		return "badge badge-info"
	case "completed":
		return "badge badge-success"
	case "failed":
		return "badge badge-error"
	case "paused", "cancelled":
		return "badge badge-warning"
	default:
		return "badge"
	}
}

// stateBadgeLabel capitalizes the state, and names the empty one.
func stateBadgeLabel(state string) string {
	if state == "" {
		return "Unknown"
	}

	first, width := utf8.DecodeRuneInString(state)

	return string(unicode.ToUpper(first)) + state[width:]
}

// stateBadgeStyle carries the two decorations that have no class of their own:
// the running badge's pulse, which says the row is still moving, and the
// neutral chip that skipped and unrecognized states wear in place of a color.
// An empty return means the badge is written without a style attribute.
func stateBadgeStyle(state string) string {
	switch state {
	case "running":
		return "animation: pulse 2s ease-in-out infinite;"
	case "pending", "completed", "failed", "paused", "cancelled":
		return ""
	default:
		return "background-color: var(--border-color); color: var(--text-color);"
	}
}

// Helper function to format time
func formatTime(t time.Time) string {
	now := time.Now()
	diff := now.Sub(t)

	if diff < time.Minute {
		return "just now"
	} else if diff < time.Hour {
		mins := int(diff.Minutes())
		if mins == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", mins)
	} else if diff < 24*time.Hour {
		hours := int(diff.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	} else if diff < 48*time.Hour {
		return "yesterday"
	} else {
		return t.Format("Jan 2, 2006")
	}
}
