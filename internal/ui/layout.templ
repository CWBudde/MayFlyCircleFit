package ui

// Base layout component with HTML structure, minimal CSS, and navigation
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="MayFlyCircleFit - High-performance circle fitting optimization"/>
			<title>{ title } - MayFlyCircleFit</title>
			<script>
				(() => {
					try {
						const theme = localStorage.getItem("mayflycirclefit.theme");
						if (theme === "light" || theme === "dark") {
							document.documentElement.dataset.theme = theme;
						}
					} catch (_) {
						// Storage can be unavailable in privacy-restricted browser contexts.
					}
				})();
			</script>
			<style>
				/* Reset and base styles */
				* {
					margin: 0;
					padding: 0;
					box-sizing: border-box;
				}

				:root {
					color-scheme: light;
					--primary-color: #2563eb;
					--primary-hover: #1d4ed8;
					--success-color: #10b981;
					--error-color: #ef4444;
					--warning-color: #f59e0b;
					--bg-color: #f9fafb;
					--surface-color: #ffffff;
					--text-color: #111827;
					--text-muted: #6b7280;
					--border-color: #e5e7eb;
					--grid-color: #f3f4f6;
					--control-bg: #ffffff;
					--secondary-hover: #d1d5db;
					--success-bg: #d1fae5;
					--success-text: #065f46;
					--error-bg: #fee2e2;
					--error-border: #fca5a5;
					--error-text: #991b1b;
					--warning-bg: #fef3c7;
					--warning-text: #92400e;
					--info-bg: #dbeafe;
					--info-text: #1e40af;
					--info-text-strong: #1e3a8a;
					--checker-a: #f9fafb;
					--checker-b: #ffffff;
					--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
					--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
				}

				:root[data-theme="dark"] {
					color-scheme: dark;
					--primary-color: #60a5fa;
					--primary-hover: #93c5fd;
					--success-color: #34d399;
					--error-color: #f87171;
					--warning-color: #fbbf24;
					--bg-color: #0f172a;
					--surface-color: #111827;
					--text-color: #f3f4f6;
					--text-muted: #9ca3af;
					--border-color: #334155;
					--grid-color: #1f2937;
					--control-bg: #0f172a;
					--secondary-hover: #475569;
					--success-bg: #052e16;
					--success-text: #a7f3d0;
					--error-bg: #451a1a;
					--error-border: #7f1d1d;
					--error-text: #fecaca;
					--warning-bg: #451a03;
					--warning-text: #fde68a;
					--info-bg: #172554;
					--info-text: #bfdbfe;
					--info-text-strong: #dbeafe;
					--checker-a: #334155;
					--checker-b: #1f2937;
					--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.45), 0 1px 2px -1px rgba(0, 0, 0, 0.4);
					--shadow-md: 0 6px 12px -2px rgba(0, 0, 0, 0.5);
				}

				@media (prefers-color-scheme: dark) {
					:root:not([data-theme]) {
						color-scheme: dark;
						--primary-color: #60a5fa;
						--primary-hover: #93c5fd;
						--success-color: #34d399;
						--error-color: #f87171;
						--warning-color: #fbbf24;
						--bg-color: #0f172a;
						--surface-color: #111827;
						--text-color: #f3f4f6;
						--text-muted: #9ca3af;
						--border-color: #334155;
						--grid-color: #1f2937;
						--control-bg: #0f172a;
						--secondary-hover: #475569;
						--success-bg: #052e16;
						--success-text: #a7f3d0;
						--error-bg: #451a1a;
						--error-border: #7f1d1d;
						--error-text: #fecaca;
						--warning-bg: #451a03;
						--warning-text: #fde68a;
						--info-bg: #172554;
						--info-text: #bfdbfe;
						--info-text-strong: #dbeafe;
						--checker-a: #334155;
						--checker-b: #1f2937;
						--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.45), 0 1px 2px -1px rgba(0, 0, 0, 0.4);
						--shadow-md: 0 6px 12px -2px rgba(0, 0, 0, 0.5);
					}
				}

				body {
					font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
					background-color: var(--bg-color);
					color: var(--text-color);
					line-height: 1.6;
					min-height: 100vh;
					display: flex;
					flex-direction: column;
				}

				/* Navigation */
				nav {
					background-color: var(--surface-color);
					border-bottom: 1px solid var(--border-color);
					box-shadow: var(--shadow);
				}

				.nav-container {
					max-width: 1200px;
					margin: 0 auto;
					padding: 1rem 2rem;
					display: flex;
					align-items: center;
					justify-content: space-between;
				}

				.nav-brand {
					font-size: 1.5rem;
					font-weight: 700;
					color: var(--primary-color);
					text-decoration: none;
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}

				.nav-brand:hover {
					color: var(--primary-hover);
				}

				.nav-links {
					display: flex;
					gap: 2rem;
					list-style: none;
				}

				.nav-actions {
					display: flex;
					align-items: center;
					gap: 1.5rem;
				}

				.nav-links a {
					color: var(--text-color);
					text-decoration: none;
					font-weight: 500;
					transition: color 0.2s;
				}

				.nav-links a:hover {
					color: var(--primary-color);
				}

				.theme-switch {
					display: inline-flex;
					padding: 0.2rem;
					border: 1px solid var(--border-color);
					border-radius: 0.5rem;
					background-color: var(--bg-color);
				}

				.theme-option {
					display: inline-grid;
					place-items: center;
					width: 2rem;
					height: 2rem;
					padding: 0;
					border: 0;
					border-radius: 0.35rem;
					background: transparent;
					color: var(--text-muted);
					cursor: pointer;
				}

				.theme-option:hover {
					color: var(--text-color);
				}

				.theme-option[aria-pressed="true"] {
					background-color: var(--surface-color);
					box-shadow: var(--shadow);
					color: var(--primary-color);
				}

				.theme-option:focus-visible {
					outline: 2px solid var(--primary-color);
					outline-offset: 1px;
				}

				/* Main content */
				main {
					flex: 1;
					max-width: 1200px;
					margin: 0 auto;
					padding: 2rem;
					width: 100%;
				}

				/* Utility classes */
				.container {
					max-width: 1200px;
					margin: 0 auto;
					padding: 0 1rem;
				}

				.card {
					background-color: var(--surface-color);
					border-radius: 0.5rem;
					box-shadow: var(--shadow);
					padding: 1.5rem;
					margin-bottom: 1.5rem;
				}

				.btn {
					display: inline-block;
					padding: 0.5rem 1rem;
					border-radius: 0.375rem;
					font-weight: 500;
					text-decoration: none;
					color: var(--text-color);
					cursor: pointer;
					border: none;
					transition: all 0.2s;
				}

				.btn-primary {
					background-color: var(--primary-color);
					color: white;
				}

				.btn-primary:hover {
					background-color: var(--primary-hover);
				}

				input, select, textarea {
					background-color: var(--control-bg);
					color: var(--text-color);
				}

				.badge {
					display: inline-block;
					padding: 0.25rem 0.75rem;
					border-radius: 9999px;
					font-size: 0.875rem;
					font-weight: 500;
				}

				.badge-success {
					background-color: var(--success-bg);
					color: var(--success-text);
				}

				.badge-error {
					background-color: var(--error-bg);
					color: var(--error-text);
				}

				.badge-warning {
					background-color: var(--warning-bg);
					color: var(--warning-text);
				}

				.badge-info {
					background-color: var(--info-bg);
					color: var(--info-text);
				}

				/* Animations */
				@keyframes pulse {
					0%, 100% {
						opacity: 1;
					}
					50% {
						opacity: 0.7;
					}
				}

				@keyframes spin {
					0% {
						transform: rotate(0deg);
					}
					100% {
						transform: rotate(360deg);
					}
				}

				/* Spinner */
				.spinner {
					border: 3px solid var(--border-color);
					border-top: 3px solid var(--primary-color);
					border-radius: 50%;
					width: 40px;
					height: 40px;
					animation: spin 1s linear infinite;
					margin: 0 auto;
				}

				/* Fade transitions */
				@keyframes fadeIn {
					from {
						opacity: 0;
					}
					to {
						opacity: 1;
					}
				}

				.fade-in {
					animation: fadeIn 0.3s ease-in;
				}

				/* Responsive */
				@media (max-width: 768px) {
					.nav-container {
						flex-direction: column;
						gap: 1rem;
					}

					.nav-links {
						gap: 1rem;
					}

					.nav-actions {
						flex-wrap: wrap;
						justify-content: center;
						gap: 1rem;
					}

					main {
						padding: 1rem;
					}
				}
			</style>
		</head>
		<body>
			<nav>
				<div class="nav-container">
					<a href="/" class="nav-brand">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"></circle>
							<circle cx="12" cy="12" r="6"></circle>
							<circle cx="12" cy="12" r="2"></circle>
						</svg>
						MayFlyCircleFit
					</a>
					<div class="nav-actions">
						<ul class="nav-links">
							<li><a href="/">Dashboard</a></li>
							<li><a href="/jobs">Jobs</a></li>
							<li><a href="/schedules">Campaigns</a></li>
							<li><a href="/create">Create Job</a></li>
							<li><a href="/settings">Settings</a></li>
							<li><a href="https://github.com/CWBudde/MayFlyCircleFit" target="_blank">GitHub</a></li>
						</ul>
						<div class="theme-switch" role="group" aria-label="Color theme">
							<button class="theme-option" type="button" data-theme-value="auto" aria-label="Use system theme" aria-pressed="true" title="Auto theme">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
							</button>
							<button class="theme-option" type="button" data-theme-value="light" aria-label="Use light theme" aria-pressed="false" title="Light theme">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
							</button>
							<button class="theme-option" type="button" data-theme-value="dark" aria-label="Use dark theme" aria-pressed="false" title="Dark theme">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
							</button>
						</div>
					</div>
				</div>
			</nav>
			<main>
				{ children... }
			</main>
			<script>
				(() => {
					const storageKey = "mayflycirclefit.theme";
					const buttons = document.querySelectorAll("[data-theme-value]");
					const selectedTheme = () => document.documentElement.dataset.theme || "auto";
					const updateButtons = () => {
						const selected = selectedTheme();
						buttons.forEach((button) => {
							button.setAttribute("aria-pressed", String(button.dataset.themeValue === selected));
						});
					};
					const setTheme = (theme) => {
						if (theme === "auto") {
							delete document.documentElement.dataset.theme;
						} else {
							document.documentElement.dataset.theme = theme;
						}
						try {
							if (theme === "auto") {
								localStorage.removeItem(storageKey);
							} else {
								localStorage.setItem(storageKey, theme);
							}
						} catch (_) {
							// The theme still applies for this page when storage is unavailable.
						}
						updateButtons();
					};
					buttons.forEach((button) => {
						button.addEventListener("click", () => setTheme(button.dataset.themeValue));
					});
					updateButtons();
				})();
			</script>
		</body>
	</html>
}

// IslandBundle links the React island bundle. Only pages that actually render
// a data-island element should call it: the bundle is large, and on a page
// with no island it would download and parse just to run an empty query.
//
// The bundle is committed and embedded, so this binary serves it rather than
// fetching it from a network the host may not have. Module scripts are
// deferred, and every island server-renders its content first, so loading the
// script from the end of the body costs the page nothing.
templ IslandBundle() {
	<script type="module" src={ BundleURL() }></script>
}
