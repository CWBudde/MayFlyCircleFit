package ui

// lightThemeTokens is the default palette. Like darkThemeTokens it is a
// const rather than literal CSS because the preload script below emits one
// palette or the other as a stylesheet, and both spellings have to stay the
// same values.
const lightThemeTokens = `
		color-scheme: light;
		--primary-color: #2563eb;
		--primary-hover: #1d4ed8;
		--success-color: #10b981;
		--success-text-strong: #047857;
		--on-primary: #ffffff;
		--danger-bg: #dc2626;
		--on-danger: #ffffff;
		--warning-btn-bg: #f59e0b;
		--on-warning: #451a03;
		--error-color: #ef4444;
		--warning-color: #f59e0b;
		--bg-color: #f9fafb;
		--surface-color: #ffffff;
		--text-color: #111827;
		--text-muted: #6b7280;
		--border-color: #e5e7eb;
		--grid-color: #f3f4f6;
		--control-bg: #ffffff;
		--secondary-hover: #d1d5db;
		--btn-bg: #e5e7eb;
		--success-bg: #d1fae5;
		--success-text: #065f46;
		--error-bg: #fee2e2;
		--error-border: #fca5a5;
		--error-text: #991b1b;
		--warning-bg: #fef3c7;
		--warning-text: #92400e;
		--info-bg: #dbeafe;
		--info-text: #1e40af;
		--info-text-strong: #1e3a8a;
		--checker-a: #f9fafb;
		--checker-b: #ffffff;
		--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
		--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
`

// darkThemeTokens is the dark palette. It is declared once here and rendered
// into both dark selectors below, because plain CSS cannot share a single
// declaration block between a media-conditional selector and an unconditional
// one.
const darkThemeTokens = `
		color-scheme: dark;
		--primary-color: #60a5fa;
		--primary-hover: #93c5fd;
		--success-color: #34d399;
		--success-text-strong: #34d399;
		--on-primary: #0b1220;
		--danger-bg: #f87171;
		--on-danger: #450a0a;
		--warning-btn-bg: #fbbf24;
		--on-warning: #451a03;
		--error-color: #f87171;
		--warning-color: #fbbf24;
		--bg-color: #0f172a;
		--surface-color: #111827;
		--text-color: #f3f4f6;
		--text-muted: #9ca3af;
		--border-color: #334155;
		--grid-color: #1f2937;
		--control-bg: #0f172a;
		--secondary-hover: #475569;
		--btn-bg: #334155;
		--success-bg: #052e16;
		--success-text: #a7f3d0;
		--error-bg: #451a1a;
		--error-border: #7f1d1d;
		--error-text: #fecaca;
		--warning-bg: #451a03;
		--warning-text: #fde68a;
		--info-bg: #172554;
		--info-text: #bfdbfe;
		--info-text-strong: #dbeafe;
		--checker-a: #334155;
		--checker-b: #1f2937;
		--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.45), 0 1px 2px -1px rgba(0, 0, 0, 0.4);
		--shadow-md: 0 6px 12px -2px rgba(0, 0, 0, 0.5);
`

// themeStyles carries every :root declaration in the document, in one
// stylesheet, deliberately.
//
// Splitting them across sheets tripped a WebKit style-caching bug: with the
// light palette in one <style> and the dark overrides in another, the root
// element resolved the right tokens but nothing beneath it inherited them at
// all, so Safari rendered the dark theme as black text on the dark surface --
// 1.17:1 against a 4.5:1 threshold. Disabling any one sheet forced a
// recalculation and the values appeared, which is what identified it as a
// caching problem rather than a cascade one. Keep :root declarations here and
// nowhere else.
const themeStyles = `<style>
	:root {` + lightThemeTokens + `	}

	/* The root carries the background as well as body. With only body painted,
	   the background propagates to the canvas and WebKit then reports body's
	   own background as transparent, so anything walking the tree for an
	   effective background -- an accessibility checker included -- falls back
	   to assuming white and reads every light-on-dark pairing as a failure. */
	:root {
		background-color: var(--bg-color);
	}

	:root[data-theme="dark"] {` + darkThemeTokens + `	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme]) {` + darkThemeTokens + `		}
	}
</style>`

// themePreloadScript owns the theme, from before the first paint onward.
//
// It applies a palette by swapping the text of one stylesheet, and never sets an
// attribute on <html>. Mutating the root element leaves WebKit unable to inherit
// custom properties into elements parsed before the mutation: the root keeps the
// right tokens and everything beneath it resolves none at all, so Safari
// rendered the dark theme as black text on the dark surface -- measured at
// 1.17:1 against a 4.5:1 threshold. It looked survivable on the dashboard and
// job pages only because a React island replaces their markup with fresh
// elements, which do inherit; the pages with no island -- create, and settings
// until it became one -- stayed unreadable.
//
// The override selector is :root:root, and the doubled pseudo-class is load
// bearing. The system-preference rule is :root:not([data-theme]), which computes
// to (0,2,0); a bare :root is (0,1,0) and loses to it however late it appears,
// so on an OS that prefers dark, choosing Light left the dark tokens active
// while the Light button reported itself pressed. Doubling matches (0,2,0), and
// this stylesheet is appended while <head> is still being parsed -- after
// themeStyles, which is emitted just above the script -- so it wins on source
// order. "auto" is simply the absence of this stylesheet.
const themePreloadScript = `<script>
	(() => {
		const tokens = {
			light: ` + "`" + lightThemeTokens + "`" + `,
			dark: ` + "`" + darkThemeTokens + "`" + `,
		};
		const storageKey = "mayflycirclefit.theme";
		const apply = (theme) => {
			const existing = document.getElementById("theme-override");
			if (theme !== "light" && theme !== "dark") {
				if (existing) existing.remove();
				return;
			}
			const style = existing || document.createElement("style");
			style.id = "theme-override";
			style.textContent = ":root:root{" + tokens[theme] + "}";
			if (!existing) document.head.appendChild(style);
		};
		const selected = () => {
			try {
				const stored = localStorage.getItem(storageKey);
				return stored === "light" || stored === "dark" ? stored : "auto";
			} catch (_) {
				// Storage can be unavailable in privacy-restricted contexts.
				return "auto";
			}
		};
		apply(selected());
		window.mayflyTheme = { apply, selected, storageKey };
	})();
</script>`

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="MayFlyCircleFit - High-performance circle fitting optimization"/>
			<title>{ title } - MayFlyCircleFit</title>
			<style>
				/* Reset and base styles */
				* {
					margin: 0;
					padding: 0;
					box-sizing: border-box;
				}


				body {
					font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
					background-color: var(--bg-color);
					color: var(--text-color);
					line-height: 1.6;
					min-height: 100vh;
					display: flex;
					flex-direction: column;
				}

				/* Navigation */
				nav {
					background-color: var(--surface-color);
					border-bottom: 1px solid var(--border-color);
					box-shadow: var(--shadow);
				}

				.nav-container {
					max-width: 1200px;
					margin: 0 auto;
					padding: 1rem 2rem;
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					justify-content: space-between;
					gap: 0.75rem;
				}

				.nav-brand {
					font-size: 1.5rem;
					font-weight: 700;
					color: var(--primary-color);
					text-decoration: none;
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}

				.nav-brand:hover {
					color: var(--primary-hover);
				}

				.nav-links {
					display: flex;
					flex-wrap: wrap;
					gap: 2rem;
					list-style: none;
				}

				.nav-actions {
					display: flex;
					align-items: center;
					gap: 1.5rem;
				}

				.nav-links a {
					color: var(--text-color);
					text-decoration: none;
					font-weight: 500;
					transition: color 0.2s;
					/* An inline anchor is only as tall as its text -- 19px on the
					   iPhone profile, under the 24px WCAG 2.2 asks of a target and
					   well under what a thumb hits reliably. The padding is vertical
					   only, so the row's 2rem gap still sets the spacing. */
					display: inline-block;
					padding: 0.375rem 0;
				}

				.nav-links a:hover {
					color: var(--primary-color);
				}

				.theme-switch {
					display: inline-flex;
					padding: 0.2rem;
					border: 1px solid var(--border-color);
					border-radius: 0.5rem;
					background-color: var(--bg-color);
				}

				.theme-option {
					display: inline-grid;
					place-items: center;
					width: 2rem;
					height: 2rem;
					padding: 0;
					border: 0;
					border-radius: 0.35rem;
					background: transparent;
					color: var(--text-muted);
					cursor: pointer;
				}

				.theme-option:hover {
					color: var(--text-color);
				}

				.theme-option[aria-pressed="true"] {
					background-color: var(--surface-color);
					box-shadow: var(--shadow);
					color: var(--primary-color);
				}

				.theme-option:focus-visible {
					outline: 2px solid var(--primary-color);
					outline-offset: 1px;
				}

				/* Main content */
				main {
					flex: 1;
					max-width: 1200px;
					margin: 0 auto;
					padding: 2rem;
					width: 100%;
				}

				/* Utility classes */
				.container {
					max-width: 1200px;
					margin: 0 auto;
					padding: 0 1rem;
				}

				.card {
					background-color: var(--surface-color);
					border-radius: 0.5rem;
					box-shadow: var(--shadow);
					padding: 1.5rem;
					margin-bottom: 1.5rem;
				}

				.btn {
					display: inline-block;
					padding: 0.5rem 1rem;
					border-radius: 0.375rem;
					font-weight: 500;
					text-decoration: none;
					/* An explicit surface, not the UA button default. WebKit's
					   default is #c0c0c0 regardless of color-scheme, so a plain
					   .btn on the dark palette was --text-color on silver:
					   1.65:1, and that is what Safari actually rendered. */
					background-color: var(--btn-bg);
					color: var(--text-color);
					cursor: pointer;
					border: none;
					transition: all 0.2s;
				}

				.btn-primary {
					background-color: var(--primary-color);
					color: var(--on-primary);
				}

				.btn-primary:hover {
					background-color: var(--primary-hover);
				}

				/* Destructive and cautionary buttons. Callers used to set the
				   accent as an inline background and keep the theme's ordinary
				   foreground, which inverted in dark mode: white on #f87171 is
				   2.3:1 and --text-color on #fbbf24 is 1.5:1. Pairing every
				   accent background with its own foreground token fixes all of
				   them in one place. */
				.btn-danger {
					background-color: var(--danger-bg);
					color: var(--on-danger);
				}

				.btn-warning {
					background-color: var(--warning-btn-bg);
					color: var(--on-warning);
				}

				/* One focus ring for the whole UI. A plain outline in the
				   primary color disappears on a primary button, so the ring is
				   two-tone: a surface-colored spacer first, then the accent.
				   That reads on every background in both themes. */
				a:focus-visible,
				button:focus-visible,
				input:focus-visible,
				select:focus-visible,
				textarea:focus-visible,
				summary:focus-visible,
				[tabindex]:focus-visible {
					outline: 2px solid var(--primary-color);
					outline-offset: 2px;
				}

				.btn:focus-visible {
					outline: none;
					box-shadow: 0 0 0 2px var(--surface-color), 0 0 0 4px var(--primary-color);
				}

				/* Visually hidden but kept in the accessibility tree. Replaces
				   the clip-rect blocks image_viewer.templ and
				   CampaignCostChart.tsx each used to hand-roll. */
				.sr-only {
					position: absolute;
					width: 1px;
					height: 1px;
					margin: -1px;
					padding: 0;
					overflow: hidden;
					clip: rect(0 0 0 0);
					white-space: nowrap;
					border: 0;
				}

				.skip-link {
					position: absolute;
					left: -9999px;
					top: 0;
					z-index: 100;
					padding: 0.75rem 1rem;
					background-color: var(--surface-color);
					color: var(--text-color);
					border: 1px solid var(--border-color);
					border-radius: 0 0 0.375rem 0;
					text-decoration: none;
					font-weight: 600;
				}

				.skip-link:focus {
					left: 0;
				}

				main:focus {
					outline: none;
				}

				/* Wrap helpers. Every one of these replaces a
				   `display:flex; justify-content:space-between` row that had no
				   flex-wrap and so collided with itself on a narrow screen. */
				.row-between {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					justify-content: space-between;
					gap: 0.75rem 1rem;
				}

				.row-between-top {
					align-items: flex-start;
				}

				.meta-row {
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem 1.5rem;
				}

				.action-row {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					justify-content: flex-end;
					gap: 0.5rem;
				}

				.row-end {
					text-align: right;
				}

				/* A flex item defaults to min-width:auto, which refuses to
				   shrink below its own min-content. A reference path or a job
				   id is one unbroken token, so without these two rules that
				   token sets a floor on the card's width and the whole page
				   scrolls sideways on a phone -- the card grows, not the text. */
				.row-between > *,
				.meta-row > *,
				.action-row > * {
					min-width: 0;
				}

				.card {
					overflow-wrap: anywhere;
				}

				/* A wide table stays a table: these are dense numeric columns
				   people scan vertically, and one of them is sortable. Scrolling
				   is kept, but the container is made a named, focusable region
				   so a keyboard can actually reach the columns off-screen. */
				.table-scroll {
					overflow-x: auto;
					-webkit-overflow-scrolling: touch;
				}

				.table-scroll table {
					font-variant-numeric: tabular-nums;
				}

				/* Card hover lift as CSS rather than inline onmouseover JS, so
				   it also responds to keyboard focus reaching the card's link. */
				.card-link {
					display: block;
					color: inherit;
					text-decoration: none;
				}

				.card-link .card {
					transition: transform 0.2s, box-shadow 0.2s;
				}

				.card-link:hover .card,
				.card-link:focus-visible .card {
					transform: translateY(-2px);
					box-shadow: var(--shadow-md);
				}

				.card-link:focus-visible {
					outline: none;
				}

				.card-link:focus-visible .card {
					outline: 2px solid var(--primary-color);
					outline-offset: 2px;
				}

				input, select, textarea {
					background-color: var(--control-bg);
					/* inherit, not var(--text-color): WebKit does not inherit
					   custom properties into form controls, so the var resolved
					   to nothing there and the whole declaration was dropped,
					   leaving a select rendering black on #0f172a. Ordinary
					   inheritance reaches the control on every engine. */
					color: inherit;
					/* WebKit paints form-control text with its own control
					   color and ignores `color` here, so a select on the dark
					   palette rendered black on #0f172a -- 1.17:1, and
					   unreadable in Safari's dark mode. -webkit-text-fill-color
					   is the property WebKit does honor; other engines ignore
					   it and keep using `color` above. */
					-webkit-text-fill-color: currentColor;
				}

				.badge {
					display: inline-block;
					padding: 0.25rem 0.75rem;
					border-radius: 9999px;
					font-size: 0.875rem;
					font-weight: 500;
				}

				.badge-success {
					background-color: var(--success-bg);
					color: var(--success-text);
				}

				.badge-error {
					background-color: var(--error-bg);
					color: var(--error-text);
				}

				.badge-warning {
					background-color: var(--warning-bg);
					color: var(--warning-text);
				}

				.badge-info {
					background-color: var(--info-bg);
					color: var(--info-text);
				}

				/* Animations */
				@keyframes pulse {
					0%, 100% {
						opacity: 1;
					}
					50% {
						opacity: 0.7;
					}
				}

				@keyframes spin {
					0% {
						transform: rotate(0deg);
					}
					100% {
						transform: rotate(360deg);
					}
				}

				/* Spinner */
				.spinner {
					border: 3px solid var(--border-color);
					border-top: 3px solid var(--primary-color);
					border-radius: 50%;
					width: 40px;
					height: 40px;
					animation: spin 1s linear infinite;
					margin: 0 auto;
				}

				/* Fade transitions */
				@keyframes fadeIn {
					from {
						opacity: 0;
					}
					to {
						opacity: 1;
					}
				}

				.fade-in {
					animation: fadeIn 0.3s ease-in;
				}


				/* Image-viewer vocabulary.
				   This lives in the layout rather than in image_viewer.templ
				   because the campaign detail page renders that component
				   INSIDE the `campaign-detail` island root (schedule.templ),
				   and mounting an island replaces the root's children -- which
				   removed the component's own <style> block along with them.
				   The React port (web/src/ImageViewer.tsx) therefore rendered
				   with no view-mode, frame or focus styling at all. Styles the
				   islands share have to live outside every island root. */
				.view-mode-selector {
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem;
					border: 0;
				}
				.view-mode-selector legend {
					position: absolute;
					width: 1px;
					height: 1px;
					padding: 0;
					margin: -1px;
					overflow: hidden;
					clip: rect(0, 0, 0, 0);
					white-space: nowrap;
					border: 0;
				}
				.view-mode-option {
					position: relative;
				}
				.view-mode-option input {
					position: absolute;
					opacity: 0;
					pointer-events: none;
				}
				.view-mode-option label {
					display: inline-flex;
					align-items: center;
					gap: 0.4rem;
					padding: 0.4rem 0.7rem;
					border: 1px solid var(--border-color);
					border-radius: 0.375rem;
					color: var(--text-muted);
					font-size: 0.875rem;
					font-weight: 500;
					cursor: pointer;
					transition: all 0.2s;
				}
				.view-mode-option input:checked + label {
					border-color: var(--primary-color);
					background-color: var(--info-bg);
					color: var(--info-text);
				}
				.view-mode-option input:focus-visible + label {
					outline: 2px solid var(--primary-color);
					outline-offset: 2px;
				}
				.view-mode-shortcut {
					font-family: monospace;
					font-size: 0.75rem;
					opacity: 0.75;
				}
				.image-view-panels {
					display: grid;
					grid-template-columns: minmax(0, 1fr);
					gap: 2rem;
				}
				.image-view-panel {
					display: none;
					min-width: 0;
				}
				.image-viewer[data-view-mode="reference"] [data-view-panel="reference"],
				.image-viewer[data-view-mode="best"] [data-view-panel="best"],
				.image-viewer[data-view-mode="overlay"] [data-view-panel="overlay"],
				.image-viewer[data-view-mode="difference"] [data-view-panel="difference"],
				.image-viewer[data-view-mode="side-by-side"] [data-view-panel="reference"],
				.image-viewer[data-view-mode="side-by-side"] [data-view-panel="best"] {
					display: block;
				}
				/* auto-fit rather than a fixed pair, so side-by-side collapses to
				   one column whenever two panes no longer fit. min() keeps the
				   track from ever exceeding the container, which is what makes a
				   320px viewport safe. */
				.image-viewer[data-view-mode="side-by-side"] .image-view-panels {
					grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
				}
				.image-frame {
					position: relative;
					border: 1px solid var(--border-color);
					border-radius: 0.375rem;
					overflow: hidden;
					background: repeating-conic-gradient(var(--checker-a) 0% 25%, var(--checker-b) 0% 50%) 50% / 20px 20px;
				}
				.image-frame-difference {
					background: #000000;
				}
				.image-frame-overlay {
					min-height: 6rem;
				}
				.overlay-best-layer {
					position: absolute;
					inset: 0;
				}
				.overlay-best-layer img {
					width: 100%;
					height: 100%;
					object-fit: fill;
					transition: none;
				}
				.image-frame-overlay .image-state {
					position: absolute;
					top: 50%;
					left: 50%;
					transform: translate(-50%, -50%);
					padding: 0.5rem 0.75rem;
					border-radius: 0.375rem;
					background-color: var(--surface-color);
				}
				.overlay-heading {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					justify-content: space-between;
					gap: 0.75rem;
					margin-bottom: 0.75rem;
				}
				.overlay-opacity-control {
					display: inline-flex;
					align-items: center;
					gap: 0.5rem;
					font-size: 0.875rem;
					color: var(--text-muted);
				}
				.overlay-opacity-control input[type="range"] {
					width: 10rem;
					accent-color: var(--primary-color);
				}
				.overlay-opacity-value {
					min-width: 3rem;
					font-family: monospace;
					font-size: 0.8125rem;
					text-align: right;
				}
				.image-frame img {
					width: 100%;
					height: auto;
					display: block;
					transition: opacity 0.3s ease;
				}
				.image-state {
					display: none;
					padding: 2rem;
					text-align: center;
					color: var(--text-muted);
				}
				.image-loading {
					position: absolute;
					top: 50%;
					left: 50%;
					transform: translate(-50%, -50%);
				}
				.image-metadata {
					display: flex;
					flex-wrap: wrap;
					gap: 0.75rem;
					margin-top: 0.5rem;
					font-size: 0.75rem;
					color: var(--text-muted);
				}
				.heatmap-heading {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					justify-content: space-between;
					gap: 0.75rem;
					margin-bottom: 0.75rem;
				}
				.heatmap-colormap-control {
					display: inline-flex;
					align-items: center;
					gap: 0.5rem;
					font-size: 0.875rem;
					color: var(--text-muted);
				}
				.heatmap-colormap-control select {
					padding: 0.3rem 0.5rem;
					border: 1px solid var(--border-color);
					border-radius: 0.375rem;
					background-color: var(--surface-color);
					color: var(--text-color);
				}
				.heatmap-legend {
					display: grid;
					grid-template-columns: auto minmax(min(120px, 100%), 1fr) auto;
					align-items: center;
					gap: 0.5rem;
					margin-top: 0.75rem;
					font-size: 0.75rem;
					color: var(--text-muted);
				}
				.heatmap-legend-gradient {
					height: 0.75rem;
					border: 1px solid var(--border-color);
					border-radius: 9999px;
					background: linear-gradient(
						90deg,
						#23171b,
						#4145ab,
						#2aa7d6,
						#49df75,
						#d5e21a,
						#f68513,
						#900c00
					);
				}
				.heatmap-legend-description {
					grid-column: 1 / -1;
					text-align: center;
				}

				/* Respect a reduced-motion preference. Three animations run
				   indefinitely otherwise -- the spinner, the running-badge
				   pulse, and the download button's busy ring -- which is
				   moving content a reader cannot stop. */
				@media (prefers-reduced-motion: reduce) {
					*,
					*::before,
					*::after {
						animation-duration: 0.01ms !important;
						animation-iteration-count: 1 !important;
						transition-duration: 0.01ms !important;
						scroll-behavior: auto !important;
					}

					.card-link:hover .card,
					.card-link:focus-visible .card {
						transform: none;
					}
				}

				/* Responsive */
				@media (max-width: 768px) {
					.nav-container {
						flex-direction: column;
						gap: 1rem;
					}

					.nav-links {
						gap: 1rem;
					}

					.nav-actions {
						flex-wrap: wrap;
						justify-content: center;
						gap: 1rem;
					}

					main {
						padding: 1rem;
					}
				}

				@media (max-width: 480px) {
					/* Once .row-between wraps, a right-aligned trailing block
					   reads as though it belongs to the wrong column. */
					.row-end {
						text-align: left;
					}

					.action-row {
						justify-content: stretch;
					}

					.action-row > .btn {
						flex: 1 1 auto;
						text-align: center;
					}
				}
			</style>
			@templ.Raw(themeStyles)
			@templ.Raw(themePreloadScript)
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<nav aria-label="Primary">
				<div class="nav-container">
					<a href="/" class="nav-brand">
						<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"></circle>
							<circle cx="12" cy="12" r="6"></circle>
							<circle cx="12" cy="12" r="2"></circle>
						</svg>
						MayFlyCircleFit
					</a>
					<div class="nav-actions">
						<ul class="nav-links">
							<li><a href="/">Dashboard</a></li>
							<li><a href="/jobs">Jobs</a></li>
							<li><a href="/schedules">Campaigns</a></li>
							<li><a href="/create">Create Job</a></li>
							<li><a href="/settings">Settings</a></li>
							<li><a href="https://github.com/CWBudde/MayFlyCircleFit" target="_blank">GitHub</a></li>
						</ul>
						<!-- ThemeToggleIsland replaces these buttons; see its comment. -->
						<div class="theme-switch" role="group" aria-label="Color theme" data-island="theme-switch" data-island-label="color theme">
							<button class="theme-option" type="button" data-theme-value="auto" aria-label="Use system theme" aria-pressed="true" title="Auto theme">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
							</button>
							<button class="theme-option" type="button" data-theme-value="light" aria-label="Use light theme" aria-pressed="false" title="Light theme">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
							</button>
							<button class="theme-option" type="button" data-theme-value="dark" aria-label="Use dark theme" aria-pressed="false" title="Dark theme">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
							</button>
						</div>
					</div>
				</div>
			</nav>
			<main id="main-content" tabindex="-1">
				{ children... }
			</main>
			@IslandBundle()
		</body>
	</html>
}

// IslandBundle links the React island bundle. Layout calls it for every page,
// because every page now renders one island: the theme switch in the navigation
// is chrome, and moving its handler out of the shell is what stopped the shell
// carrying a script. Pages that mount an island of their own still call it too;
// a second <script type="module"> with the same src resolves to the same entry
// in the module map and is not evaluated twice.
//
// The bundle is committed and embedded, so this binary serves it rather than
// fetching it from a network the host may not have. Module scripts are
// deferred, and every island server-renders its content first, so loading the
// script from the end of the body costs the page nothing.
templ IslandBundle() {
	<script type="module" src={ BundleURL() }></script>
}
