package ui

import (
	"fmt"
	"time"
)

type MetricSample struct {
	Iteration    int      `json:"iteration"`
	Cost         float64  `json:"cost"`
	PSNR         *float64 `json:"psnr"`
	PSNRInfinite bool     `json:"psnrInfinite,omitempty"`
	SSIM         *float64 `json:"ssim,omitempty"`
}

type CircleParameter struct {
	Number  int     `json:"number"`
	X       float64 `json:"x"`
	Y       float64 `json:"y"`
	Radius  float64 `json:"radius"`
	Red     float64 `json:"red"`
	Green   float64 `json:"green"`
	Blue    float64 `json:"blue"`
	Opacity float64 `json:"opacity"`
}

// JobDetail represents a job in the detail view
type JobDetail struct {
	ID            string
	State         string
	RefPath       string
	Mode          string
	Circles       int
	Iterations    int
	MaxIters      int
	PopSize       int
	BestCost      float64
	InitialCost   float64
	StartTime     time.Time
	EndTime       *time.Time
	ElapsedSec    float64
	CPS           float64
	Termination   string
	Error         string
	RefWidth      int
	RefHeight     int
	RefSize       int64
	PSNR          *float64
	PSNRInfinite  bool
	SSIM          *float64
	SSIMEnabled   bool
	MetricHistory []MetricSample
	Parameters    []CircleParameter
}

func parameterDescription(circle CircleParameter) string {
	return fmt.Sprintf(
		"Circle %d: (%.2f, %.2f, %.2f) RGB(%d, %d, %d) α=%.3f",
		circle.Number, circle.X, circle.Y, circle.Radius,
		colorChannel(circle.Red), colorChannel(circle.Green), colorChannel(circle.Blue), circle.Opacity,
	)
}

func colorChannel(value float64) int {
	return int(min(255, max(0, value*255)) + 0.5)
}

func displayValue(visible bool) string {
	if visible {
		return "block"
	}
	return "none"
}

func parameterTabIndex(hasParameters bool) string {
	if hasParameters {
		return "0"
	}
	return "-1"
}

// JobDetailPage displays detailed view of a single job
templ JobDetailPage(job JobDetail) {
	@Layout(fmt.Sprintf("Job %s", job.ID[:8])) {
		<div style="margin-bottom: 2rem;">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<div>
					<a href="/" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem; margin-bottom: 0.5rem; display: inline-block;">
						← Back to Jobs
					</a>
					<h1 style="font-size: 2rem; font-weight: 700; font-family: monospace;">
						{ job.ID[:8] }...
					</h1>
				</div>
				<div style="text-align: right;">
					@StateBadge(job.State)
					<button onclick="location.reload()" class="btn" style="margin-left: 0.5rem; background-color: var(--border-color);">
						⟳ Refresh
					</button>
				</div>
			</div>
		</div>
		if job.Error != "" {
			<div class="card" style="background-color: #fee2e2; border: 1px solid #fca5a5; margin-bottom: 1.5rem;">
				<h3 style="color: #991b1b; font-weight: 600; margin-bottom: 0.5rem;">Error</h3>
				<p style="color: #991b1b; font-family: monospace; font-size: 0.875rem;">
					{ job.Error }
				</p>
			</div>
		}
		<!-- Metrics Panel -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<h2 style="font-size: 1.25rem; font-weight: 600;">
					Metrics
				</h2>
				if job.State == "running" || job.State == "completed" {
					<button id="sparkline-toggle" class="btn" style="font-size: 0.875rem; padding: 0.25rem 0.75rem; background-color: var(--border-color);">
						Show History
					</button>
				}
			</div>
			<!-- Metric history sparkline (initially hidden) -->
			<div id="cost-sparkline-container" style="display: none; margin-bottom: 1.5rem; padding: 1rem; background-color: var(--bg-color); border-radius: 0.375rem;">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<label for="metric-history-series" style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted);">
						Metric History
						<select id="metric-history-series" style="margin-left: 0.5rem; padding: 0.2rem 0.4rem; border: 1px solid var(--border-color); border-radius: 0.25rem; background: white;">
							<option value="cost">Cost</option>
							<option value="psnr">PSNR</option>
							if job.SSIMEnabled {
								<option value="ssim">SSIM</option>
							}
						</select>
					</label>
					<div id="sparkline-stats" style="font-size: 0.75rem; color: var(--text-muted);">
						<span id="sparkline-samples">0</span> samples
					</div>
				</div>
				<svg id="cost-sparkline" width="100%" height="80" style="border: 1px solid var(--border-color); border-radius: 0.25rem; background-color: white;">
					<polyline id="sparkline-line" fill="none" stroke="var(--primary-color)" stroke-width="2"></polyline>
					<circle id="sparkline-dot" r="3" fill="var(--primary-color)" style="display: none;"></circle>
				</svg>
				<div style="display: flex; justify-content: space-between; margin-top: 0.5rem; font-size: 0.75rem; color: var(--text-muted);">
					<span>Start: <span id="sparkline-start">-</span></span>
					<span>Current: <span id="sparkline-current">-</span></span>
					<span><span id="sparkline-best-label">Min</span>: <span id="sparkline-min">-</span></span>
				</div>
			</div>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Best Cost
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="best-cost">
						{ fmt.Sprintf("%.4f", job.BestCost) }
					</div>
					if job.InitialCost > 0 && job.BestCost < job.InitialCost {
						<div style="font-size: 0.75rem; color: var(--success-color); margin-top: 0.25rem;">
							↓ { fmt.Sprintf("%.1f%%", (1-job.BestCost/job.InitialCost)*100) } improvement
						</div>
					}
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						PSNR
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;">
						<span data-metric="psnr">
							if job.PSNRInfinite {
								∞
							} else if job.PSNR != nil {
								{ fmt.Sprintf("%.2f", *job.PSNR) }
							} else {
								—
							}
						</span> dB
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						Higher is better
					</div>
				</div>
				if job.SSIMEnabled {
					<div>
						<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
							SSIM
						</div>
						<div style="font-size: 1.5rem; font-weight: 600;" data-metric="ssim">
							if job.SSIM != nil {
								{ fmt.Sprintf("%.4f", *job.SSIM) }
							} else {
								Calculating…
							}
						</div>
						<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
							Structural similarity, higher is better
						</div>
					</div>
				}
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Iterations
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="iterations">
						{ fmt.Sprintf("%d", job.Iterations) }
						if job.MaxIters > 0 {
							<span style="font-size: 1rem; color: var(--text-muted);">
								/ { fmt.Sprintf("%d", job.MaxIters) }
							</span>
						}
					</div>
					if job.MaxIters > 0 && job.Iterations > 0 {
						<div style="margin-top: 0.5rem; background-color: var(--border-color); height: 4px; border-radius: 2px; overflow: hidden;">
							<div style={ fmt.Sprintf("width: %.1f%%; height: 100%%; background-color: var(--primary-color);", float64(job.Iterations)/float64(job.MaxIters)*100) }></div>
						</div>
					}
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Throughput
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="cps">
						{ formatNumber(job.CPS) }
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						circles/sec
					</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Elapsed Time
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;">
						{ formatDuration(job.ElapsedSec) }
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						{ formatTimestamp(job.StartTime) }
					</div>
					if job.Termination != "" {
						<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;" data-metric="termination">
							stopped: { job.Termination }
						</div>
					}
				</div>
			</div>
		</div>
		<!-- Configuration Panel -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">
				Configuration
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Mode</div>
					<div style="font-weight: 500; text-transform: capitalize;">{ job.Mode }</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Circles</div>
					<div style="font-weight: 500;">{ fmt.Sprintf("%d", job.Circles) }</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Population Size</div>
					<div style="font-weight: 500;">{ fmt.Sprintf("%d", job.PopSize) }</div>
				</div>
				<div style="grid-column: 1 / -1;">
					<div style="font-size: 0.875rem; color: var(--text-muted);">Reference Image</div>
					<div style="font-weight: 500; font-family: monospace; font-size: 0.875rem;">{ job.RefPath }</div>
				</div>
			</div>
		</div>
		<!-- Current best parameter viewer -->
		<style>
			.parameter-viewer summary {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				cursor: pointer;
				list-style: none;
			}
			.parameter-viewer summary::-webkit-details-marker {
				display: none;
			}
			.parameter-viewer summary::after {
				content: "▾";
				color: var(--text-muted);
				transition: transform 0.2s;
			}
			.parameter-viewer[open] summary::after {
				transform: rotate(180deg);
			}
			.parameter-list {
				list-style: none;
				max-height: 28rem;
				overflow: auto;
				margin-top: 1rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
			}
			.parameter-list li {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.6rem 0.75rem;
				font-family: monospace;
				font-size: 0.8125rem;
			}
			.parameter-list li + li {
				border-top: 1px solid var(--border-color);
			}
			.parameter-list li:hover {
				background-color: var(--bg-color);
			}
			.parameter-color {
				flex: 0 0 auto;
				width: 1rem;
				height: 1rem;
				border: 1px solid var(--border-color);
				border-radius: 50%;
			}
			.parameter-export[aria-disabled="true"] {
				pointer-events: none;
				opacity: 0.5;
			}
		</style>
		<div class="card" style="margin-bottom: 1.5rem;">
			<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
				<div>
					<h2 style="font-size: 1.25rem; font-weight: 600;">Current Best Parameters</h2>
					<p style="font-size: 0.875rem; color: var(--text-muted);">
						<span id="parameter-count">{ fmt.Sprintf("%d", len(job.Parameters)) }</span> of { fmt.Sprintf("%d", job.Circles) } circles available
					</p>
				</div>
				<a
					id="parameter-export"
					class="btn parameter-export"
					style="background-color: var(--border-color); font-size: 0.875rem;"
					href={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/params.json", job.ID)) }
					download="params.json"
					aria-disabled={ fmt.Sprintf("%t", len(job.Parameters) == 0) }
					tabindex={ parameterTabIndex(len(job.Parameters) > 0) }
				>
					Download params.json
				</a>
			</div>
			<details id="parameter-viewer" class="parameter-viewer" style="margin-top: 1rem;">
				<summary>
					<span style="font-weight: 600;">Inspect circles</span>
					<span style="font-size: 0.75rem; color: var(--text-muted);">X, Y, radius, RGB, opacity</span>
				</summary>
				<p id="parameter-empty" style={ fmt.Sprintf("display: %s; margin-top: 1rem; color: var(--text-muted); font-size: 0.875rem;", displayValue(len(job.Parameters) == 0)) }>
					No best parameters available yet.
				</p>
				<ol id="parameter-list" class="parameter-list" style={ fmt.Sprintf("display: %s;", displayValue(len(job.Parameters) > 0)) }>
					for _, circle := range job.Parameters {
						<li title={ parameterDescription(circle) }>
							<span class="parameter-color" style={ fmt.Sprintf("background-color: rgba(%d, %d, %d, %.3f);", colorChannel(circle.Red), colorChannel(circle.Green), colorChannel(circle.Blue), circle.Opacity) }></span>
							<span>{ parameterDescription(circle) }</span>
						</li>
					}
				</ol>
			</details>
		</div>
		<!-- Selectable image comparison views -->
		<style>
			.view-mode-selector {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				border: 0;
			}
			.view-mode-selector legend {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}
			.view-mode-option {
				position: relative;
			}
			.view-mode-option input {
				position: absolute;
				opacity: 0;
				pointer-events: none;
			}
			.view-mode-option label {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.4rem 0.7rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				color: var(--text-muted);
				font-size: 0.875rem;
				font-weight: 500;
				cursor: pointer;
				transition: all 0.2s;
			}
			.view-mode-option input:checked + label {
				border-color: var(--primary-color);
				background-color: #dbeafe;
				color: #1e40af;
			}
			.view-mode-option input:focus-visible + label {
				outline: 2px solid var(--primary-color);
				outline-offset: 2px;
			}
			.view-mode-shortcut {
				font-family: monospace;
				font-size: 0.75rem;
				opacity: 0.75;
			}
			.image-view-panels {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 2rem;
			}
			.image-view-panel {
				display: none;
				min-width: 0;
			}
			.image-viewer[data-view-mode="reference"] [data-view-panel="reference"],
			.image-viewer[data-view-mode="best"] [data-view-panel="best"],
			.image-viewer[data-view-mode="difference"] [data-view-panel="difference"],
			.image-viewer[data-view-mode="side-by-side"]
				[data-view-panel="reference"],
			.image-viewer[data-view-mode="side-by-side"] [data-view-panel="best"] {
				display: block;
			}
			.image-viewer[data-view-mode="side-by-side"] .image-view-panels {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
			.image-frame {
				position: relative;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				overflow: hidden;
				background: repeating-conic-gradient(#f9fafb 0% 25%, #ffffff 0% 50%)
					50% / 20px 20px;
			}
			.image-frame-difference {
				background: #000000;
			}
			.image-frame img {
				width: 100%;
				height: auto;
				display: block;
				transition: opacity 0.3s ease;
			}
			.image-state {
				display: none;
				padding: 2rem;
				text-align: center;
				color: var(--text-muted);
			}
			.image-loading {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
			}
			.image-metadata {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 0.5rem;
				font-size: 0.75rem;
				color: var(--text-muted);
			}
			.heatmap-heading {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}
			.heatmap-colormap-control {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			.heatmap-colormap-control select {
				padding: 0.3rem 0.5rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				background-color: var(--surface-color);
				color: var(--text-color);
			}
			.heatmap-legend {
				display: grid;
				grid-template-columns: auto minmax(120px, 1fr) auto;
				align-items: center;
				gap: 0.5rem;
				margin-top: 0.75rem;
				font-size: 0.75rem;
				color: var(--text-muted);
			}
			.heatmap-legend-gradient {
				height: 0.75rem;
				border: 1px solid var(--border-color);
				border-radius: 9999px;
				background: linear-gradient(
					90deg,
					#23171b,
					#4145ab,
					#2aa7d6,
					#49df75,
					#d5e21a,
					#f68513,
					#900c00
				);
			}
			.heatmap-legend-description {
				grid-column: 1 / -1;
				text-align: center;
			}
			@media (max-width: 768px) {
				.image-viewer[data-view-mode="side-by-side"] .image-view-panels {
					grid-template-columns: minmax(0, 1fr);
				}
			}
		</style>
		<div id="image-viewer" class="card image-viewer" data-view-mode="side-by-side" data-job-id={ job.ID } data-job-state={ job.State }>
			<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem;">
				<h2 style="font-size: 1.25rem; font-weight: 600;">
					Images
				</h2>
				<fieldset class="view-mode-selector" aria-label="Image view mode">
					<legend>Image view mode</legend>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-reference" name="view-mode" value="reference" aria-keyshortcuts="1"/>
						<label for="view-mode-reference">Reference <span class="view-mode-shortcut" aria-hidden="true">1</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-best" name="view-mode" value="best" aria-keyshortcuts="2"/>
						<label for="view-mode-best">Best <span class="view-mode-shortcut" aria-hidden="true">2</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-side-by-side" name="view-mode" value="side-by-side" aria-keyshortcuts="3" checked/>
						<label for="view-mode-side-by-side">Side-by-Side <span class="view-mode-shortcut" aria-hidden="true">3</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-difference" name="view-mode" value="difference" aria-keyshortcuts="4"/>
						<label for="view-mode-difference">Difference <span class="view-mode-shortcut" aria-hidden="true">4</span></label>
					</div>
				</fieldset>
			</div>
			<div class="image-view-panels">
				<!-- Reference Image -->
				<div class="image-view-panel" data-view-panel="reference">
					<h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-muted);">
						Reference
					</h3>
					<div class="image-frame">
						<img
							id="reference-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/ref.png", job.ID)) }
							alt="Reference Image"
						/>
						<div id="reference-image-loading" class="image-state image-loading">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="reference-image-error" class="image-state">
							Reference image not available
						</div>
					</div>
					<div class="image-metadata" aria-label="Reference image metadata">
						if job.RefWidth > 0 && job.RefHeight > 0 {
							<span>{ fmt.Sprintf("%d × %d px", job.RefWidth, job.RefHeight) }</span>
						}
						if job.RefSize > 0 {
							<span title={ fmt.Sprintf("%d bytes", job.RefSize) }>{ formatFileSize(job.RefSize) }</span>
						}
						if job.RefWidth <= 0 && job.RefHeight <= 0 && job.RefSize <= 0 {
							<span>Metadata unavailable</span>
						}
					</div>
				</div>
				<!-- Current Best Image -->
				<div class="image-view-panel" data-view-panel="best">
					<h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-muted);">
						Current Best
					</h3>
					<div class="image-frame">
						<img
							id="best-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/best.png?t=%d", job.ID, time.Now().Unix())) }
							alt="Current Best Image"
						/>
						<div id="best-image-loading" class="image-state image-loading">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="best-image-error" class="image-state">
							if job.State == "pending" {
								Optimization not started yet
							} else {
								No results yet
							}
						</div>
					</div>
				</div>
				<!-- Difference Image -->
				<div class="image-view-panel" data-view-panel="difference">
					<div class="heatmap-heading">
						<h3 style="font-size: 1rem; font-weight: 600; color: var(--text-muted);">
							Difference Heatmap
						</h3>
						<label class="heatmap-colormap-control" for="heatmap-colormap">
							Colormap
							<select id="heatmap-colormap">
								<option value="turbo" selected>Turbo</option>
								<option value="magma">Magma</option>
							</select>
						</label>
					</div>
					<div class="image-frame image-frame-difference">
						<img
							id="diff-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/diff.png?colormap=turbo&t=%d", job.ID, time.Now().Unix())) }
							alt="False-color difference heatmap"
						/>
						<div id="diff-image-loading" class="image-state image-loading" style="color: #cccccc;">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="diff-image-error" class="image-state" style="color: #cccccc;">
							if job.State == "pending" {
								Not available yet
							} else {
								No results yet
							}
						</div>
					</div>
					<div class="heatmap-legend" role="img" aria-label="Mean absolute RGB error scale from 0 to 255">
						<span>0</span>
						<div id="heatmap-legend-gradient" class="heatmap-legend-gradient"></div>
						<span>255</span>
						<span class="heatmap-legend-description">Mean absolute RGB error per pixel</span>
					</div>
				</div>
			</div>
		</div>
		@templ.JSONScript("metric-history-data", job.MetricHistory)
		@templ.JSONScript("parameter-data", job.Parameters)
		<!-- SSE for live updates -->
		<script>
			(function () {
				const imageViewer = document.getElementById("image-viewer");
				const jobId = imageViewer.dataset.jobId;
				const jobState = imageViewer.dataset.jobState;
				const viewStorageKey = "mayflycirclefit.viewMode";
				const viewModes = ["reference", "best", "side-by-side", "difference"];
				const shortcutViews = {
					1: "reference",
					2: "best",
					3: "side-by-side",
					4: "difference",
				};
				let parameterRefreshPending = false;

				initializeViewMode();
				initializeImageState(
					"reference-image",
					"reference-image-loading",
					"reference-image-error",
				);
				initializeImageState(
					"best-image",
					"best-image-loading",
					"best-image-error",
				);
				initializeImageState(
					"diff-image",
					"diff-image-loading",
					"diff-image-error",
				);
				initializeHeatmapColormap();
				initializeParameterViewer();

				// Bounded server-seeded quality history for the selectable sparkline.
				const MAX_SAMPLES = 100;
				let metricHistory = [];
				const historyData = document.getElementById("metric-history-data");
				if (historyData) {
					try {
						metricHistory = JSON.parse(historyData.textContent) || [];
					} catch (err) {
						console.error("Unable to parse metric history:", err);
					}
				}
				metricHistory = metricHistory.slice(-MAX_SAMPLES);

				// Sparkline toggle
				const toggleBtn = document.getElementById("sparkline-toggle");
				const sparklineContainer = document.getElementById(
					"cost-sparkline-container",
				);
				const metricSeries = document.getElementById("metric-history-series");
				let sparklineVisible = false;

				if (toggleBtn) {
					toggleBtn.addEventListener("click", function () {
						sparklineVisible = !sparklineVisible;
						sparklineContainer.style.display = sparklineVisible
							? "block"
							: "none";
						toggleBtn.textContent = sparklineVisible
							? "Hide History"
							: "Show History";
						if (sparklineVisible) {
							updateSparkline();
						}
					});
				}
				if (metricSeries) {
					metricSeries.addEventListener("change", updateSparkline);
				}
				window.addEventListener("resize", function () {
					if (sparklineVisible) updateSparkline();
				});

				function initializeViewMode() {
					const controls = document.querySelectorAll('input[name="view-mode"]');
					controls.forEach(function (control) {
						control.addEventListener("change", function () {
							if (control.checked) {
								applyViewMode(control.value, true);
							}
						});
					});

					let initialMode = "side-by-side";
					try {
						const storedMode = window.localStorage.getItem(viewStorageKey);
						if (viewModes.includes(storedMode)) {
							initialMode = storedMode;
						}
					} catch (err) {
						// Storage can be unavailable in privacy-restricted browser contexts.
					}
					applyViewMode(initialMode, false);

					document.addEventListener("keydown", function (event) {
						if (
							event.defaultPrevented ||
							event.altKey ||
							event.ctrlKey ||
							event.metaKey ||
							event.shiftKey
						) {
							return;
						}
						const target = event.target;
						if (
							target &&
							(target.isContentEditable ||
								["INPUT", "SELECT", "TEXTAREA"].includes(target.tagName))
						) {
							return;
						}
						const mode = shortcutViews[event.key];
						if (!mode) {
							return;
						}
						event.preventDefault();
						applyViewMode(mode, true);
					});
				}

				function applyViewMode(mode, persist) {
					if (!viewModes.includes(mode)) {
						mode = "side-by-side";
					}
					const viewer = document.getElementById("image-viewer");
					if (!viewer) {
						return;
					}
					viewer.dataset.viewMode = mode;
					const control = document.querySelector(
						'input[name="view-mode"][value="' + mode + '"]',
					);
					if (control) {
						control.checked = true;
					}
					if (persist) {
						try {
							window.localStorage.setItem(viewStorageKey, mode);
						} catch (err) {
							// The selected view still applies for the current page.
						}
					}
				}

				// Only connect SSE if job is running or pending
				if (jobState === "running" || jobState === "pending") {
					const eventSource = new EventSource(
						"/api/v1/jobs/" + jobId + "/stream",
					);

					eventSource.onmessage = function (event) {
						const data = JSON.parse(event.data);

						// Update metrics
						updateMetric("best-cost", data.bestCost.toFixed(4));
						updateMetric("iterations", data.iterations);
						updateMetric("cps", formatNumber(data.cps));
						if (data.psnrInfinite) {
							updateMetric("psnr", "∞");
						} else if (typeof data.psnr === "number") {
							updateMetric("psnr", data.psnr.toFixed(2));
						}
						if (typeof data.ssim === "number") {
							updateMetric("ssim", data.ssim.toFixed(4));
						}

						addMetricSample(data);
						refreshParameterViewer();

						// If job completed, reload to update images
						if (
							data.state === "completed" ||
							data.state === "failed" ||
							data.state === "cancelled"
						) {
							eventSource.close();
							location.reload();
						} else {
							// Refresh images with cache busting and loading states
							const timestamp = new Date().getTime();
							refreshImage(
								"best-image",
								"best-image-loading",
								jobId,
								"best.png",
								timestamp,
							);
							refreshImage(
								"diff-image",
								"diff-image-loading",
								jobId,
								"diff.png",
								timestamp,
								selectedHeatmapColormap(),
							);
						}
					};

					eventSource.onerror = function (err) {
						console.error("SSE connection error:", err);
						eventSource.close();
						// Fallback to polling after 5 seconds
						setTimeout(function () {
							location.reload();
						}, 5000);
					};
				}

				function updateMetric(id, value) {
					const elements = document.querySelectorAll(
						'[data-metric="' + id + '"]',
					);
					elements.forEach(function (el) {
						el.textContent = value;
					});
				}

				function initializeParameterViewer() {
					const viewer = document.getElementById("parameter-viewer");
					if (!viewer) return;
					viewer.addEventListener("toggle", function () {
						if (viewer.open) refreshParameterViewer();
					});

					const data = document.getElementById("parameter-data");
					if (!data) return;
					try {
						const circles = JSON.parse(data.textContent) || [];
						if (circles.length > 0) renderParameters(circles);
					} catch (err) {
						console.error("Unable to parse parameter data:", err);
					}
				}

				async function refreshParameterViewer() {
					const viewer = document.getElementById("parameter-viewer");
					if (!viewer || !viewer.open || parameterRefreshPending) return;
					parameterRefreshPending = true;
					try {
						const response = await fetch(
							"/api/v1/jobs/" + jobId + "/params.json",
							{ cache: "no-store", headers: { Accept: "application/json" } },
						);
						if (response.status === 404) return;
						if (!response.ok) throw new Error("HTTP " + response.status);
						const snapshot = await response.json();
						renderParameters(snapshot.circles || []);
					} catch (err) {
						console.error("Unable to refresh parameters:", err);
					} finally {
						parameterRefreshPending = false;
					}
				}

				function renderParameters(circles) {
					const list = document.getElementById("parameter-list");
					const empty = document.getElementById("parameter-empty");
					const count = document.getElementById("parameter-count");
					const exportLink = document.getElementById("parameter-export");
					if (!list || !empty || !count) return;

					list.replaceChildren();
					circles.forEach(function (circle) {
						const description = formatParameter(circle);
						const item = document.createElement("li");
						item.title = description;
						const swatch = document.createElement("span");
						swatch.className = "parameter-color";
						swatch.style.backgroundColor =
							"rgba(" +
							colorChannel(circle.red) + ", " +
							colorChannel(circle.green) + ", " +
							colorChannel(circle.blue) + ", " +
							circle.opacity.toFixed(3) + ")";
						const text = document.createElement("span");
						text.textContent = description;
						item.append(swatch, text);
						list.appendChild(item);
					});

					count.textContent = circles.length;
					list.style.display = circles.length > 0 ? "block" : "none";
					empty.style.display = circles.length > 0 ? "none" : "block";
					if (exportLink) {
						exportLink.setAttribute(
							"aria-disabled",
							circles.length > 0 ? "false" : "true",
						);
						exportLink.tabIndex = circles.length > 0 ? 0 : -1;
					}
				}

				function formatParameter(circle) {
					return (
						"Circle " + circle.number + ": (" +
						circle.x.toFixed(2) + ", " +
						circle.y.toFixed(2) + ", " +
						circle.radius.toFixed(2) + ") RGB(" +
						colorChannel(circle.red) + ", " +
						colorChannel(circle.green) + ", " +
						colorChannel(circle.blue) + ") α=" +
						circle.opacity.toFixed(3)
					);
				}

				function colorChannel(value) {
					return Math.round(Math.min(1, Math.max(0, value)) * 255);
				}

				function formatNumber(n) {
					if (n >= 1000000) {
						return (n / 1000000).toFixed(1) + "M";
					} else if (n >= 1000) {
						return (n / 1000).toFixed(1) + "K";
					} else {
						return Math.round(n).toString();
					}
				}

				function refreshImage(
					imgId,
					loadingId,
					jobId,
					filename,
					timestamp,
					colormap,
				) {
					const img = document.getElementById(imgId);
					const loading = document.getElementById(loadingId);
					const error = document.getElementById(imgId + "-error");

					if (!img) return;

					// Keep the last successful image visible while preloading its replacement.
					if (loading) {
						loading.style.display = "block";
					}
					if (img.naturalWidth > 0) {
						img.style.display = "block";
						img.style.opacity = "0.5";
					}

					// Create new image to preload
					const newImg = new Image();
					newImg.onload = function () {
						img.src = newImg.src;
						img.style.display = "block";
						img.style.opacity = "1";
						if (loading) {
							loading.style.display = "none";
						}
						if (error) {
							error.style.display = "none";
						}
					};
					newImg.onerror = function () {
						// Keep a prior successful image; otherwise retain the empty-state message.
						img.style.opacity = "1";
						if (loading) {
							loading.style.display = "none";
						}
						if (img.naturalWidth === 0) {
							showImageError(img, error);
						}
					};
					let imageURL =
						"/api/v1/jobs/" + jobId + "/" + filename + "?t=" + timestamp;
					if (colormap) {
						imageURL += "&colormap=" + encodeURIComponent(colormap);
					}
					newImg.src = imageURL;
				}

				function initializeHeatmapColormap() {
					const select = document.getElementById("heatmap-colormap");
					if (!select) {
						return;
					}
					select.addEventListener("change", function () {
						updateHeatmapLegend(select.value);
						refreshImage(
							"diff-image",
							"diff-image-loading",
							jobId,
							"diff.png",
							Date.now(),
							select.value,
						);
					});
					updateHeatmapLegend(select.value);
				}

				function selectedHeatmapColormap() {
					const select = document.getElementById("heatmap-colormap");
					return select ? select.value : "turbo";
				}

				function updateHeatmapLegend(colormap) {
					const gradient = document.getElementById("heatmap-legend-gradient");
					if (!gradient) {
						return;
					}
					if (colormap === "magma") {
						gradient.style.background =
							"linear-gradient(90deg, #000004, #180f3d, #3d0f70, #65156e, #8c2961, #b7374b, #de492f, #f67019, #fda50a, #f9dc5c, #fcfdbf)";
					} else {
						gradient.style.background =
							"linear-gradient(90deg, #23171b, #4145ab, #2aa7d6, #49df75, #d5e21a, #f68513, #900c00)";
					}
				}

				function initializeImageState(imgId, loadingId, errorId) {
					const img = document.getElementById(imgId);
					const loading = document.getElementById(loadingId);
					const error = document.getElementById(errorId);
					if (!img) {
						return;
					}
					img.addEventListener("load", function () {
						img.style.display = "block";
						img.style.opacity = "1";
						if (loading) loading.style.display = "none";
						if (error) error.style.display = "none";
					});
					img.addEventListener("error", function () {
						if (loading) loading.style.display = "none";
						showImageError(img, error);
					});
					if (img.complete) {
						if (img.naturalWidth > 0) {
							img.style.display = "block";
							if (error) error.style.display = "none";
						} else {
							showImageError(img, error);
						}
					}
				}

				function showImageError(img, error) {
					img.style.display = "none";
					if (error) {
						error.style.display = "block";
					}
				}

				function addMetricSample(data) {
					metricHistory.push({
						iteration: data.iterations,
						cost: data.bestCost,
						psnr: typeof data.psnr === "number" ? data.psnr : null,
						psnrInfinite: data.psnrInfinite === true,
						ssim: typeof data.ssim === "number" ? data.ssim : null,
					});
					if (metricHistory.length > MAX_SAMPLES) metricHistory.shift();
					if (sparklineVisible) updateSparkline();
				}

				function selectedMetricValues() {
					const series = metricSeries ? metricSeries.value : "cost";
					return {
						series: series,
						values: metricHistory
							.map(function (sample) {
								const value = sample[series];
								return typeof value === "number" && Number.isFinite(value)
									? value
									: null;
							})
							.filter(function (value) {
								return value !== null;
							}),
					};
				}

				function formatMetricValue(series, value) {
					if (series === "psnr") return value.toFixed(2) + " dB";
					return value.toFixed(4);
				}

				function updateSparkline() {
					const svg = document.getElementById("cost-sparkline");
					const line = document.getElementById("sparkline-line");
					const dot = document.getElementById("sparkline-dot");
					if (!svg || !line) return;
					const selected = selectedMetricValues();
					const values = selected.values;
					document.getElementById("sparkline-samples").textContent =
						values.length;
					document.getElementById("sparkline-best-label").textContent =
						selected.series === "cost" ? "Min" : "Max";
					if (values.length === 0) {
						line.setAttribute("points", "");
						dot.style.display = "none";
						document.getElementById("sparkline-start").textContent = "-";
						document.getElementById("sparkline-current").textContent = "-";
						document.getElementById("sparkline-min").textContent = "-";
						return;
					}

					const width = svg.clientWidth;
					const height = 80;
					const padding = 10;
					const minimum = Math.min(...values);
					const maximum = Math.max(...values);
					const range = maximum - minimum || 1;
					const denominator = Math.max(1, values.length - 1);
					const points = values
						.map((value, i) => {
							const x = padding + (i / denominator) * (width - 2 * padding);
							const y =
								height -
								padding -
								((value - minimum) / range) * (height - 2 * padding);
							return x + "," + y;
						})
						.join(" ");
					line.setAttribute("points", points);
					const lastValue = values[values.length - 1];
					dot.setAttribute(
						"cx",
						padding +
							((values.length - 1) / denominator) * (width - 2 * padding),
					);
					dot.setAttribute(
						"cy",
						height -
							padding -
							((lastValue - minimum) / range) * (height - 2 * padding),
					);
					dot.style.display = "block";
					document.getElementById("sparkline-start").textContent =
						formatMetricValue(selected.series, values[0]);
					document.getElementById("sparkline-current").textContent =
						formatMetricValue(selected.series, lastValue);
					const best = selected.series === "cost" ? minimum : maximum;
					document.getElementById("sparkline-min").textContent =
						formatMetricValue(selected.series, best);
				}
			})();
		</script>
	}
}

// JobNotFound displays a 404 page for jobs that don't exist
templ JobNotFound(jobID string) {
	@Layout("Job Not Found") {
		<div class="card" style="text-align: center; padding: 3rem;">
			<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin: 0 auto 1rem; color: var(--text-muted);">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">
				Job Not Found
			</h1>
			<p style="color: var(--text-muted); margin-bottom: 1.5rem; font-family: monospace;">
				Job ID: { jobID }
			</p>
			<a href="/" class="btn btn-primary">
				← Back to Jobs
			</a>
		</div>
	}
}

// Helper function to format large numbers with K/M suffix
func formatNumber(n float64) string {
	if n >= 1_000_000 {
		return fmt.Sprintf("%.1fM", n/1_000_000)
	} else if n >= 1_000 {
		return fmt.Sprintf("%.1fK", n/1_000)
	} else {
		return fmt.Sprintf("%.0f", n)
	}
}

// Helper function to format duration in seconds to human-readable string
func formatDuration(seconds float64) string {
	if seconds < 1 {
		return fmt.Sprintf("%.0fms", seconds*1000)
	} else if seconds < 60 {
		return fmt.Sprintf("%.1fs", seconds)
	} else if seconds < 3600 {
		mins := int(seconds / 60)
		secs := int(seconds) % 60
		return fmt.Sprintf("%dm %ds", mins, secs)
	} else {
		hours := int(seconds / 3600)
		mins := int(seconds/60) % 60
		return fmt.Sprintf("%dh %dm", hours, mins)
	}
}

// Helper function to format file sizes with binary units.
func formatFileSize(size int64) string {
	if size < 1024 {
		return fmt.Sprintf("%d B", size)
	} else if size < 1024*1024 {
		return fmt.Sprintf("%.1f KiB", float64(size)/1024)
	} else if size < 1024*1024*1024 {
		return fmt.Sprintf("%.1f MiB", float64(size)/(1024*1024))
	}
	return fmt.Sprintf("%.1f GiB", float64(size)/(1024*1024*1024))
}

// Helper function to format timestamp
func formatTimestamp(t time.Time) string {
	return t.Format("Jan 2, 2006 3:04 PM")
}
