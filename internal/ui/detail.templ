package ui

import (
	"fmt"
	"time"
)

type MetricSample struct {
	Iteration    int      `json:"iteration"`
	Cost         float64  `json:"cost"`
	PSNR         *float64 `json:"psnr"`
	PSNRInfinite bool     `json:"psnrInfinite,omitempty"`
	SSIM         *float64 `json:"ssim,omitempty"`
}

type CircleParameter struct {
	Number  int     `json:"number"`
	X       float64 `json:"x"`
	Y       float64 `json:"y"`
	Radius  float64 `json:"radius"`
	Red     float64 `json:"red"`
	Green   float64 `json:"green"`
	Blue    float64 `json:"blue"`
	Opacity float64 `json:"opacity"`
}

// JobDetail represents a job in the detail view
type JobDetail struct {
	ID            string
	State         string
	RefPath       string
	Mode          string
	Variant       string
	// EvaluationWorkers is the width the job's renderer actually ran at, not the
	// width its configuration requested: a backend without independent sessions
	// runs serially however many workers were asked for, and a CPU request above
	// GOMAXPROCS is clamped. Zero means serial or unknown and renders nothing,
	// because a wrong number here is worse than none -- the value exists so two
	// runs can be told apart.
	EvaluationWorkers int
	// FastCompositing records that the job ran the reduced-precision span
	// compositor. It belongs next to the seed, not with the tuning knobs: two
	// runs that differ in it are not pixel-comparable, so a completed job has to
	// be able to say which one it was.
	FastCompositing bool
	Circles       int
	Iterations    int
	Evaluations   int
	MaxIters      int
	ItersPerEpoch int
	OptimizerEpochs int
	PopSize       int
	PolishingEnabled bool
	PolishingOnly bool
	CanPolish bool
	PolishingStrategy string
	PolishingActiveSetSize int
	PolishingMaxSweeps int
	PolishingEpochs int
	PolishingIters int
	PolishingPopSize int
	PolishingStagnationIters int
	PolishingMinImprovement float64
	BestCost      float64
	CandidateCost *float64
	CandidatePSNR *float64
	CandidatePSNRInfinite bool
	BestRevision  uint64
	InitialCost   float64
	StartTime     time.Time
	EndTime       *time.Time
	ElapsedSec    float64
	CPS           float64
	Termination   string
	Error         string
	RefWidth      int
	RefHeight     int
	RefSize       int64
	PSNR          *float64
	PSNRInfinite  bool
	SSIM          *float64
	SSIMEnabled   bool
	MetricHistory []MetricSample
	Parameters    []CircleParameter
}

func parameterDescription(circle CircleParameter) string {
	return fmt.Sprintf(
		"Circle %d: (%.2f, %.2f, %.2f) RGB(%d, %d, %d) α=%.3f",
		circle.Number, circle.X, circle.Y, circle.Radius,
		colorChannel(circle.Red), colorChannel(circle.Green), colorChannel(circle.Blue), circle.Opacity,
	)
}

func colorChannel(value float64) int {
	return int(min(255, max(0, value*255)) + 0.5)
}

func displayValue(visible bool) string {
	if visible {
		return "block"
	}
	return "none"
}

func parameterTabIndex(hasParameters bool) string {
	if hasParameters {
		return "0"
	}
	return "-1"
}

// JobDetailPage displays detailed view of a single job
templ JobDetailPage(job JobDetail) {
	@Layout(fmt.Sprintf("Job %s", job.ID[:8])) {
		<div style="margin-bottom: 2rem;">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<div>
					<a href="/jobs" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem; margin-bottom: 0.5rem; display: inline-block;">
						← Back to Jobs
					</a>
					<h1 style="font-size: 2rem; font-weight: 700; font-family: monospace;">
						{ job.ID[:8] }...
					</h1>
				</div>
				<div style="text-align: right;">
					@StateBadge(job.State)
					if job.CanPolish {
						<button id="polish-job" class="btn btn-primary" style="margin-left: 0.5rem;">
							Polish weak circles
						</button>
					}
					<button onclick="location.reload()" class="btn" style="margin-left: 0.5rem; background-color: var(--border-color);">
						⟳ Refresh
					</button>
				</div>
			</div>
		</div>
		if job.Error != "" {
			<div class="card" style="background-color: var(--error-bg); border: 1px solid var(--error-border); margin-bottom: 1.5rem;">
				<h3 style="color: var(--error-text); font-weight: 600; margin-bottom: 0.5rem;">Error</h3>
				<p style="color: var(--error-text); font-family: monospace; font-size: 0.875rem;">
					{ job.Error }
				</p>
			</div>
		}
		<style>
			.detail-stack { display: flex; flex-direction: column; }
			.detail-summary { order: 1; }
			.detail-images { order: 2; }
			.detail-history { order: 3; }
			.detail-downloads { order: 4; }
			.detail-configuration { order: 5; }
			.detail-parameters { order: 6; }
		</style>
		<div class="detail-stack">
			<!-- Compact metric summary -->
			<div class="card detail-summary" style="margin-bottom: 1.5rem;">
				<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Metrics</h2>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem;">
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Audited Best Cost
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="best-cost">
						{ fmt.Sprintf("%.4f", job.BestCost) }
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">RGB mean squared error · committed and checkpoint-safe · lower is better</div>
				if job.InitialCost > 0 && job.BestCost < job.InitialCost {
						<div style="font-size: 0.75rem; color: var(--success-color); margin-top: 0.25rem;">
							↓ { fmt.Sprintf("%.1f%%", (1-job.BestCost/job.InitialCost)*100) } improvement
						</div>
					}
				</div>
				<div id="candidate-metrics" style={ fmt.Sprintf("display: %s; padding: 0.75rem; border: 1px solid var(--primary-color); border-radius: 0.5rem; background: color-mix(in srgb, var(--primary-color) 8%%, transparent);", displayValue(job.CandidateCost != nil)) }>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">In-flight Candidate</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="candidate-cost">
						if job.CandidateCost != nil {
							{ fmt.Sprintf("%.4f", *job.CandidateCost) }
						} else {
							—
						}
					</div>
					<div style="font-size: 0.75rem; color: var(--success-color); margin-top: 0.25rem;" data-metric="candidate-gain">
						if job.CandidateCost != nil && *job.CandidateCost < job.BestCost {
							↓ { fmt.Sprintf("%.4f (%.2f%%) provisional gain", job.BestCost-*job.CandidateCost, (1-*job.CandidateCost/job.BestCost)*100) }
						}
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						<span data-metric="candidate-psnr">
							if job.CandidatePSNRInfinite {
								∞
							} else if job.CandidatePSNR != nil {
								{ fmt.Sprintf("%.2f", *job.CandidatePSNR) }
							} else {
								—
							}
						</span> dB · pending full-image usefulness audit
					</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Audited PSNR
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;">
						<span data-metric="psnr">
							if job.PSNRInfinite {
								∞
							} else if job.PSNR != nil {
								{ fmt.Sprintf("%.2f", *job.PSNR) }
							} else {
								—
							}
						</span> dB
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						Peak signal-to-noise ratio · higher is better
					</div>
				</div>
				if job.SSIMEnabled {
					<div>
						<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
							SSIM
						</div>
						<div style="font-size: 1.5rem; font-weight: 600;" data-metric="ssim">
							if job.SSIM != nil {
								{ fmt.Sprintf("%.4f", *job.SSIM) }
							} else {
								Calculating…
							}
						</div>
						<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
							Structural similarity, higher is better
						</div>
					</div>
				}
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">Iterations</div>
					<div style="font-size: 1.5rem; font-weight: 600;">
						<span data-metric="iterations">{ fmt.Sprintf("%d", job.Iterations) }</span>
						if job.MaxIters > 0 {
							<span style="font-size: 1rem; color: var(--text-muted);">/ { fmt.Sprintf("%d", job.MaxIters) }</span>
						}
					</div>
					if job.MaxIters > 0 {
						<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
							<span data-metric="iteration-progress">{ fmt.Sprintf("%.1f%%", progressPercent(job.Iterations, job.MaxIters)) }</span> of planned optimizer steps
						</div>
						<div style="margin-top: 0.5rem; background-color: var(--border-color); height: 4px; border-radius: 2px; overflow: hidden;">
							<div id="iteration-progress-bar" style={ fmt.Sprintf("width: %.1f%%; height: 100%%; background-color: var(--primary-color);", progressPercent(job.Iterations, job.MaxIters)) }></div>
						</div>
					}
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">Evaluations</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="evaluations" title={ fmt.Sprintf("%d objective evaluations", job.Evaluations) }>{ formatNumber(float64(job.Evaluations)) }</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Objective function calls</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Throughput
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;" data-metric="cps">
						{ formatNumber(job.CPS) }
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						Evaluated circle candidates/sec
					</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.25rem;">
						Elapsed Time
					</div>
					<div style="font-size: 1.5rem; font-weight: 600;">
						{ formatDuration(job.ElapsedSec) }
					</div>
					<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
						{ formatTimestamp(job.StartTime) }
					</div>
					if job.Termination != "" {
						<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;" data-metric="termination">
							stopped: { job.Termination }
						</div>
					}
				</div>
			</div>
		</div>
			<!-- Configuration Panel -->
			<div class="card detail-configuration" style="margin-bottom: 1.5rem;">
			<h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">
				Configuration
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Mode</div>
					<div style="font-weight: 500; text-transform: capitalize;">{ job.Mode }</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Variant</div>
					<div style="font-weight: 500; text-transform: uppercase;">{ job.Variant }</div>
				</div>
				if job.EvaluationWorkers > 1 {
					<div>
						<div style="font-size: 0.875rem; color: var(--text-muted);">Parallel Evaluation</div>
						<div style="font-weight: 500;">{ fmt.Sprintf("%d workers", job.EvaluationWorkers) }</div>
					</div>
				}
				if job.FastCompositing {
					<div>
						<div style="font-size: 0.875rem; color: var(--text-muted);">Compositing</div>
						<div style="font-weight: 500;">Fast (+/-1 per channel)</div>
					</div>
				}
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Circles</div>
					<div style="font-weight: 500;">{ fmt.Sprintf("%d", job.Circles) }</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Population Size</div>
					<div style="font-weight: 500;">{ fmt.Sprintf("%d", job.PopSize) }</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Optimizer Schedule</div>
					<div style="font-weight: 500;">{ fmt.Sprintf("%d × %d iterations", job.OptimizerEpochs, job.ItersPerEpoch) }</div>
				</div>
				<div>
					<div style="font-size: 0.875rem; color: var(--text-muted);">Active-set Polishing</div>
					if job.PolishingEnabled {
						if job.PolishingOnly {
							<div style="font-weight: 500;">Continuation only · { fmt.Sprintf("up to %d sweeps of %d circles", job.PolishingMaxSweeps, job.PolishingActiveSetSize) }</div>
						} else {
							<div style="font-weight: 500;">Enabled · { fmt.Sprintf("up to %d sweeps of %d circles", job.PolishingMaxSweeps, job.PolishingActiveSetSize) }</div>
						}
						<div style="font-size: 0.75rem; color: var(--text-muted);">{ fmt.Sprintf("%s · population %d · %d × %d iterations · stagnation %d · progress threshold %.4g", job.PolishingStrategy, job.PolishingPopSize, job.PolishingEpochs, job.PolishingIters, job.PolishingStagnationIters, job.PolishingMinImprovement) }</div>
					} else {
						<div style="font-weight: 500;">Disabled</div>
					}
				</div>
				<div style="grid-column: 1 / -1;">
					<div style="font-size: 0.875rem; color: var(--text-muted);">Reference Image</div>
					<div style="font-weight: 500; font-family: monospace; font-size: 0.875rem;">{ job.RefPath }</div>
				</div>
			</div>
		</div>
			<!-- Artifact downloads -->
		<style>
			.download-card { padding: 1rem 1.25rem; }
			.download-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; margin-bottom: 0.75rem; }
			.download-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.download-button { display: inline-flex; flex: 0 1 auto; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.4rem 0.7rem; background: var(--border-color); color: var(--text-color); text-align: center; font: inherit; font-size: 0.8125rem; }
			.download-button:hover { background: var(--secondary-hover); }
			.download-button[aria-disabled="true"], .download-button:disabled { pointer-events: none; cursor: not-allowed; opacity: 0.5; }
			.download-button[aria-busy="true"]::before { content: ""; width: 0.8rem; height: 0.8rem; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin 0.7s linear infinite; }
		</style>
			<div class="card detail-downloads download-card" style="margin-bottom: 1.5rem;">
				<div class="download-header">
					<h2 style="font-size: 1.125rem; font-weight: 600;">Downloads</h2>
					<p style="color: var(--text-muted); font-size: 0.8125rem;">Current immutable result artifacts</p>
				</div>
				<div class="download-grid">
				<a
					class="btn download-button"
					data-result-download
					href={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/best.png?download=1", job.ID)) }
					download={ fmt.Sprintf("job-%s-best.png", job.ID) }
					aria-disabled={ fmt.Sprintf("%t", len(job.Parameters) == 0) }
					tabindex={ parameterTabIndex(len(job.Parameters) > 0) }
				>Best PNG</a>
				<a
					class="btn download-button"
					data-result-download
					href={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/params.json", job.ID)) }
					download={ fmt.Sprintf("job-%s-params.json", job.ID) }
					aria-disabled={ fmt.Sprintf("%t", len(job.Parameters) == 0) }
					tabindex={ parameterTabIndex(len(job.Parameters) > 0) }
				>Parameters JSON</a>
				<a
					id="download-difference"
					class="btn download-button"
					data-result-download
					href={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/diff.png?colormap=turbo&download=1", job.ID)) }
					download={ fmt.Sprintf("job-%s-diff.png", job.ID) }
					aria-disabled={ fmt.Sprintf("%t", len(job.Parameters) == 0) }
					tabindex={ parameterTabIndex(len(job.Parameters) > 0) }
				>Difference PNG</a>
				<button
					id="download-report"
					class="btn download-button"
					data-result-download
					type="button"
					if len(job.Parameters) == 0 {
						disabled
					}
				>HTML Report</button>
			</div>
			<p id="report-download-status" role="status" aria-live="polite" style="min-height: 1rem; margin-top: 0.5rem; color: var(--text-muted); font-size: 0.75rem;"></p>
		</div>
			<!-- Current best parameter viewer -->
		<style>
			.parameter-viewer summary {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				cursor: pointer;
				list-style: none;
			}
			.parameter-viewer summary::-webkit-details-marker {
				display: none;
			}
			.parameter-viewer summary::after {
				content: "▾";
				color: var(--text-muted);
				transition: transform 0.2s;
			}
			.parameter-viewer[open] summary::after {
				transform: rotate(180deg);
			}
			.parameter-list {
				list-style: none;
				max-height: 28rem;
				overflow: auto;
				margin-top: 1rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
			}
			.parameter-list li {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.6rem 0.75rem;
				font-family: monospace;
				font-size: 0.8125rem;
			}
			.parameter-list li + li {
				border-top: 1px solid var(--border-color);
			}
			.parameter-list li:hover {
				background-color: var(--bg-color);
			}
			.parameter-color {
				flex: 0 0 auto;
				width: 1rem;
				height: 1rem;
				border: 1px solid var(--border-color);
				border-radius: 50%;
			}
			.parameter-export[aria-disabled="true"] {
				pointer-events: none;
				opacity: 0.5;
			}
		</style>
			<div class="card detail-parameters" style="margin-bottom: 1.5rem;">
				<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
				<div>
					<h2 style="font-size: 1.25rem; font-weight: 600;">Current Best Parameters</h2>
					<p style="font-size: 0.875rem; color: var(--text-muted);">
						<span id="parameter-count">{ fmt.Sprintf("%d", len(job.Parameters)) }</span> of { fmt.Sprintf("%d", job.Circles) } circles available
					</p>
				</div>
				<a
					id="parameter-export"
					class="btn parameter-export"
					style="background-color: var(--border-color); font-size: 0.875rem;"
					href={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/params.json", job.ID)) }
					download={ fmt.Sprintf("job-%s-params.json", job.ID) }
					aria-disabled={ fmt.Sprintf("%t", len(job.Parameters) == 0) }
					tabindex={ parameterTabIndex(len(job.Parameters) > 0) }
				>
					Download params.json
				</a>
			</div>
			<details id="parameter-viewer" class="parameter-viewer" style="margin-top: 1rem;">
				<summary>
					<span style="font-weight: 600;">Inspect circles</span>
					<span style="font-size: 0.75rem; color: var(--text-muted);">X, Y, radius, RGB, opacity</span>
				</summary>
				<p id="parameter-empty" style={ fmt.Sprintf("display: %s; margin-top: 1rem; color: var(--text-muted); font-size: 0.875rem;", displayValue(len(job.Parameters) == 0)) }>
					No best parameters available yet.
				</p>
				<ol id="parameter-list" class="parameter-list" style={ fmt.Sprintf("display: %s;", displayValue(len(job.Parameters) > 0)) }>
					for _, circle := range job.Parameters {
						<li title={ parameterDescription(circle) }>
							<span class="parameter-color" style={ fmt.Sprintf("background-color: rgba(%d, %d, %d, %.3f);", colorChannel(circle.Red), colorChannel(circle.Green), colorChannel(circle.Blue), circle.Opacity) }></span>
							<span>{ parameterDescription(circle) }</span>
						</li>
					}
				</ol>
			</details>
		</div>
		<!-- Selectable image comparison views -->
		<style>
			.view-mode-selector {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				border: 0;
			}
			.view-mode-selector legend {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}
			.view-mode-option {
				position: relative;
			}
			.view-mode-option input {
				position: absolute;
				opacity: 0;
				pointer-events: none;
			}
			.view-mode-option label {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.4rem 0.7rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				color: var(--text-muted);
				font-size: 0.875rem;
				font-weight: 500;
				cursor: pointer;
				transition: all 0.2s;
			}
			.view-mode-option input:checked + label {
				border-color: var(--primary-color);
				background-color: var(--info-bg);
				color: var(--info-text);
			}
			.view-mode-option input:focus-visible + label {
				outline: 2px solid var(--primary-color);
				outline-offset: 2px;
			}
			.view-mode-shortcut {
				font-family: monospace;
				font-size: 0.75rem;
				opacity: 0.75;
			}
			.image-view-panels {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 2rem;
			}
			.image-view-panel {
				display: none;
				min-width: 0;
			}
			.image-viewer[data-view-mode="reference"] [data-view-panel="reference"],
			.image-viewer[data-view-mode="best"] [data-view-panel="best"],
			.image-viewer[data-view-mode="overlay"] [data-view-panel="overlay"],
			.image-viewer[data-view-mode="difference"] [data-view-panel="difference"],
			.image-viewer[data-view-mode="side-by-side"]
				[data-view-panel="reference"],
			.image-viewer[data-view-mode="side-by-side"] [data-view-panel="best"] {
				display: block;
			}
			.image-viewer[data-view-mode="side-by-side"] .image-view-panels {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
			.image-frame {
				position: relative;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				overflow: hidden;
				background: repeating-conic-gradient(var(--checker-a) 0% 25%, var(--checker-b) 0% 50%)
					50% / 20px 20px;
			}
			.image-frame-difference {
				background: #000000;
			}
			.image-frame-overlay {
				min-height: 6rem;
			}
			.overlay-best-layer {
				position: absolute;
				inset: 0;
			}
			.overlay-best-layer img {
				width: 100%;
				height: 100%;
				object-fit: fill;
				transition: none;
			}
			.image-frame-overlay .image-state {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				padding: 0.5rem 0.75rem;
				border-radius: 0.375rem;
				background-color: var(--surface-color);
			}
			.overlay-heading {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}
			.overlay-opacity-control {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			.overlay-opacity-control input[type="range"] {
				width: 10rem;
				accent-color: var(--primary-color);
			}
			.overlay-opacity-value {
				min-width: 3rem;
				font-family: monospace;
				font-size: 0.8125rem;
				text-align: right;
			}
			.image-frame img {
				width: 100%;
				height: auto;
				display: block;
				transition: opacity 0.3s ease;
			}
			.image-state {
				display: none;
				padding: 2rem;
				text-align: center;
				color: var(--text-muted);
			}
			.image-loading {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
			}
			.image-metadata {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 0.5rem;
				font-size: 0.75rem;
				color: var(--text-muted);
			}
			.heatmap-heading {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}
			.heatmap-colormap-control {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			.heatmap-colormap-control select {
				padding: 0.3rem 0.5rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				background-color: var(--surface-color);
				color: var(--text-color);
			}
			.heatmap-legend {
				display: grid;
				grid-template-columns: auto minmax(120px, 1fr) auto;
				align-items: center;
				gap: 0.5rem;
				margin-top: 0.75rem;
				font-size: 0.75rem;
				color: var(--text-muted);
			}
			.heatmap-legend-gradient {
				height: 0.75rem;
				border: 1px solid var(--border-color);
				border-radius: 9999px;
				background: linear-gradient(
					90deg,
					#23171b,
					#4145ab,
					#2aa7d6,
					#49df75,
					#d5e21a,
					#f68513,
					#900c00
				);
			}
			.heatmap-legend-description {
				grid-column: 1 / -1;
				text-align: center;
			}
			@media (max-width: 768px) {
				.image-viewer[data-view-mode="side-by-side"] .image-view-panels {
					grid-template-columns: minmax(0, 1fr);
				}
			}
		</style>
		<div id="image-viewer" class="card image-viewer detail-images" data-view-mode="side-by-side" data-job-id={ job.ID } data-job-state={ job.State } data-max-iters={ fmt.Sprintf("%d", job.MaxIters) } data-best-revision={ fmt.Sprintf("%d", job.BestRevision) }>
			<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem;">
				<h2 style="font-size: 1.25rem; font-weight: 600;">
					Images
				</h2>
				<fieldset class="view-mode-selector" aria-label="Image view mode">
					<legend>Image view mode</legend>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-reference" name="view-mode" value="reference" aria-keyshortcuts="1"/>
						<label for="view-mode-reference">Reference <span class="view-mode-shortcut" aria-hidden="true">1</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-best" name="view-mode" value="best" aria-keyshortcuts="2"/>
						<label for="view-mode-best">Best <span class="view-mode-shortcut" aria-hidden="true">2</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-side-by-side" name="view-mode" value="side-by-side" aria-keyshortcuts="3" checked/>
						<label for="view-mode-side-by-side">Side-by-Side <span class="view-mode-shortcut" aria-hidden="true">3</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-difference" name="view-mode" value="difference" aria-keyshortcuts="4"/>
						<label for="view-mode-difference">Difference <span class="view-mode-shortcut" aria-hidden="true">4</span></label>
					</div>
					<div class="view-mode-option">
						<input type="radio" id="view-mode-overlay" name="view-mode" value="overlay" aria-keyshortcuts="5"/>
						<label for="view-mode-overlay">Overlay <span class="view-mode-shortcut" aria-hidden="true">5</span></label>
					</div>
				</fieldset>
			</div>
			<div class="image-view-panels">
				<!-- Reference Image -->
				<div class="image-view-panel" data-view-panel="reference">
					<h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-muted);">
						Reference
					</h3>
					<div class="image-frame">
						<img
							id="reference-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/ref.png", job.ID)) }
							alt="Reference Image"
						/>
						<div id="reference-image-loading" class="image-state image-loading">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="reference-image-error" class="image-state">
							Reference image not available
						</div>
					</div>
					<div class="image-metadata" aria-label="Reference image metadata">
						if job.RefWidth > 0 && job.RefHeight > 0 {
							<span>{ fmt.Sprintf("%d × %d px", job.RefWidth, job.RefHeight) }</span>
						}
						if job.RefSize > 0 {
							<span title={ fmt.Sprintf("%d bytes", job.RefSize) }>{ formatFileSize(job.RefSize) }</span>
						}
						if job.RefWidth <= 0 && job.RefHeight <= 0 && job.RefSize <= 0 {
							<span>Metadata unavailable</span>
						}
					</div>
				</div>
				<!-- Current Best Image -->
				<div class="image-view-panel" data-view-panel="best">
					<h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-muted);">
						Current Best
					</h3>
					<div class="image-frame">
						<img
							id="best-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/best.png?v=%d", job.ID, job.BestRevision)) }
							alt="Current Best Image"
						/>
						<div id="best-image-loading" class="image-state image-loading">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="best-image-error" class="image-state">
							if job.State == "pending" {
								Optimization not started yet
							} else {
								No results yet
							}
						</div>
					</div>
				</div>
				<!-- Difference Image -->
				<div class="image-view-panel" data-view-panel="difference">
					<div class="heatmap-heading">
						<h3 style="font-size: 1rem; font-weight: 600; color: var(--text-muted);">
							Difference Heatmap
						</h3>
						<label class="heatmap-colormap-control" for="heatmap-colormap">
							Colormap
							<select id="heatmap-colormap">
								<option value="turbo" selected>Turbo</option>
								<option value="magma">Magma</option>
							</select>
						</label>
					</div>
					<div class="image-frame image-frame-difference">
						<img
							id="diff-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/diff.png?colormap=turbo&v=%d", job.ID, job.BestRevision)) }
							alt="False-color difference heatmap"
						/>
						<div id="diff-image-loading" class="image-state image-loading" style="color: #cccccc;">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="diff-image-error" class="image-state" style="color: #cccccc;">
							if job.State == "pending" {
								Not available yet
							} else {
								No results yet
							}
						</div>
					</div>
					<div class="heatmap-legend" role="img" aria-label="Mean absolute RGB error scale from 0 to 255">
						<span>0</span>
						<div id="heatmap-legend-gradient" class="heatmap-legend-gradient"></div>
						<span>255</span>
						<span class="heatmap-legend-description">Mean absolute RGB error per pixel</span>
					</div>
				</div>
				<!-- Best blended over Reference -->
				<div class="image-view-panel" data-view-panel="overlay">
					<div class="overlay-heading">
						<h3 style="font-size: 1rem; font-weight: 600; color: var(--text-muted);">
							Best over Reference
						</h3>
						<div class="overlay-opacity-control">
							<label for="overlay-opacity">Best opacity</label>
							<input
								type="range"
								id="overlay-opacity"
								min="0"
								max="100"
								step="1"
								value="50"
								aria-label="Best image opacity in percent"
							/>
							<output id="overlay-opacity-value" class="overlay-opacity-value" for="overlay-opacity" aria-live="off">50%</output>
						</div>
					</div>
					<div class="image-frame image-frame-overlay">
						<img
							id="overlay-reference-image"
							src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/ref.png", job.ID)) }
							alt="Reference image underlay"
						/>
						<div id="overlay-best-layer" class="overlay-best-layer" style="opacity: 0.5;">
							<img
								id="overlay-best-image"
								src={ templ.URL(fmt.Sprintf("/api/v1/jobs/%s/best.png?v=%d", job.ID, job.BestRevision)) }
								alt="Current best image blended over the reference"
							/>
						</div>
						<div id="overlay-best-image-loading" class="image-state image-loading">
							<div class="spinner"></div>
							<p style="margin-top: 0.5rem; font-size: 0.875rem;">Loading...</p>
						</div>
						<div id="overlay-best-image-error" class="image-state">
							if job.State == "pending" {
								Optimization not started yet
							} else {
								No results yet
							}
						</div>
					</div>
					<p style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--text-muted);">
						Drag the slider to blend the current best render over the reference. 0% shows the reference alone, 100% the best render alone.
					</p>
				</div>
			</div>
			</div>

			<!-- Metric history, immediately after the images -->
			<div id="metric-history-card" class="card detail-history" style="margin-bottom: 1.5rem;">
				<div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem;">
					<div>
						<h2 style="font-size: 1.25rem; font-weight: 600;">Metric History</h2>
						<p style="font-size: 0.8125rem; color: var(--text-muted);">Quality over optimizer iterations</p>
					</div>
					if len(job.MetricHistory) > 0 {
						<button id="sparkline-toggle" class="btn" style="font-size: 0.8125rem; padding: 0.35rem 0.7rem; background-color: var(--border-color);">Hide History</button>
					} else {
						<button id="sparkline-toggle" class="btn" style="display: none; font-size: 0.8125rem; padding: 0.35rem 0.7rem; background-color: var(--border-color);">Hide History</button>
					}
				</div>
				<p id="metric-history-empty" style={ fmt.Sprintf("display: %s; color: var(--text-muted); font-size: 0.875rem;", displayValue(len(job.MetricHistory) == 0)) }>No metric samples yet. History will appear when optimization begins.</p>
				<div id="cost-sparkline-container" style={ fmt.Sprintf("display: %s; padding: 1rem; background-color: var(--bg-color); border-radius: 0.375rem;", displayValue(len(job.MetricHistory) > 0)) }>
					<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
						<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;">
							<label for="metric-history-series" style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted);">Metric
								<select id="metric-history-series" style="margin-left: 0.35rem; padding: 0.3rem 0.5rem; border: 1px solid var(--border-color); border-radius: 0.25rem; background: var(--control-bg);">
									<option value="cost">Cost</option>
									<option value="psnr">PSNR</option>
									if job.SSIMEnabled {
										<option value="ssim">SSIM</option>
									}
								</select>
							</label>
							<label for="metric-history-window" style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted);">Window
								<select id="metric-history-window" style="margin-left: 0.35rem; padding: 0.3rem 0.5rem; border: 1px solid var(--border-color); border-radius: 0.25rem; background: var(--control-bg);">
									<option value="all" selected>All samples</option>
									<option value="100">Last 100</option><option value="250">Last 250</option><option value="500">Last 500</option><option value="1000">Last 1,000</option>
								</select>
							</label>
						</div>
						<div id="sparkline-stats" style="font-size: 0.75rem; color: var(--text-muted);">Showing <span id="sparkline-samples">0</span> of <span id="sparkline-total-samples">0</span> samples</div>
					</div>
					<svg id="cost-sparkline" width="100%" height="280" tabindex="0" role="img" aria-label="Metric history chart" style="display: block; border: 1px solid var(--border-color); border-radius: 0.25rem; background-color: var(--control-bg); font-family: inherit; touch-action: none;">
						<g id="sparkline-grid"></g><g id="sparkline-axes"></g>
						<polyline id="sparkline-line" fill="none" stroke="var(--primary-color)" stroke-width="2"></polyline>
						<circle id="sparkline-dot" r="3" fill="var(--primary-color)" style="display: none;"></circle>
						<g id="sparkline-hover-layer" style="display: none; pointer-events: none;"><line id="sparkline-hover-line" stroke="var(--text-muted)" stroke-width="1" stroke-dasharray="3 3"></line><circle id="sparkline-hover-dot" r="4" fill="var(--primary-color)" stroke="var(--surface-color)" stroke-width="2"></circle></g>
						<text id="sparkline-empty" text-anchor="middle" fill="var(--text-muted)" style="display: none; font-size: 13px;">No samples available</text>
					</svg>
					<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; margin-top: 0.5rem; font-size: 0.75rem; color: var(--text-muted);">
						<span>Start: <span id="sparkline-start">-</span></span><span>Current: <span id="sparkline-current">-</span></span><span><span id="sparkline-best-label">Min</span>: <span id="sparkline-min">-</span></span>
						<span id="sparkline-hover-readout" aria-live="polite">Move over the chart for an exact value</span>
					</div>
				</div>
			</div>
		</div>
		@templ.JSONScript("metric-history-data", job.MetricHistory)
		@templ.JSONScript("parameter-data", job.Parameters)
		<!-- SSE for live updates -->
		<script>
			(function () {
				const imageViewer = document.getElementById("image-viewer");
				const jobId = imageViewer.dataset.jobId;
				const jobState = imageViewer.dataset.jobState;
				const maxIters = Number.parseInt(imageViewer.dataset.maxIters, 10) || 0;
				let lastRenderedBestRevision =
					Number.parseInt(imageViewer.dataset.bestRevision, 10) || 0;
				const viewStorageKey = "mayflycirclefit.viewMode";
				const overlayStorageKey = "mayflycirclefit.overlayOpacity";
				const viewModes = [
					"reference",
					"best",
					"side-by-side",
					"difference",
					"overlay",
				];
				const shortcutViews = {
					1: "reference",
					2: "best",
					3: "side-by-side",
					4: "difference",
					5: "overlay",
				};
				let parameterRefreshPending = false;

				initializeViewMode();
				initializeImageState(
					"reference-image",
					"reference-image-loading",
					"reference-image-error",
				);
				initializeImageState(
					"best-image",
					"best-image-loading",
					"best-image-error",
				);
				initializeImageState(
					"diff-image",
					"diff-image-loading",
					"diff-image-error",
				);
				initializeImageState(
					"overlay-best-image",
					"overlay-best-image-loading",
					"overlay-best-image-error",
				);
				initializeHeatmapColormap();
				initializeOverlayOpacity();
				initializeParameterViewer();
				initializeDownloadControls();
				initializePolishControl();

				// Server-seeded quality history for the selectable chart.
				let metricHistory = [];
				const historyData = document.getElementById("metric-history-data");
				if (historyData) {
					try {
						metricHistory = JSON.parse(historyData.textContent) || [];
					} catch (err) {
						console.error("Unable to parse metric history:", err);
					}
				}

				// History chart controls
				const toggleBtn = document.getElementById("sparkline-toggle");
				const sparklineContainer = document.getElementById(
					"cost-sparkline-container",
				);
				const metricSeries = document.getElementById("metric-history-series");
				const metricWindow = document.getElementById("metric-history-window");
				let sparklineVisible = metricHistory.length > 0;
				let sparklineInteraction = null;

				if (toggleBtn) {
					toggleBtn.addEventListener("click", function () {
						sparklineVisible = !sparklineVisible;
						sparklineContainer.style.display = sparklineVisible
							? "block"
							: "none";
						toggleBtn.textContent = sparklineVisible
							? "Hide History"
							: "Show History";
						if (sparklineVisible) {
							updateSparkline();
						}
					});
				}
				if (metricSeries) {
					metricSeries.addEventListener("change", updateSparkline);
				}
				if (metricWindow) {
					metricWindow.addEventListener("change", updateSparkline);
				}
				const sparkline = document.getElementById("cost-sparkline");
				if (sparkline) {
					sparkline.addEventListener("pointermove", updateSparklineHover);
					sparkline.addEventListener("pointerleave", clearSparklineHover);
					sparkline.addEventListener("focus", showLatestSparklinePoint);
				}
				window.addEventListener("resize", function () {
					if (sparklineVisible) updateSparkline();
				});
				if (sparklineVisible) updateSparkline();

				function initializeViewMode() {
					const controls = document.querySelectorAll('input[name="view-mode"]');
					controls.forEach(function (control) {
						control.addEventListener("change", function () {
							if (control.checked) {
								applyViewMode(control.value, true);
							}
						});
					});

					let initialMode = "side-by-side";
					try {
						const storedMode = window.localStorage.getItem(viewStorageKey);
						if (viewModes.includes(storedMode)) {
							initialMode = storedMode;
						}
					} catch (err) {
						// Storage can be unavailable in privacy-restricted browser contexts.
					}
					applyViewMode(initialMode, false);

					document.addEventListener("keydown", function (event) {
						if (
							event.defaultPrevented ||
							event.altKey ||
							event.ctrlKey ||
							event.metaKey ||
							event.shiftKey
						) {
							return;
						}
						const target = event.target;
						if (
							target &&
							(target.isContentEditable ||
								["INPUT", "SELECT", "TEXTAREA"].includes(target.tagName))
						) {
							return;
						}
						const mode = shortcutViews[event.key];
						if (!mode) {
							return;
						}
						event.preventDefault();
						applyViewMode(mode, true);
					});
				}

				function applyViewMode(mode, persist) {
					if (!viewModes.includes(mode)) {
						mode = "side-by-side";
					}
					const viewer = document.getElementById("image-viewer");
					if (!viewer) {
						return;
					}
					viewer.dataset.viewMode = mode;
					const control = document.querySelector(
						'input[name="view-mode"][value="' + mode + '"]',
					);
					if (control) {
						control.checked = true;
					}
					if (persist) {
						try {
							window.localStorage.setItem(viewStorageKey, mode);
						} catch (err) {
							// The selected view still applies for the current page.
						}
					}
				}

				// Only connect SSE if job is running or pending
				if (jobState === "running" || jobState === "pending") {
					const eventSource = new EventSource(
						"/api/v1/jobs/" + jobId + "/stream",
					);

					eventSource.onmessage = function (event) {
						const data = JSON.parse(event.data);
						const bestChanged =
							typeof data.bestRevision === "number" &&
							data.bestRevision > lastRenderedBestRevision;

						// Update metrics
						updateMetric("best-cost", data.bestCost.toFixed(4));
						updateCandidateMetrics(data);
						updateMetric("iterations", data.iterations);
						updateMetric("evaluations", formatNumber(data.evaluations));
						updateIterationProgress(data.iterations);
						updateMetric("cps", formatNumber(data.cps));
						if (data.psnrInfinite) {
							updateMetric("psnr", "∞");
						} else if (typeof data.psnr === "number") {
							updateMetric("psnr", data.psnr.toFixed(2));
						}
						if (typeof data.ssim === "number") {
							updateMetric("ssim", data.ssim.toFixed(4));
						}

						addMetricSample(data);
						refreshParameterViewer();

						// If job completed, reload to update images
						if (
							data.state === "completed" ||
							data.state === "failed" ||
							data.state === "cancelled"
						) {
							eventSource.close();
							location.reload();
						} else if (bestChanged) {
							lastRenderedBestRevision = data.bestRevision;
							// Refresh images with cache busting and loading states
							refreshImage(
								"best-image",
								"best-image-loading",
								jobId,
								"best.png",
								lastRenderedBestRevision,
							);
							refreshImage(
								"overlay-best-image",
								"overlay-best-image-loading",
								jobId,
								"best.png",
								lastRenderedBestRevision,
							);
							refreshImage(
								"diff-image",
								"diff-image-loading",
								jobId,
								"diff.png",
								lastRenderedBestRevision,
								selectedHeatmapColormap(),
							);
						}
					};

					eventSource.onerror = function (err) {
						console.error("SSE connection error:", err);
						eventSource.close();
						// Fallback to polling after 5 seconds
						setTimeout(function () {
							location.reload();
						}, 5000);
					};
				}

				function updateMetric(id, value) {
					const elements = document.querySelectorAll(
						'[data-metric="' + id + '"]',
					);
					elements.forEach(function (el) {
						el.textContent = value;
					});
				}

				function updateCandidateMetrics(data) {
					const panel = document.getElementById("candidate-metrics");
					if (!panel) return;
					if (typeof data.candidateCost !== "number") {
						panel.style.display = "none";
						return;
					}
					panel.style.display = "block";
					updateMetric("candidate-cost", data.candidateCost.toFixed(4));
					const gain = data.bestCost - data.candidateCost;
					const percent = data.bestCost > 0 ? (gain / data.bestCost) * 100 : 0;
					updateMetric("candidate-gain", "↓ " + gain.toFixed(4) + " (" + percent.toFixed(2) + "%) provisional gain");
					if (data.candidatePsnrInfinite) {
						updateMetric("candidate-psnr", "∞");
					} else if (typeof data.candidatePsnr === "number") {
						updateMetric("candidate-psnr", data.candidatePsnr.toFixed(2));
					}
				}

				function updateIterationProgress(iterations) {
					if (maxIters <= 0) return;
					const percent = Math.max(0, Math.min(100, (iterations / maxIters) * 100));
					updateMetric("iteration-progress", percent.toFixed(1) + "%");
					const bar = document.getElementById("iteration-progress-bar");
					if (bar) bar.style.width = percent.toFixed(1) + "%";
				}

				function initializeParameterViewer() {
					const viewer = document.getElementById("parameter-viewer");
					if (!viewer) return;
					viewer.addEventListener("toggle", function () {
						if (viewer.open) refreshParameterViewer();
					});

					const data = document.getElementById("parameter-data");
					if (!data) return;
					try {
						const circles = JSON.parse(data.textContent) || [];
						if (circles.length > 0) renderParameters(circles);
					} catch (err) {
						console.error("Unable to parse parameter data:", err);
					}
				}

				function initializeDownloadControls() {
					const reportButton = document.getElementById("download-report");
					if (reportButton) {
						reportButton.addEventListener("click", downloadReport);
					}
					syncArtifactDownloadColormap();
				}

				function initializePolishControl() {
					const button = document.getElementById("polish-job");
					if (!button) return;
					button.addEventListener("click", async function () {
						button.disabled = true;
						button.textContent = "Starting polishing…";
						try {
							const response = await fetch("/api/v1/jobs/" + jobId + "/polish", { method: "POST" });
							const payload = await response.json();
							if (!response.ok) throw new Error(payload.message || "Unable to start polishing");
							window.location.assign("/jobs/" + payload.jobId);
						} catch (err) {
							window.alert(err.message || "Unable to start polishing");
							button.disabled = false;
							button.textContent = "Polish weak circles";
						}
					});
				}

				function syncArtifactDownloadColormap() {
					const differenceLink = document.getElementById("download-difference");
					if (!differenceLink) return;
					differenceLink.href =
						"/api/v1/jobs/" + jobId + "/diff.png?colormap=" +
						encodeURIComponent(selectedHeatmapColormap()) + "&download=1";
				}

				async function downloadReport() {
					const button = document.getElementById("download-report");
					const status = document.getElementById("report-download-status");
					if (!button || button.disabled) return;

					button.disabled = true;
					button.setAttribute("aria-busy", "true");
					const originalText = button.textContent;
					button.textContent = "Generating report…";
					if (status) status.textContent = "Rendering images and assembling report…";
					try {
						const response = await fetch(
							"/api/v1/jobs/" + jobId + "/report.html?colormap=" +
							encodeURIComponent(selectedHeatmapColormap()),
							{ cache: "no-store" },
						);
						if (!response.ok) throw new Error("HTTP " + response.status);
						const blob = await response.blob();
						const objectURL = URL.createObjectURL(blob);
						const link = document.createElement("a");
						link.href = objectURL;
						link.download = "job-" + jobId + "-report.html";
						document.body.appendChild(link);
						link.click();
						link.remove();
						setTimeout(function () { URL.revokeObjectURL(objectURL); }, 1000);
						if (status) status.textContent = "Report download ready.";
					} catch (err) {
						console.error("Unable to generate report:", err);
						if (status) status.textContent = "Report generation failed. Please try again.";
					} finally {
						button.removeAttribute("aria-busy");
						button.textContent = originalText;
						button.disabled = false;
					}
				}

				async function refreshParameterViewer() {
					const viewer = document.getElementById("parameter-viewer");
					if (!viewer || !viewer.open || parameterRefreshPending) return;
					parameterRefreshPending = true;
					try {
						const response = await fetch(
							"/api/v1/jobs/" + jobId + "/params.json",
							{ cache: "no-store", headers: { Accept: "application/json" } },
						);
						if (response.status === 404) return;
						if (!response.ok) throw new Error("HTTP " + response.status);
						const snapshot = await response.json();
						renderParameters(snapshot.circles || []);
					} catch (err) {
						console.error("Unable to refresh parameters:", err);
					} finally {
						parameterRefreshPending = false;
					}
				}

				function renderParameters(circles) {
					const list = document.getElementById("parameter-list");
					const empty = document.getElementById("parameter-empty");
					const count = document.getElementById("parameter-count");
					const exportLink = document.getElementById("parameter-export");
					if (!list || !empty || !count) return;

					list.replaceChildren();
					circles.forEach(function (circle) {
						const description = formatParameter(circle);
						const item = document.createElement("li");
						item.title = description;
						const swatch = document.createElement("span");
						swatch.className = "parameter-color";
						swatch.style.backgroundColor =
							"rgba(" +
							colorChannel(circle.red) + ", " +
							colorChannel(circle.green) + ", " +
							colorChannel(circle.blue) + ", " +
							circle.opacity.toFixed(3) + ")";
						const text = document.createElement("span");
						text.textContent = description;
						item.append(swatch, text);
						list.appendChild(item);
					});

					count.textContent = circles.length;
					list.style.display = circles.length > 0 ? "block" : "none";
					empty.style.display = circles.length > 0 ? "none" : "block";
					if (exportLink) {
						exportLink.setAttribute(
							"aria-disabled",
							circles.length > 0 ? "false" : "true",
						);
						exportLink.tabIndex = circles.length > 0 ? 0 : -1;
					}
					updateResultDownloads(circles.length > 0);
				}

				function updateResultDownloads(available) {
					document.querySelectorAll("[data-result-download]").forEach(function (control) {
						if (control.tagName === "BUTTON") {
							control.disabled =
								!available || control.getAttribute("aria-busy") === "true";
						} else {
							control.setAttribute("aria-disabled", available ? "false" : "true");
							control.tabIndex = available ? 0 : -1;
						}
					});
				}

				function formatParameter(circle) {
					return (
						"Circle " + circle.number + ": (" +
						circle.x.toFixed(2) + ", " +
						circle.y.toFixed(2) + ", " +
						circle.radius.toFixed(2) + ") RGB(" +
						colorChannel(circle.red) + ", " +
						colorChannel(circle.green) + ", " +
						colorChannel(circle.blue) + ") α=" +
						circle.opacity.toFixed(3)
					);
				}

				function colorChannel(value) {
					return Math.round(Math.min(1, Math.max(0, value)) * 255);
				}

				function formatNumber(n) {
					if (n >= 1000000) {
						return (n / 1000000).toFixed(1) + "M";
					} else if (n >= 1000) {
						return (n / 1000).toFixed(1) + "K";
					} else {
						return Math.round(n).toString();
					}
				}

				function refreshImage(
					imgId,
					loadingId,
					jobId,
					filename,
					revision,
					colormap,
				) {
					const img = document.getElementById(imgId);
					const loading = document.getElementById(loadingId);
					const error = document.getElementById(imgId + "-error");

					if (!img) return;

					// Keep the last successful image visible while preloading its replacement.
					if (loading) {
						loading.style.display = "block";
					}
					if (img.naturalWidth > 0) {
						img.style.display = "block";
						img.style.opacity = "0.5";
					}

					// Create new image to preload
					const newImg = new Image();
					newImg.onload = function () {
						img.src = newImg.src;
						img.style.display = "block";
						img.style.opacity = "1";
						if (loading) {
							loading.style.display = "none";
						}
						if (error) {
							error.style.display = "none";
						}
					};
					newImg.onerror = function () {
						// Keep a prior successful image; otherwise retain the empty-state message.
						img.style.opacity = "1";
						if (loading) {
							loading.style.display = "none";
						}
						if (img.naturalWidth === 0) {
							showImageError(img, error);
						}
					};
					let imageURL =
						"/api/v1/jobs/" + jobId + "/" + filename + "?v=" + revision;
					if (colormap) {
						imageURL += "&colormap=" + encodeURIComponent(colormap);
					}
					newImg.src = imageURL;
				}

				function initializeHeatmapColormap() {
					const select = document.getElementById("heatmap-colormap");
					if (!select) {
						return;
					}
					select.addEventListener("change", function () {
						updateHeatmapLegend(select.value);
						syncArtifactDownloadColormap();
						refreshImage(
							"diff-image",
							"diff-image-loading",
							jobId,
							"diff.png",
							lastRenderedBestRevision,
							select.value,
						);
					});
					updateHeatmapLegend(select.value);
				}

				function initializeOverlayOpacity() {
					const slider = document.getElementById("overlay-opacity");
					const layer = document.getElementById("overlay-best-layer");
					const readout = document.getElementById("overlay-opacity-value");
					if (!slider || !layer) {
						return;
					}

					let initialPercent = clampOverlayPercent(
						Number.parseInt(slider.value, 10),
					);
					try {
						const stored = window.localStorage.getItem(overlayStorageKey);
						if (stored !== null) {
							const parsed = Number.parseInt(stored, 10);
							if (Number.isFinite(parsed)) {
								initialPercent = clampOverlayPercent(parsed);
							}
						}
					} catch (err) {
						// Storage can be unavailable in privacy-restricted browser contexts.
					}
					applyOverlayOpacity(initialPercent, false);

					slider.addEventListener("input", function () {
						applyOverlayOpacity(
							clampOverlayPercent(Number.parseInt(slider.value, 10)),
							true,
						);
					});

					function applyOverlayOpacity(percent, persist) {
						slider.value = String(percent);
						layer.style.opacity = String(percent / 100);
						if (readout) {
							readout.textContent = percent + "%";
						}
						if (!persist) {
							return;
						}
						try {
							window.localStorage.setItem(overlayStorageKey, String(percent));
						} catch (err) {
							// The chosen blend still applies for the current page.
						}
					}
				}

				function clampOverlayPercent(percent) {
					if (!Number.isFinite(percent)) {
						return 50;
					}
					return Math.min(100, Math.max(0, Math.round(percent)));
				}

				function selectedHeatmapColormap() {
					const select = document.getElementById("heatmap-colormap");
					return select ? select.value : "turbo";
				}

				function updateHeatmapLegend(colormap) {
					const gradient = document.getElementById("heatmap-legend-gradient");
					if (!gradient) {
						return;
					}
					if (colormap === "magma") {
						gradient.style.background =
							"linear-gradient(90deg, #000004, #180f3d, #3d0f70, #65156e, #8c2961, #b7374b, #de492f, #f67019, #fda50a, #f9dc5c, #fcfdbf)";
					} else {
						gradient.style.background =
							"linear-gradient(90deg, #23171b, #4145ab, #2aa7d6, #49df75, #d5e21a, #f68513, #900c00)";
					}
				}

				function initializeImageState(imgId, loadingId, errorId) {
					const img = document.getElementById(imgId);
					const loading = document.getElementById(loadingId);
					const error = document.getElementById(errorId);
					if (!img) {
						return;
					}
					img.addEventListener("load", function () {
						img.style.display = "block";
						img.style.opacity = "1";
						if (loading) loading.style.display = "none";
						if (error) error.style.display = "none";
					});
					img.addEventListener("error", function () {
						if (loading) loading.style.display = "none";
						showImageError(img, error);
					});
					if (img.complete) {
						if (img.naturalWidth > 0) {
							img.style.display = "block";
							if (error) error.style.display = "none";
						} else {
							showImageError(img, error);
						}
					}
				}

				function showImageError(img, error) {
					img.style.display = "none";
					if (error) {
						error.style.display = "block";
					}
				}

				function addMetricSample(data) {
					const firstSample = metricHistory.length === 0;
					metricHistory.push({
						iteration: data.iterations,
						cost: data.bestCost,
						psnr: typeof data.psnr === "number" ? data.psnr : null,
						psnrInfinite: data.psnrInfinite === true,
						ssim: typeof data.ssim === "number" ? data.ssim : null,
					});
					if (firstSample) {
						sparklineVisible = true;
						const emptyState = document.getElementById("metric-history-empty");
						if (emptyState) emptyState.style.display = "none";
						if (sparklineContainer) sparklineContainer.style.display = "block";
						if (toggleBtn) toggleBtn.style.display = "inline-flex";
					}
					if (sparklineVisible) updateSparkline();
				}

				function selectedMetricPoints() {
					const series = metricSeries ? metricSeries.value : "cost";
					const allPoints = metricHistory
						.map(function (sample) {
							const value = sample[series];
							return typeof value === "number" && Number.isFinite(value)
								? { iteration: sample.iteration, value: value }
								: null;
						})
						.filter(function (point) {
							return point !== null;
						});
					const windowValue = metricWindow ? metricWindow.value : "all";
					const windowSize = Number.parseInt(windowValue, 10);
					const points = Number.isFinite(windowSize)
						? allPoints.slice(-windowSize)
						: allPoints;
					return {
						series: series,
						points: points,
						total: allPoints.length,
					};
				}

				function formatMetricValue(series, value) {
					if (series === "psnr") return value.toFixed(2) + " dB";
					return value.toFixed(4);
				}

				function formatAxisValue(series, value) {
					const magnitude = Math.abs(value);
					if (magnitude !== 0 && (magnitude >= 10000 || magnitude < 0.001)) {
						return value.toExponential(2);
					}
					if (series === "ssim") return value.toFixed(3);
					if (series === "psnr") return value.toFixed(1);
					return value.toFixed(magnitude < 10 ? 3 : 1);
				}

				function appendSVG(parent, tag, attributes, text) {
					const element = document.createElementNS("http://www.w3.org/2000/svg", tag);
					Object.entries(attributes).forEach(function (entry) {
						element.setAttribute(entry[0], entry[1]);
					});
					if (text !== undefined) element.textContent = text;
					parent.appendChild(element);
					return element;
				}

				function updateSparkline() {
					const svg = document.getElementById("cost-sparkline");
					const line = document.getElementById("sparkline-line");
					const dot = document.getElementById("sparkline-dot");
					const grid = document.getElementById("sparkline-grid");
					const axes = document.getElementById("sparkline-axes");
					const empty = document.getElementById("sparkline-empty");
					if (!svg || !line || !grid || !axes || !empty) return;
					const selected = selectedMetricPoints();
					const points = selected.points;
					const values = points.map(function (point) { return point.value; });
					document.getElementById("sparkline-samples").textContent =
						values.length;
					document.getElementById("sparkline-total-samples").textContent =
						selected.total;
					document.getElementById("sparkline-best-label").textContent =
						selected.series === "cost" ? "Min" : "Max";
					grid.replaceChildren();
					axes.replaceChildren();
					const width = Math.max(480, Math.round(svg.clientWidth || 960));
					const height = 280;
					const margin = { top: 18, right: 18, bottom: 48, left: 76 };
					const plotWidth = width - margin.left - margin.right;
					const plotHeight = height - margin.top - margin.bottom;
					svg.setAttribute("viewBox", "0 0 " + width + " " + height);
					empty.setAttribute("x", width / 2);
					empty.setAttribute("y", height / 2);
					if (values.length === 0) {
						sparklineInteraction = null;
						line.setAttribute("points", "");
						dot.style.display = "none";
						empty.style.display = "block";
						document.getElementById("sparkline-start").textContent = "-";
						document.getElementById("sparkline-current").textContent = "-";
						document.getElementById("sparkline-min").textContent = "-";
						return;
					}
					empty.style.display = "none";

					const minimum = Math.min(...values);
					const maximum = Math.max(...values);
					const rawRange = maximum - minimum;
					const yPadding = rawRange === 0 ? Math.max(Math.abs(maximum) * 0.05, 1) : rawRange * 0.05;
					const yMinimum = minimum - yPadding;
					const yMaximum = maximum + yPadding;
					const yRange = yMaximum - yMinimum;
					const xMinimum = points[0].iteration;
					const xMaximum = points[points.length - 1].iteration;
					const xRange = xMaximum - xMinimum;
					const xPosition = function (iteration) {
						if (xRange === 0) return margin.left + plotWidth / 2;
						return margin.left + ((iteration - xMinimum) / xRange) * plotWidth;
					};
					const yPosition = function (value) {
						return margin.top + ((yMaximum - value) / yRange) * plotHeight;
					};
					sparklineInteraction = { series: selected.series, points: points, xPosition: xPosition, yPosition: yPosition, margin: margin, height: height, width: width };

					const tickCount = 5;
					for (let i = 0; i < tickCount; i++) {
						const fraction = i / (tickCount - 1);
						const y = margin.top + fraction * plotHeight;
						const yValue = yMaximum - fraction * yRange;
						appendSVG(grid, "line", { x1: margin.left, y1: y, x2: width - margin.right, y2: y, stroke: "var(--border-color)", "stroke-width": 1 });
						appendSVG(axes, "text", { x: margin.left - 10, y: y + 4, "text-anchor": "end", fill: "var(--text-muted)", "font-size": 11 }, formatAxisValue(selected.series, yValue));
					}
					const xTickCount = xRange === 0 ? 1 : tickCount;
					for (let i = 0; i < xTickCount; i++) {
						const fraction = xTickCount === 1 ? 0.5 : i / (xTickCount - 1);
						const x = margin.left + fraction * plotWidth;
						const iteration = Math.round(xMinimum + fraction * xRange);
						appendSVG(grid, "line", { x1: x, y1: margin.top, x2: x, y2: height - margin.bottom, stroke: "var(--grid-color)", "stroke-width": 1 });
						appendSVG(axes, "text", { x: x, y: height - margin.bottom + 19, "text-anchor": "middle", fill: "var(--text-muted)", "font-size": 11 }, iteration.toLocaleString());
					}
					appendSVG(axes, "line", { x1: margin.left, y1: margin.top, x2: margin.left, y2: height - margin.bottom, stroke: "var(--text-muted)", "stroke-width": 1 });
					appendSVG(axes, "line", { x1: margin.left, y1: height - margin.bottom, x2: width - margin.right, y2: height - margin.bottom, stroke: "var(--text-muted)", "stroke-width": 1 });
					appendSVG(axes, "text", { x: margin.left + plotWidth / 2, y: height - 10, "text-anchor": "middle", fill: "var(--text-muted)", "font-size": 12, "font-weight": 600 }, "Iteration");
					const yLabel = selected.series === "psnr" ? "PSNR (dB)" : selected.series.toUpperCase();
					appendSVG(axes, "text", { x: 16, y: margin.top + plotHeight / 2, "text-anchor": "middle", fill: "var(--text-muted)", "font-size": 12, "font-weight": 600, transform: "rotate(-90 16 " + (margin.top + plotHeight / 2) + ")" }, yLabel);

					const linePoints = values
						.map((value, i) => {
							return xPosition(selected.points[i].iteration) + "," + yPosition(value);
						})
						.join(" ");
					line.setAttribute("points", linePoints);
					const lastValue = values[values.length - 1];
					dot.setAttribute("cx", xPosition(selected.points[selected.points.length - 1].iteration));
					dot.setAttribute("cy", yPosition(lastValue));
					dot.style.display = "block";
					document.getElementById("sparkline-start").textContent =
						formatMetricValue(selected.series, values[0]);
					document.getElementById("sparkline-current").textContent =
						formatMetricValue(selected.series, lastValue);
					const best = selected.series === "cost" ? minimum : maximum;
					document.getElementById("sparkline-min").textContent =
						formatMetricValue(selected.series, best);
					showLatestSparklinePoint();
				}

				function renderSparklineHover(point) {
					if (!sparklineInteraction || !point) return;
					const layer = document.getElementById("sparkline-hover-layer");
					const line = document.getElementById("sparkline-hover-line");
					const dot = document.getElementById("sparkline-hover-dot");
					const x = sparklineInteraction.xPosition(point.iteration);
					const y = sparklineInteraction.yPosition(point.value);
					line.setAttribute("x1", x); line.setAttribute("x2", x);
					line.setAttribute("y1", sparklineInteraction.margin.top); line.setAttribute("y2", sparklineInteraction.height - sparklineInteraction.margin.bottom);
					dot.setAttribute("cx", x); dot.setAttribute("cy", y);
					layer.style.display = "block";
					document.getElementById("sparkline-hover-readout").textContent = "Iteration " + point.iteration.toLocaleString() + " · " + formatMetricValue(sparklineInteraction.series, point.value);
				}

				function updateSparklineHover(event) {
					if (!sparklineInteraction) return;
					const svg = document.getElementById("cost-sparkline");
					const rect = svg.getBoundingClientRect();
					const x = ((event.clientX - rect.left) / rect.width) * sparklineInteraction.width;
					let nearest = sparklineInteraction.points[0];
					let distance = Math.abs(sparklineInteraction.xPosition(nearest.iteration) - x);
					sparklineInteraction.points.forEach(function (point) {
						const candidate = Math.abs(sparklineInteraction.xPosition(point.iteration) - x);
						if (candidate < distance) { nearest = point; distance = candidate; }
					});
					renderSparklineHover(nearest);
				}

				function showLatestSparklinePoint() {
					if (!sparklineInteraction || sparklineInteraction.points.length === 0) return;
					renderSparklineHover(sparklineInteraction.points[sparklineInteraction.points.length - 1]);
				}

				function clearSparklineHover() {
					const layer = document.getElementById("sparkline-hover-layer");
					if (layer) layer.style.display = "none";
					if (sparklineInteraction) {
						const latest = sparklineInteraction.points[sparklineInteraction.points.length - 1];
						document.getElementById("sparkline-hover-readout").textContent = "Latest: iteration " + latest.iteration.toLocaleString() + " · " + formatMetricValue(sparklineInteraction.series, latest.value);
					}
				}
			})();
		</script>
	}
}

// JobNotFound displays a 404 page for jobs that don't exist
templ JobNotFound(jobID string) {
	@Layout("Job Not Found") {
		<div class="card" style="text-align: center; padding: 3rem;">
			<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin: 0 auto 1rem; color: var(--text-muted);">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">
				Job Not Found
			</h1>
			<p style="color: var(--text-muted); margin-bottom: 1.5rem; font-family: monospace;">
				Job ID: { jobID }
			</p>
			<a href="/" class="btn btn-primary">
				← Back to Jobs
			</a>
		</div>
	}
}

func progressPercent(iterations, maximum int) float64 {
	if maximum <= 0 { return 0 }
	return min(100, max(0, float64(iterations)/float64(maximum)*100))
}

// Helper function to format large numbers with K/M suffix
func formatNumber(n float64) string {
	if n >= 1_000_000 {
		return fmt.Sprintf("%.1fM", n/1_000_000)
	} else if n >= 1_000 {
		return fmt.Sprintf("%.1fK", n/1_000)
	} else {
		return fmt.Sprintf("%.0f", n)
	}
}

// Helper function to format duration in seconds to human-readable string
func formatDuration(seconds float64) string {
	if seconds < 1 {
		return fmt.Sprintf("%.0fms", seconds*1000)
	} else if seconds < 60 {
		return fmt.Sprintf("%.1fs", seconds)
	} else if seconds < 3600 {
		mins := int(seconds / 60)
		secs := int(seconds) % 60
		return fmt.Sprintf("%dm %ds", mins, secs)
	} else {
		hours := int(seconds / 3600)
		mins := int(seconds/60) % 60
		return fmt.Sprintf("%dh %dm", hours, mins)
	}
}

// Helper function to format file sizes with binary units.
func formatFileSize(size int64) string {
	if size < 1024 {
		return fmt.Sprintf("%d B", size)
	} else if size < 1024*1024 {
		return fmt.Sprintf("%.1f KiB", float64(size)/1024)
	} else if size < 1024*1024*1024 {
		return fmt.Sprintf("%.1f MiB", float64(size)/(1024*1024))
	}
	return fmt.Sprintf("%.1f GiB", float64(size)/(1024*1024*1024))
}

// Helper function to format timestamp
func formatTimestamp(t time.Time) string {
	return t.Format("Jan 2, 2006 3:04 PM")
}
